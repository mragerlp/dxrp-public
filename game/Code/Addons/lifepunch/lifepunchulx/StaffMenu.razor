	private string PlayerRowAccentStyle( long steamId )
		=> $"border-color: {((_showProfile ? _profileSteamId : _selectedSteamId) == steamId ? AppliedAccentHex() : "transparent")};";

	private static string ProfilePortraitAccentStyle()
		=> $"border-color: {AccentRgba( _appliedAccentColor, 0.48f )};";

	private static string AccentWordmarkStyle( Color accent )
