	private static bool IsToggleAction( StaffAction action ) =>
		action.Key is "god" or "cloak" or "incognito" or "noclip" or "freeze" or "xray";

	private bool HasRequiredToggleState( StaffAction action ) =>
		!IsToggleAction( action ) || _pendingToggleState.HasValue;

	private static string ToggleStateLabel( bool? state ) => state switch
	{
		true => "On",
		false => "Off",
		_ => "Unavailable"
	};

	private bool? ReadPendingToggleState( StaffAction action ) =>
		IsToggleAction( action )
			? StaffMenuHost.GetCommandToggleState( action.Key,
				action.TargetMode == StaffActionTarget.OtherPlayer ? _selectedSteamId ?? 0 : StaffMenuHost.LocalSteamId )
			: null;

	// Re-sample before each confirmation as well as on the normal live-state cadence.
	// A direction change invalidates consent to the previous operation.
	private bool RefreshPendingToggleState()
	{
		if ( _pendingAction is not { } action || !IsToggleAction( action ) )
		{
			return false;
		}

		var state = ReadPendingToggleState( action );
		if ( state == _pendingToggleState )
		{
			return false;
		}

		_pendingToggleState = state;
		InvalidateArmedConfirm();
		StateHasChanged();
		return true;
	}

	private string PendingActionLabel( StaffAction action )
	{
		if ( !IsToggleAction( action ) )
		{
			return action.Label;
		}

		if ( _pendingToggleState is not { } enabled )
		{
			return $"Toggle {action.Label}";
		}

		if ( action.Key == "freeze" )
