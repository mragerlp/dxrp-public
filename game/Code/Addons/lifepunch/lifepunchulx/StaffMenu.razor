	// Count staff in the cached roster to avoid repeating per-player permission scans.
	private int StaffOnlineCount()
	{
		var staff = 0;
		foreach ( var player in _players )
		{
			if ( player.GroupName != StaffMenuHost.NonStaffGroup )
			{
				staff++;
			}
		}

		return staff;
	}

	// Long-running uptime in the same vocabulary DXRP's own dashboard uses. Formatted here rather
	// than through Dxura.RP.Game.TimeUtils because this razor is deliberately Dxura-free: every
	// engine-side value it shows arrives via Sandbox or StaffMenuHost, never a direct DXRP type.
	private static string UptimeLabel( float seconds )
	{
		var elapsed = TimeSpan.FromSeconds( Math.Max( 0f, seconds ) );

		return elapsed.TotalHours >= 24
			? $"{(int)elapsed.TotalDays}d {elapsed.Hours}h {elapsed.Minutes}m"
			: $"{(int)elapsed.TotalHours}h {elapsed.Minutes}m";
	}


	// Keep hover colors in a stylesheet so the custom resting accent cannot shadow them.
	// Update on the existing stats cadence, and replace by instance to avoid accumulating sheets.
	private StyleSheet _healthActionSheet;
	private string _healthActionHex = "";

	private void SyncHealthActionStyle()
	{
		var nativeHex = _selectedSteamId is { } sid && sid != 0
			? StaffMenuHost.PlayerHealthColorHex( sid )
			: "";
		SetHealthActionStyle( TryNormalizeAccentHex( nativeHex, out var hex ) ? hex : "" );
	}

	private void SetHealthActionStyle( string hex )
	{
		if ( Panel is null || hex == _healthActionHex )
		{
			return;
		}

		_healthActionHex = hex;
		if ( _healthActionSheet is not null )
		{
			Panel.StyleSheet.Remove( _healthActionSheet );
			_healthActionSheet = null;
		}

		if ( hex.Length > 0 )
		{
			var rgb = $"{Convert.ToInt32( hex.Substring( 1, 2 ), 16 )}, {Convert.ToInt32( hex.Substring( 3, 2 ), 16 )}, {Convert.ToInt32( hex.Substring( 5, 2 ), 16 )}";
			var css =
				$".health-action-colors .action-grid .action-tone-health:hover {{ border-color: rgba({rgb}, 0.68); background-color: rgba({rgb}, 0.18); }}\n" +
				$".health-action-colors .action-grid .action-tone-health:hover .material-icons {{ color: {hex}; }}\n" +
				$".health-action-colors .action-grid .action-tone-health:active {{ border-color: {hex}; background-color: rgba({rgb}, 0.26); }}\n" +
				$".health-action-colors .arg-form .confirm-btn-health {{ border-color: {hex}; background-color: rgba({rgb}, 0.30); }}\n" +
				$".health-action-colors .arg-form .confirm-btn-health:hover {{ background-color: rgba({rgb}, 0.44); }}";
			_healthActionSheet = StyleSheet.FromString( css, "ulx-health-action-colors" );
			Panel.StyleSheet.Add( _healthActionSheet );
		}

		// Adding/removing a sheet needs a selector change to rematch existing descendants.
		Panel.RemoveClass( "health-action-colors" );
		Panel.AddClass( "health-action-colors" );
	}

	private string GetRootClass() =>
		$"lifepunchulx ulx-v2 health-action-colors {LifePunchUiScale.CssClass( FrozenUiScale )}";

	/// <summary>Waypoint list filter -- typing in the bar narrows visible rows (Go/Set still use the typed name).</summary>
	private List<string> FilteredWaypoints( IReadOnlyList<string> waypoints )
	{
		var query = _waypointName?.Trim() ?? "";
		if ( query.Length == 0 )
		{
			return waypoints.ToList();
		}

		return waypoints
			.Where( w => w.Contains( query, StringComparison.OrdinalIgnoreCase ) )
			.ToList();
	}

