	private string ConfirmButtonClasses( StaffAction action, bool requiredArgsComplete )
	{
		// Replace the Confirm base class when disabled so confirm-btn:hover cannot match.
		// The inert class preserves the same geometry.
		if ( !requiredArgsComplete )
		{
			return "confirm-btn-inert control-disabled confirm-disabled-state";
		}

		// Jail gains the armed step, and Give Money keeps its stricter gesture,
		// without either joining the danger-red visual classification.
		if ( _severeConfirm && action.DisplayTone == StaffActionDisplayTone.Armor )
		{
			return "confirm-btn confirm-btn-armor";
		}

		if ( _severeConfirm && action.DisplayTone == StaffActionDisplayTone.Freeze )
		{
