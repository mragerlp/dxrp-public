	private static string AccentRgba( Color accent, float opacity )
	{
		var rgb = OpaqueAccent( accent ).Hex.TrimStart( '#' );
		var red = Convert.ToInt32( rgb.Substring( 0, 2 ), 16 );
		var green = Convert.ToInt32( rgb.Substring( 2, 2 ), 16 );
		var blue = Convert.ToInt32( rgb.Substring( 4, 2 ), 16 );
		return FormattableString.Invariant( $"rgba({red}, {green}, {blue}, {opacity:0.##})" );
	}

	private static string AppliedAccentLabel() => IsDefaultAccent( _appliedAccentColor )
		? "Blue (default)"
		: AppliedAccentHex();

	private static string AppliedAccentCopyHex() => "#" + AppliedAccentHex().TrimStart( '#' );
	private string SelectedAccentCopyHex() => "#" + AccentDraftHex().TrimStart( '#' );

	private void CopyAppliedAccent()
	{
		var hex = AppliedAccentCopyHex();
		Clipboard.SetText( hex );
		_copiedAppliedAccentHex = hex;
		var generation = ++_appliedAccentCopyGeneration;
		StateHasChanged();
		_ = RevertAppliedAccentCopy( generation );
	}

	private async System.Threading.Tasks.Task RevertAppliedAccentCopy( int generation )
	{
		await GameTask.DelayRealtimeSeconds( 1.8f );
		if ( _appliedAccentCopyGeneration != generation )
		{
			return;
		}

		_copiedAppliedAccentHex = "";
		StateHasChanged();
	}

	private void CopySelectedAccent()
	{
		var hex = SelectedAccentCopyHex();
		Clipboard.SetText( hex );
		_copiedSelectedAccentHex = hex;
		var generation = ++_selectedAccentCopyGeneration;
		StateHasChanged();
		_ = RevertSelectedAccentCopy( generation );
	}

	private async System.Threading.Tasks.Task RevertSelectedAccentCopy( int generation )
	{
		await GameTask.DelayRealtimeSeconds( 1.8f );
		if ( _selectedAccentCopyGeneration != generation )
		{
			return;
		}

		_copiedSelectedAccentHex = "";
		StateHasChanged();
	}

	/// <summary>
	/// Apply a changed draft accent to the console.
	/// </summary>
	private void ApplyAccent()
	{
		if ( !CanApplyAccent() )
		{
			return;
		}

		RememberAccent( _appliedAccentColor );
		_appliedAccentColor = OpaqueAccent( _accentHolder.Color );
		RememberAccent( _appliedAccentColor );
		SyncAccentDraft();
		StateHasChanged();
	}

	private static void RememberAccent( Color color )
	{
		color = OpaqueAccent( color );
		_recentAccentColors.RemoveAll( entry => string.Equals( entry.Hex, color.Hex, StringComparison.OrdinalIgnoreCase ) );
		_recentAccentColors.Insert( 0, color );
		if ( _recentAccentColors.Count > 10 )
		{
			_recentAccentColors.RemoveRange( 10, _recentAccentColors.Count - 10 );
		}
	}

	private void SelectRecentAccent( Color color ) => AccentHexInput = color.Hex;

	private void CancelAccentDraft()
	{
		SyncAccentDraft();
		StateHasChanged();
	}

	/// <summary>Back to the default accent, applied at once; the preview is discarded with it.</summary>
	private void ResetAccent()
	{
		RememberAccent( _appliedAccentColor );
		_appliedAccentColor = DefaultAccentColor;
		RememberAccent( _appliedAccentColor );
		SyncAccentDraft();
		StateHasChanged();
	}

	private static string ActionRestingAccentStyle( StaffAction action, bool enabled, bool toggleOn )
	{
		if ( !enabled || IsDefaultAccent( _appliedAccentColor ) )
		{
			return "";
		}

		// Inherit the resting accent from the card so semantic hover colors can override it.
		// Live toggles keep their status treatment instead of the configurable accent.
		if ( toggleOn )
		{
			return "";
		}

		return $"color: {AppliedAccentHex()};";
	}

