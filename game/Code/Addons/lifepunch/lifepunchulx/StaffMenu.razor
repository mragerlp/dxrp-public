		}

		if ( !requiredArgsComplete )
		{
			return "Complete the required fields before confirming";
		}

		if ( IsToggleAction( action ) )
		{
			return UsesDoubleClickConfirm( action )
				? $"Double-click to confirm: {PendingActionLabel( action )}"
				: $"Confirm: {PendingActionLabel( action )}";
		}

		if ( UsesDoubleClickConfirm( action ) )
		{
			return "Double-click to confirm - this runs for real on the live host";
		}

		return _severeConfirm && RequiresArmedConfirm( action )
			? $"Confirm {action.Label} again"
			: $"Confirm {action.Label}";
	}

