		{
			var label = string.IsNullOrWhiteSpace( _name ) ? "Clear RP Name" : action.Label;
			return _severeConfirm ? $"Yes, {label}" : $"Confirm {label}";
		}

		return IsToggleAction( action )
			? ( _severeConfirm ? $"Yes, {PendingActionLabel( action )}" : PendingActionLabel( action ) )
			: ( _severeConfirm ? ( action.Dispatch == StaffDispatchKind.GiveMoney ? "Yes, give the money" : $"Yes, {action.Label}" ) : $"Confirm {action.Label}" );
	}

	private string ConfirmActionHint( StaffAction action )
	{
		if ( !HasRequiredToggleState( action ) )
		{
			return "Waiting for the player's current state before confirming.";
		}

		if ( action.Key == "forcerpname" )
		{
			return "Double-click to confirm this RP name change.";
		}

		if ( IsToggleAction( action ) )
		{
			return action.Key == "xray"
				? "Double-click to switch X-ray between on and off."
				: ( UsesDoubleClickConfirm( action ) ? "Double-click to confirm this change." : "Confirm this change." );
		}

		return UsesDoubleClickConfirm( action )
			? "Double-click to confirm. This executes for real on the live host and cannot be undone from this console."
			: "Confirm once more to run this action on the live host.";
	}

	private string ConfirmButtonTooltip( StaffAction action, bool requiredArgsComplete )
	{
