	private void SelectTab( string tab )
	{
		if ( MoneyGrantNavigationLocked() )
		{
			return;
		}

		ResetPocketModal();
		ResetInventoryModal();
		_activeTab = tab;
		CancelArgs();

		// Leaving the profile via a tab just drops the preview -- it never targets. Any already-confirmed
		// target (_selectedSteamId) is untouched, so tabs never feel "stuck" behind the back arrow.
		_showProfile = false;
		_profileSteamId = null;

		// Neither audit popover may still be hanging open when the operator returns to Audit.
		_auditActionOpen = false;
		_auditWindowOpen = false;

		if ( tab == TabWaypoints )
		{
			StaffMenuHost.RefreshWaypoints();
		}
		else if ( tab == TabSettings )
		{
			SeedWebsiteDraft();
			StaffMenuHost.RefreshSettings();
			SyncAccentDraft();
		}

		LifePunchUiScrollPolicy.Apply( Panel );
	}

	// Sort from least to most severe. Stable ordering preserves catalogue order within each tier.
	private List<StaffAction> GetVisibleTabActions() =>
		StaffMenuActions.All
			.Where( a => a.Category == _activeTab && StaffMenuHost.CanView( a.PermissionId ) && ( a.Key != "xray" || StaffMenuHost.CanUseXray() ) )
			.OrderBy( a => a.Severity )
			.ToList();

	/// <summary>Ruled hint for a self-only tile locked because another player is the selected target.</summary>
	private const string SelfOnlyLockedHint = "Self-only. Select yourself to use.";

	/// <summary>
	/// Self-only abilities are available only when the selected target IS the caller, or nothing is selected.
	/// With another player selected they are disabled: never hidden, never re-routed, never applied to self.
	/// </summary>
	private bool SelfOnlyTargetIsCaller() =>
		_selectedSteamId is null || _selectedSteamId == StaffMenuHost.LocalSteamId;

	private bool IsEnabled( StaffAction action, StaffMenuPlayer selected, bool hasTarget )
	{
		if ( action.Key == "xray" && !StaffMenuHost.CanUseXray() )
		{
			return false;
		}

		if ( action.TargetMode == StaffActionTarget.SelfOnly )
		{
			return SelfOnlyTargetIsCaller();
		}

		if ( action.TargetMode != StaffActionTarget.OtherPlayer )
		{
			return true;
		}

		return hasTarget && selected.CanTarget && !IsSelfSanction( action, selected.SteamId );
	}

	private static bool IsSelfSanction( StaffAction action, long targetSteamId ) =>
		targetSteamId == StaffMenuHost.LocalSteamId
		&& ( action.Key == "jail" || action.Key == "kick" || action.Key == "ban" );

	private void OnActionClick( StaffAction action, StaffMenuPlayer selected, bool enabled )
	{
		if ( !enabled || IsSelfSanction( action, selected.SteamId ) )
		{
			return;
		}

		if ( action.Args.Count > 0 || RequiresArmedConfirm( action ) )
		{
			BeginArgs( action );
			return;
		}

		Dispatch( action, selected );
	}

	private void BeginArgs( StaffAction action )
	{
		if ( action.Key == "xray" && !StaffMenuHost.CanUseXray() )
		{
			return;
		}

		if ( MoneyGrantNavigationLocked() )
		{
			return;
		}

		if ( action.Dispatch == StaffDispatchKind.GiveMoney
		     && StaffMenuHost.MoneyGrantState != StaffMoneyGrantState.Idle )
		{
			StaffMenuHost.ClearMoneyGrantResult();
			_moneyGrantTargetSteamId = 0;
			_moneyGrantTargetName = "";
		}

		_pendingAction = action;
		_pendingToggleState = ReadPendingToggleState( action );
		InvalidateArmedConfirm();
		_reason = "";
		_duration = "";
		_amount = "";
		_name = "";
		_job = "";
		_jobFilter = "";
		_jobDropdownOpen = false;
		StateHasChanged();
	}

	private void CancelArgs()
	{
		if ( _pendingAction?.Dispatch == StaffDispatchKind.GiveMoney )
		{
			if ( MoneyGrantNavigationLocked() )
			{
				return;
			}

			StaffMenuHost.ClearMoneyGrantResult();
			_moneyGrantTargetSteamId = 0;
			_moneyGrantTargetName = "";
		}

		_pendingAction = null;
		_pendingToggleState = null;
		InvalidateArmedConfirm();
		_jobDropdownOpen = false;
		StateHasChanged();
	}

	private void SetDuration( string token, bool allowed )
	{
		if ( !allowed )
		{
			return;
		}

		_duration = token;
		StateHasChanged();
	}

	private void SetJob( string token )
	{
		_job = token;
		_jobDropdownOpen = false;
		StateHasChanged();
	}

	private void ToggleJobDropdown()
