@namespace LifePunch.DXRP.Addons.StaffMenu
@inherits PanelComponent
@attribute [StyleSheet]

@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons

<root class="@GetRootClass()" onmousedown="@ReleaseTextEntryFocus">
	<div class="window">
		<div class="ulx-shell-header">
			<div class="ulx-shell-title">
				<div class="title-stack">
					<span class="title-primary brand-wordmark"><span class="wordmark-life">lifepunch</span><span class="ulx" style="@AccentWordmarkStyle( _appliedAccentColor )">.ulx</span></span>
					<span class="title-sub">ULX CONSOLE</span>
				</div>
			</div>
			<div class="header-actions">
				<button class="header-chip @( StaffMenuHost.HasWebsite ? "header-chip-link" : "" ) @( _websiteCopied ? "header-chip-copied" : "" )"
				        tooltip="@( StaffMenuHost.HasWebsite ? $"Copy link: {StaffMenuHost.WebsiteUrl}" : "Network identifier" )"
				        onclick="@CopyWebsite">
					<i class="material-icons">language</i>
					<span>@(_websiteCopied ? "Link copied!" : StaffMenuHost.NetworkIdentifier)</span>
				</button>
				<button class="lp-ui-chrome-btn cog chrome-cog @( (_activeTab == TabSettings) ? "chrome-active" : "" )" style="@HeaderCogAccentStyle()" tooltip="Settings" onclick="@OpenSettings">
					<i class="material-icons">settings</i>
				</button>
				<button class="lp-ui-chrome-btn close chrome-close @( MoneyGrantNavigationLocked() ? "control-disabled" : "" )"
				        tooltip="@MoneyGrantCloseTooltip()"
				        onclick="@CloseMenu">
					<i class="material-icons">close</i>
				</button>
			</div>
		</div>

		<div class="ulx-shell-tabs">
			@foreach ( var category in StaffMenuActions.Categories )
			{
				<button class="@TabClass( category )" style="@TopTabAccentStyle( category )"
				        onclick="@(() => SelectTab( category ))">
					<span>@category</span>
				</button>
			}
			@if ( StaffMenuHost.CanUseWaypoints() )
			{
				<button class="@TabClass( TabWaypoints )" style="@TopTabAccentStyle( TabWaypoints )"
				        onclick="@(() => SelectTab( TabWaypoints ))">
					<span>Waypoints</span>
				</button>
			}
			@if ( StaffMenuHost.CanViewAudit() )
			{
				<button class="@TabClass( TabAudit )" style="@TopTabAccentStyle( TabAudit )"
				        onclick="@(() => SelectTab( TabAudit ))">
					<span>Audit</span>
				</button>
			}
		</div>

		<div class="ulx-workspace">
		@if ( _activeTab == TabAudit )
		{
			<div class="audit">
				<div class="audit-toolbar">
					<div class="audit-filters">
						<div class="audit-filter audit-filter-player">
							<TextEntry class="audit-input" Placeholder="Player ID" Value:bind="@_auditPlayerId"/>
							<div class="audit-scope">
								@foreach ( var option in AuditScopeOptions )
								{
									<button type="button" class="@AuditScopePillClass( option )"
									        tooltip="@AuditScopeTooltip( option )"
									        onclick="@(() => SetAuditScope( option ))">@AuditScopeLabel( option )</button>
								}
							</div>
							@if ( !string.IsNullOrEmpty( _auditPlayerId ) )
							{
								<button class="icon-btn" tooltip="Clear" onclick="@ClearAuditPlayer"><i class="material-icons">close</i></button>
							}
						</div>
						<div class="audit-filter audit-filter-action">
							<button type="button" class="audit-action-btn" onclick="@ToggleAuditActions">
								@if ( _auditActions.Count > 0 )
								{
									<span class="@ActionPillClass( _auditActions[0] )">@AuditActionSummary()</span>
								}
								else
								{
									<span class="audit-action-placeholder">Actions</span>
								}
								<i class="material-icons job-chevron">@(_auditActionOpen ? "expand_less" : "expand_more")</i>
							</button>
							@if ( _auditActions.Count > 0 )
							{
								<button class="icon-btn" tooltip="Clear action" onclick="@ClearAuditAction"><i class="material-icons">close</i></button>
							}
							@{
								// Compute facet counts once while the popover is open, excluding the action filter.
								// Use var here: an explicit generic type is parsed as a tag by Razor.
								var actionCounts = AuditActionCounts();
							}
							@if ( _auditActionOpen )
							{
								<div class="audit-action-pop">
									<div class="lp-ui-scroll-region audit-action-cloud">
										@foreach ( var name in StaffMenuHost.AuditActionCatalog() )
										{
											<button type="button" class="@AuditActionFilterPillClass( name, actionCounts )" onclick="@(() => ToggleAuditAction( name ))">
												<span class="audit-action-name">@name</span>
												@if ( AuditActionCount( name, actionCounts ) > 0 )
												{
													<span class="audit-action-count">@AuditActionCountLabel( name, actionCounts )</span>
												}
											</button>
										}
										<div class="audit-cloud-tail"></div>
									</div>
								</div>
							}
						</div>
						<div class="audit-filter">
							<TextEntry class="audit-input" Placeholder="Entity ID" Value:bind="@_auditEntity"/>
							@if ( !string.IsNullOrEmpty( _auditEntity ) )
							{
								<button class="icon-btn" tooltip="Clear" onclick="@ClearAuditEntity"><i class="material-icons">close</i></button>
							}
						</div>
						<div class="audit-filter audit-filter-window">
							<button type="button" class="audit-action-btn" tooltip="Time window" onclick="@ToggleAuditWindow">
								<span class="@(_auditWindowMinutes > 0 ? "audit-window-value" : "audit-action-placeholder")">@AuditWindowLabel()</span>
								<i class="material-icons job-chevron">@(_auditWindowOpen ? "expand_less" : "expand_more")</i>
							</button>
							@if ( _auditWindowMinutes > 0 )
							{
								<button class="icon-btn" tooltip="Clear window" onclick="@ClearAuditWindow"><i class="material-icons">close</i></button>
							}
							@if ( _auditWindowOpen )
							{
								<div class="audit-window-pop">
									@foreach ( var minutes in AuditWindowOptions )
									{
										<button type="button" class="@AuditWindowOptionClass( minutes )" onclick="@(() => SetAuditWindow( minutes ))">@AuditWindowOptionLabel( minutes )</button>
									}
								</div>
							}
						</div>
						<button type="button" class="audit-search-btn" tooltip="Apply filters" onclick="@RefreshAudit">
							<i class="material-icons">search</i>
						</button>
					</div>
					@if ( HasAuditFilters() )
					{
						<button type="button" class="audit-clear-btn" tooltip="Clear every filter" onclick="@ClearAllAuditFilters">Clear filters</button>
					}
					<button type="button" class="icon-btn audit-refresh-btn" tooltip="Refresh" onclick="@RefreshAudit">
						<i class="material-icons">refresh</i>
					</button>
				</div>

				@{
					var entries = StaffMenuHost.GetAuditEntries(
						_auditPlayerId, _auditEntity, false, _auditActions, _auditScope, _auditWindowMinutes );
					// Keep the unfiltered count to distinguish an empty feed from filters excluding all rows.
					var auditTotal = StaffMenuHost.AuditFeedTotal();
					// Cap rendered rows to avoid building thousands of panels; filters still search the full ring.
					var auditShown = System.Math.Min( entries.Count, AuditDisplayCap );
				}

				<div class="audit-table">
					<div class="audit-row audit-row-head">
						<span class="c-when">When</span>
						<span class="c-action">Action</span>
						<span class="c-player">Player</span>
						<span class="c-entity">Entity</span>
						<span class="c-desc">Description</span>
					</div>

					<div class="lp-ui-scroll-region audit-scroll lp-ui-measured-scroll" @ref="_auditScroll">
						@foreach ( var entry in entries.Take( auditShown ) )
						{
							<div class="audit-row">
								<span class="c-when">@entry.When</span>
								<span class="c-action"><span class="@ActionPillClass( entry.Action )">@PresentAuditText( entry.Action )</span></span>
								@if ( entry.PlayerSteamId == 0 )
								{
									<span class="c-player audit-player-system">system</span>
								}
								else
								{
									<button type="button" class="c-player audit-player-link" onclick="@(() => FilterAuditToPlayer( entry.PlayerSteamId ))">@entry.PlayerSteamId</button>
								}
								<span class="c-entity">@entry.Entity</span>
								<span class="c-desc">@PresentAuditText( entry.Description )</span>
							</div>
						}

						@if ( entries.Count == 0 && auditTotal == 0 && !StaffMenuHost.AuditFeedIsReadableHere )
						{
							@* Audit rows stay in the host process and are unavailable to remote clients. *@
							<div class="audit-empty">@StaffMenuHost.AuditFeedUnavailableText</div>
						}
						else if ( entries.Count == 0 && auditTotal == 0 )
						{
							<div class="audit-empty">No audit activity recorded yet this session.</div>
						}
						else if ( entries.Count == 0 )
						{
							<div class="audit-empty">@( $"No audit entries match these filters — {auditTotal} in the log." )</div>
							<button type="button" class="audit-clear-inline" onclick="@ClearAllAuditFilters">Clear filters</button>
						}
						else if ( entries.Count > auditShown )
						{
							<div class="audit-overflow">@( $"Showing the newest {auditShown} of {entries.Count} entries — refine the filters to reach older rows." )</div>
						}

						@if ( _auditWindowMinutes > 0 && auditTotal > 0 )
						{
							<div class="audit-coverage">@AuditCoverageNote()</div>
						}
					</div>
				</div>
			</div>
		}
		else if ( _activeTab == TabWaypoints )
		{
			<div class="waypoints">
				<div class="wp-main">
				<div class="wp-head">
					<i class="material-icons" style="@AppliedGlyphStyle()">place</i>
					<span>Waypoints</span>
				</div>

				<div class="wp-bar">
					<i class="material-icons">place</i>
					<TextEntry class="wp-input" Placeholder="Waypoint name" Value:bind="@_waypointName"/>
					<button class="wp-btn wp-btn-quiet @( string.IsNullOrWhiteSpace( _waypointName ) ? "control-disabled" : "" )"
					        tooltip="Teleport to this waypoint"
					        onclick="@GoToTypedWaypoint">
						<i class="material-icons">my_location</i> Go
					</button>
					@if ( StaffMenuHost.CanEditWaypoints() )
					{
						<button class="wp-btn wp-btn-primary @( string.IsNullOrWhiteSpace( _waypointName ) ? "control-disabled" : "" )"
						        tooltip="Save a waypoint at your current position + view angle"
						        onclick="@SetWaypointFromInput">
							<i class="material-icons">push_pin</i> Set here
						</button>
					}
				</div>

				@{
					var waypoints = StaffMenuHost.GetWaypoints();
					var filteredWaypoints = FilteredWaypoints( waypoints );
				}

				<div class="lp-ui-scroll-region wp-list">
					@foreach ( var name in filteredWaypoints )
					{
						<div class="wp-row">
							<i class="material-icons" style="@AppliedGlyphStyle()">place</i>
							<span class="wp-name">@name</span>
							<button class="wp-go-row" tooltip="Teleport here" onclick="@(() => GoToWaypoint( name ))">
								<i class="material-icons" style="@AppliedGlyphStyle()">my_location</i> Go
							</button>
							@if ( StaffMenuHost.CanEditWaypoints() )
							{
								@if ( _wpPendingDelete == name )
								{
									<button class="wp-confirm-yes" tooltip="@( $"Delete \"{name}\" permanently" )" onclick="@(() => ConfirmClearWaypoint( name ))">
										<i class="material-icons">check</i>
									</button>
									<button class="wp-confirm-no" tooltip="Keep waypoint" onclick="@CancelClearWaypoint">
										<i class="material-icons">close</i>
									</button>
								}
								else
								{
									<button class="wp-clear" tooltip="Delete waypoint" onclick="@(() => AskClearWaypoint( name ))">
										<i class="material-icons">delete</i>
									</button>
								}
							}
						</div>
					}

					@if ( waypoints.Count == 0 && StaffMenuHost.WaypointsReadIsUncertain )
					{
						<div class="wp-empty">
							Waypoint status unavailable — the server store did not return a confirmed answer.
						</div>
					}
					else if ( waypoints.Count == 0 )
					{
						<div class="wp-empty">
							No saved waypoints yet — type a name above to Go or Set.
						</div>
					}
					else if ( StaffMenuHost.WaypointsReadIsUncertain )
					{
						<div class="wp-empty">
							Showing last-known waypoints — the latest server-store refresh was not confirmed.
						</div>
					}
					else if ( filteredWaypoints.Count == 0 )
					{
						<div class="wp-empty">
							No waypoint matches @(_waypointName?.Trim()).
						</div>
					}
					<div class="wp-list-tail"></div>
				</div>

				</div>

				@if ( StaffMenuHost.CanView( "ability.teleport" ) )
				{
					<div class="wp-return-section">
						<div class="wp-head">
							<i class="material-icons" style="@AppliedGlyphStyle()">undo</i>
							<span>Move a player</span>
						</div>

						<div class="wp-sit-hint">
							Type a SteamID64, then return them where they were brought from, teleport to them, or bring them here.
						</div>

						<div class="wp-bar wp-return-bar">
							<i class="material-icons">person</i>
							<TextEntry class="wp-input" Placeholder="SteamID64" Value:bind="@_returnSteamId"/>
					<button class="wp-btn go wp-move-primary @( string.IsNullOrWhiteSpace( _returnSteamId ) ? "control-disabled wp-go-disabled" : "" )"
							        tooltip="Return this player to their previous position"
							        onclick="@ReturnTypedPlayer">
								<i class="material-icons">undo</i> Return
							</button>
						</div>

						<div class="wp-move-bar">
						<button class="wp-btn go wp-move-primary @( string.IsNullOrWhiteSpace( _returnSteamId ) ? "control-disabled wp-go-disabled" : "" )"
							        tooltip="Teleport yourself to this player"
							        onclick="@GotoTypedPlayer">
								<i class="material-icons">my_location</i> Goto
							</button>
						<button class="wp-btn go wp-move-primary @( string.IsNullOrWhiteSpace( _returnSteamId ) ? "control-disabled wp-go-disabled" : "" )"
							        tooltip="Bring this player to you"
							        onclick="@BringTypedPlayer">
								<i class="material-icons">pan_tool</i> Bring
							</button>
						</div>

						@* Recent movement uses the shared audit ring and exact action-name filter.
						   CanViewAudit is required separately from the waypoint teleport permission. *@
						@if ( StaffMenuHost.CanViewAudit() )
						{
							<div class="wp-head wp-events-head">
								<i class="material-icons" style="@AppliedGlyphStyle()">history</i>
								<span>Recent teleport events</span>
							</div>

							var teleportEvents = StaffMenuHost.GetAuditEntries( "", "", false, StaffActionTaxonomy.TeleportActionNames );

							<div class="lp-ui-scroll-region wp-events">
								@if ( teleportEvents.Count == 0 )
								{
									@* Remote clients cannot read the host ring; qualify the result before showing an empty feed. *@
									@if ( StaffMenuHost.AuditFeedIsReadableHere )
									{
										<div class="section-empty">No teleport or waypoint activity recorded yet.</div>
									}
									else
									{
										<div class="section-empty">@StaffMenuHost.AuditFeedUnavailableText</div>
									}
								}
								else
								{
									@foreach ( var entry in teleportEvents.Take( 50 ) )
									{
										<div class="event-row">
											<span class="event-when">@entry.When</span>
											<span class="event-act"><span class="@ActionPillClass( entry.Action )">@PresentAuditText( entry.Action )</span></span>
											<span class="event-what">@PresentAuditText( entry.Description )</span>
										</div>
									}
									@* Show the total alongside the render cap so a partial view is identifiable. *@
									@if ( teleportEvents.Count > 50 )
									{
										<div class="section-empty">@( $"Showing the newest 50 of {teleportEvents.Count} — the Audit tab reaches the rest." )</div>
									}
								}
								<div class="wp-events-tail"></div>
							</div>
						}
					</div>
				}
			</div>
		}
		else if ( _activeTab == TabSettings )
		{
			<div class="settings">
				<div class="settings-head">
					<i class="material-icons" style="@AppliedGlyphStyle()">settings</i>
					<span>Settings</span>
				</div>

				<div class="settings-cols">
					@* Network and the compact Appearance card remain beside Diagnostics. *@
					<div class="settings-col settings-col-network">
						<div class="settings-group settings-network">
							<div class="settings-label">Network Management</div>
							<div class="settings-hint">
								@($"Linked from the “{StaffMenuHost.NetworkIdentifier}” tag in the tab bar — staff click it to copy your link.")
							</div>

							@if ( StaffMenuHost.CanEditSettings() )
							{
								<div class="settings-bar">
									<i class="material-icons">link</i>
									<TextEntry class="settings-input" Placeholder="https://your-network.com" Value:bind="@_websiteDraft"/>
									@* Save feedback is BUTTON STATE only (green "Saved", red "Failed"). No row is ever
									   inserted below the bar, so the Appearance card underneath never moves. *@
									<button class="settings-btn save settings-save-primary @( WebsiteSaveClasses() )"
									        tooltip="@WebsiteSaveTooltip()"
									        onclick="@SaveWebsiteFromInput">
										<i class="material-icons">@WebsiteSaveIcon()</i> @WebsiteSaveLabel()
									</button>
								</div>

								<div class="settings-current">
									@if ( StaffMenuHost.HasWebsite )
									{
										<span class="settings-current-text">@( $"{(StaffMenuHost.WebsiteReadIsUncertain ? "Last known" : "Current")}: {StaffMenuHost.WebsiteUrl}" )</span>
										<button class="copy-btn"
										        tooltip="@( _currentCopied ? "Copied!" : "Copy link" )"
										        onclick="@CopyCurrentWebsite">
											<i class="material-icons">@( _currentCopied ? "check" : "content_copy" )</i>
										</button>
									}
									else
									{
										<span class="settings-current-text">@( StaffMenuHost.WebsiteReadIsUncertain ? "Website status unavailable — the server store did not return a confirmed answer." : "No website set yet — leave the field empty and Save to clear it." )</span>
									}
								</div>
							}
							else
							{
								<div class="settings-readonly">
									@( StaffMenuHost.HasWebsite ? $"{(StaffMenuHost.WebsiteReadIsUncertain ? "Last known: " : "")}{StaffMenuHost.WebsiteUrl}" : ( StaffMenuHost.WebsiteReadIsUncertain ? "Website status unavailable." : "No website set." ) )
								</div>
							}
						</div>

						<div class="settings-group settings-appearance">
							<div class="settings-label">Appearance</div>
							<div class="settings-hint">Customize icon and navigation accents. Status colors stay fixed.</div>
							<div class="accent-palette">
								<div class="accent-palette-summary">
									<div class="accent-state-row">
										<div class="accent-preview-slot">
											<div class="accent-preview" style="background-color: @AccentDraftHex()"></div>
										</div>
										<div class="accent-state-copy">
											<span class="accent-state-label">Selected</span>
											<button type="button" class="accent-copy-value"
											        tooltip="@( _copiedSelectedAccentHex == SelectedAccentCopyHex() ? $"Copied selected {SelectedAccentCopyHex()}" : $"Copy selected {SelectedAccentCopyHex()}" )" onclick="@CopySelectedAccent">
												<Label Tokenize=@(false) Text=@( _copiedSelectedAccentHex == SelectedAccentCopyHex() ? "Copied!" : AccentDraftLabel() ) class="accent-state-value" />
											</button>
										</div>
									</div>

									<div class="accent-state-row">
										<div class="accent-preview-slot">
											<div class="accent-preview accent-preview-applied" style="background-color: @AppliedAccentHex()"></div>
										</div>
										<div class="accent-state-copy">
											<span class="accent-state-label">Applied</span>
											<button type="button" class="accent-copy-value"
											        tooltip="@( _copiedAppliedAccentHex == AppliedAccentCopyHex() ? $"Copied applied {AppliedAccentCopyHex()}" : $"Copy applied {AppliedAccentCopyHex()}" )" onclick="@CopyAppliedAccent">
												<Label Tokenize=@(false) Text=@( _copiedAppliedAccentHex == AppliedAccentCopyHex() ? "Copied!" : AppliedAccentLabel() ) class="accent-state-value" />
											</button>
										</div>
									</div>
									<div class="accent-recent">
										<div class="accent-state-label">Recent</div>
										<div class="accent-recent-colors">
											@foreach ( var color in _recentAccentColors )
											{
												<button type="button" class="accent-recent-color" style="background-color: @color.Hex" tooltip="@( $"Select recently applied {color.Hex}" )" onclick="@(() => SelectRecentAccent( color ))"></button>
											}
										</div>
									</div>
									<div class="accent-hex-field">
										<div class="accent-hex-label">Hex color</div>
										<div class="accent-hex-controls">
											<TextEntry class="@( "arg-input accent-hex-input" + ( _accentHexInvalid ? " accent-hex-invalid" : "" ) )"
											           Placeholder="#1689FF" Value:bind="@AccentHexInput"/>
											<button type="button" class="settings-btn accent-hex-confirm @( CanApplyAccent() ? "accent-apply" : "accent-apply-inert control-disabled accent-action-disabled" )"
											        tooltip="@( _accentHexInvalid ? "Enter a valid hex color" : "Apply this hex color" )"
											        onclick="@ApplyAccent">Confirm</button>
										</div>
										<div class="accent-hex-feedback">
											@if ( _accentHexInvalid )
											{
												<span>Use 3 or 6 hex digits.</span>
											}
										</div>
									</div>
								</div>
								<div class="accent-picker-inline">
									@if ( AccentProperty is not null )
									{
										<ColorSaturationValueControl Property=@AccentProperty/>
										<ColorHueControl Property=@AccentProperty/>
									}
								</div>
								<div class="accent-preview-panel">
									<div class="accent-section-title">Preview</div>
									<div class="accent-command-preview-area">
										<div class="accent-preview-samples">
											<div class="accent-navigation-preview">
												<div class="accent-navigation-preview-header">
													<span class="accent-wordmark-preview" style="@AccentWordmarkStyle( _accentHolder.Color )">.ulx</span>
													<i class="material-icons" style="color: @AccentDraftHex()">settings</i>
												</div>
												<div class="accent-tab-preview" style="border-bottom-color: @AccentDraftHex()">
													<span>Moderation</span>
												</div>
											</div>
											<div class="action-btn accent-command-preview">
												<i class="material-icons" style="color: @AccentDraftHex()">@( StaffMenuActions.All.First( action => action.Key == "god" ).Icon )</i>
												<span class="action-label">God Mode</span>
											</div>
										</div>
									</div>
									<div class="accent-actions">
										<div class="accent-secondary-actions">
											<button type="button" class="settings-btn @( CanCancelAccent() ? "accent-cancel" : "accent-cancel-inert control-disabled accent-action-disabled" )"
											        tooltip="@( CanCancelAccent() ? "Discard color changes" : "Nothing to discard" )"
											        onclick="@CancelAccentDraft">
												<i class="material-icons">close</i> Cancel
											</button>
											<button type="button" class="settings-btn accent-reset" tooltip="Restore the default blue accent" onclick="@ResetAccent">
												<i class="material-icons">restart_alt</i> Reset
											</button>
										</div>
										<button type="button" class="settings-btn @( CanApplyAccent() ? "accent-apply" : "accent-apply-inert control-disabled accent-action-disabled" )"
										        tooltip="@( _accentHexInvalid ? "Enter a valid hex color" : ( CanApplyAccent() ? "Apply the selected icon and navigation accent" : "Selected and applied colors already match" ) )"
										        onclick="@ApplyAccent">
											<i class="material-icons">check</i> Apply accent
										</button>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="settings-col settings-col-diagnostics">
						<div class="settings-group settings-diagnostics">
							<div class="settings-label">System Diagnostics</div>
							<div class="settings-hint settings-hint-diagnostics">Live, read-only session state from existing console sensors; nothing is stored or sent.</div>

							<div class="diag-grid">
								<div class="diag-row">
									<span class="diag-key">Server</span>
									<span class="diag-value">@( string.IsNullOrWhiteSpace( Networking.ServerName ) ? "unnamed" : Networking.ServerName )</span>
								</div>
								<div class="diag-row">
									<span class="diag-key">Realm</span>
									<span class="diag-value">@( Networking.IsHost ? "Host" : "Client" )</span>
								</div>
								<div class="diag-row">
									<span class="diag-key">Uptime</span>
									<span class="diag-value">@UptimeLabel( Time.Now )</span>
								</div>
								<div class="diag-row">
									<span class="diag-key">Build</span>
									<span class="diag-value">@BuildBranch</span>
								</div>
								<div class="diag-row">
									<span class="diag-key">Staff online</span>
									<span class="diag-value">@( $"{StaffOnlineCount()} of {_players.Count} online" )</span>
								</div>
								<div class="diag-row">
									<span class="diag-key">Audit ring</span>
									<span class="diag-value">@( $"{StaffMenuHost.AuditFeedTotal()} rows" )</span>
								</div>
								<div class="diag-row">
									<span class="diag-key">Audit feed</span>
									<span class="diag-value">@( StaffMenuHost.AuditFeedIsReadableHere ? "readable on this client" : "unavailable in this build or realm" )</span>
								</div>
							</div>
						</div>

						<div class="settings-group settings-management">
							<div class="settings-management-copy">
								<div class="settings-label">Player &amp; Staff Management</div>
								<div class="settings-hint">Open the dedicated read-only player and staff workspace.</div>
							</div>
							<button class="settings-btn settings-management-btn" tooltip="Open Player & Staff Management" onclick="@OpenPlayerMgmt">
								<i class="material-icons">groups</i> Open
							</button>
						</div>
					</div>
				</div>
			</div>
		}
		else if ( _activeTab == TabSanctions )
		{
			@* StaffObserve owns the sanction subject and request. The profile route seeds it and
			   provides a return path; per-subject CanViewSanctions applies inside the child.
			   The full Observe hub retains the stricter CanViewObserve gate. *@
			<StaffObserve SanctionsOnly="@true"
			              SubjectSeedSteamId="@_sanctionsSteamId"
			              SubjectSeedVersion="@_sanctionsSeedVersion"
			              OnManagePlayer="@((long steamId) => OpenSanctionManagementFromObserve( steamId ))"
			              OnReturnToProfile="@(() => ReturnToProfileFromSanctions())" />
		}
		else if ( _activeTab == TabPlayerMgmt && StaffObserveHost.CanViewObserve() )
		{
			@* The full read-only Observe hub requires portal.audit.view and rank order 10 or higher. *@
			@* Attribute set kept TOTAL against the SanctionsOnly mount above: if the engine ever reuses the sibling
			   panel positionally, the hub must not inherit the seed mode, seed or return path. *@
			<StaffObserve SanctionsOnly="@false"
			              SubjectSeedSteamId="@( 0L )"
			              SubjectSeedVersion="@( 0 )"
			              OnReturnToProfile="@((Action?)null)"
			              OnManagePlayer="@((long steamId) => OpenSanctionManagementFromObserve( steamId ))" />
		}
		else if ( _activeTab == TabPlayerMgmt )
		{
			<div class="settings">
				<div class="settings-head">
					<i class="material-icons">groups</i>
					<span>Player &amp; Staff Management</span>
				</div>

				<div class="coming-soon">
					<i class="material-icons">lock</i>
					<span class="coming-soon-title">Access restricted</span>
					<span class="coming-soon-hint">Your current rank does not have access to Observe.</span>
				</div>
			</div>
		}
		else
		{
		<div class="ulx-shell-body">
			<div class="players @( _playersCollapsed ? "players-collapsed" : "" )">
				@if ( _playersCollapsed )
				{
					<div class="players-rail">
						<button class="expand-btn" tooltip="Open sidebar — players & settings" onclick="@TogglePlayers">
							<i class="material-icons">chevron_right</i>
						</button>
						<div class="rail-stat">
							<i class="material-icons">group</i>
							<span class="count">@_players.Count</span>
						</div>
						<div class="rail-stat">
							<i class="material-icons">shield</i>
							<span class="count">@( StaffTierGroups().Sum( g => g.Players.Count ) )</span>
						</div>
					</div>
				}

				@if ( !_playersCollapsed )
				{
					var staffGroups = StaffTierGroups();
					var staffCount = staffGroups.Sum( g => g.Players.Count );
					// Staff appear in their rank groups, so Players contains only non-staff.
					// The header count still includes everyone online.
					var nonStaff = FilteredPlayers()
						.Where( p => p.GroupName == StaffMenuHost.NonStaffGroup )
						.OrderBy( p => p.Name )
						.ToList();
					var rosterSearchEmpty = !string.IsNullOrWhiteSpace( _searchText )
						&& staffCount == 0
						&& nonStaff.Count == 0;

					<div class="pane-label">
						<span class="pane-title">Players</span>
						<span class="online-count"><span class="player-online"></span>@( $"{_players.Count} online" )</span>
						<button class="collapse-btn" tooltip="Hide sidebar" onclick="@TogglePlayers">
							<i class="material-icons">chevron_left</i>
						</button>
					</div>

					<div class="search-row">
						<i class="material-icons">search</i>
						<TextEntry class="search-input" Placeholder="Search players or SteamID" Value:bind="@_searchText"/>
						@if ( !string.IsNullOrEmpty( _searchText ) )
						{
							<button class="icon-btn" onclick="@ClearSearch"><i class="material-icons">close</i></button>
						}
					</div>

					@if ( IsSteamId( _searchText ) )
					{
						<button class="steamid-pick" onclick="@SelectTypedSteamId">
							<i class="material-icons">person_search</i>
							<span>Select SteamID @_searchText.Trim()</span>
						</button>
					}

					<div class="lp-ui-scroll-region player-scroll">
						@if ( rosterSearchEmpty )
						{
							<div class="roster-empty">No online players match this search.</div>
						}
						<div class="roster-section @(_staffSectionCollapsed ? "roster-section-collapsed" : "")">
							<button class="parent-label @(_staffSectionCollapsed ? "" : "parent-label-open")" onclick="@ToggleStaffSection">
								<span class="parent-label-text">Staff (@staffCount)</span>
								<i class="material-icons parent-label-chevron" style="@NavigationChevronStyle( _staffSectionCollapsed )">@(_staffSectionCollapsed ? "chevron_right" : "expand_more")</i>
							</button>
							@if ( !_staffSectionCollapsed )
							{
								@foreach ( var group in staffGroups )
								{
									<div class="roster-tier">
										<div class="group-label">@group.Name (@group.Players.Count)</div>
										@foreach ( var player in group.Players )
										{
											<button class="player-row @( ( _showProfile ? _profileSteamId : _selectedSteamId ) == player.SteamId ? "player-row-selected" : "" )" style="@PlayerRowAccentStyle( player.SteamId )"
											        tooltip="View player profile"
											        onclick="@(() => Select( player.SteamId ))">
												<i class="material-icons avatar">person</i>
												<span class="player-online"></span>
												<span class="player-copy">
													<span class="name">@player.Name</span>
													<span class="role" style="@( $"color: {player.RankColorHex};" )">@player.Role</span>
												</span>
												@if ( !player.CanTarget )
												{
													<i class="material-icons lock" tooltip="Equal or higher rank — cannot target">lock</i>
												}
											</button>
										}
									</div>
								}
							}
						</div>

						<div class="roster-section @(_playersSectionCollapsed ? "roster-section-collapsed" : "")">
							<button class="parent-label @(_playersSectionCollapsed ? "" : "parent-label-open")" onclick="@TogglePlayersSection">
								<span class="parent-label-text">Players (@nonStaff.Count)</span>
								<i class="material-icons parent-label-chevron" style="@NavigationChevronStyle( _playersSectionCollapsed )">@(_playersSectionCollapsed ? "chevron_right" : "expand_more")</i>
							</button>
							@if ( !_playersSectionCollapsed )
							{
								<div class="roster-tier roster-tier-players">
									@foreach ( var player in nonStaff )
									{
										<button class="player-row @( ( _showProfile ? _profileSteamId : _selectedSteamId ) == player.SteamId ? "player-row-selected" : "" )" style="@PlayerRowAccentStyle( player.SteamId )"
										        tooltip="View player profile"
										        onclick="@(() => Select( player.SteamId ))">
											<i class="material-icons avatar">person</i>
											<span class="player-online"></span>
											<span class="player-copy">
												<span class="name">@player.Name</span>
												<span class="role" style="@( $"color: {player.RankColorHex};" )">@player.Role</span>
											</span>
											@if ( !player.CanTarget )
											{
												<i class="material-icons lock" tooltip="Equal or higher rank — cannot target">lock</i>
											}
										</button>
									}
								</div>
							}
						</div>
						<div class="player-scroll-tail"></div>
					</div>
				}

				<div class="players-footer">
					<button class="settings-entry @( _activeTab == TabPlayerMgmt ? "settings-entry-on" : "" )"
					        tooltip="@( _playersCollapsed ? "Player & Staff Management" : "" )"
					        onclick="@OpenPlayerMgmt">
						<i class="material-icons">settings</i>
						@if ( !_playersCollapsed )
						{
							<span class="settings-entry-label">@("Player & Staff Management")</span>
						}
					</button>
				</div>
			</div>

			<div class="main">
			<div class="lp-ui-scroll-region actions @( _showProfile ? "actions-profile" : "" )">
				@{
					var selected = _players.FirstOrDefault( p => p.SteamId == _selectedSteamId );
					var hasTarget = selected.SteamId != 0;
					// The profile pane previews whoever was clicked (_profileSteamId); it does NOT
					// imply selection — only "Actions for this player" commits a command target.
					var profileSteamId = _profileSteamId ?? _selectedSteamId ?? 0;
				}

				@if ( _showProfile && profileSteamId != 0 )
				{
					var detail = StaffMenuHost.GetPlayerDetail( profileSteamId );
					var steamIdCopied = _copiedSteamId == profileSteamId;
					var profileHealthAction = detail.Found ? GetProfileStatAction( "sethealth", profileSteamId ) : null;
					var profileArmorAction = detail.Found ? GetProfileStatAction( "setarmor", profileSteamId ) : null;
					var profileMoneyAction = detail.Found ? GetProfileStatAction( "givemoney", profileSteamId ) : null;
					var profileJobAction = detail.Found ? GetProfileStatAction( "setjob", profileSteamId ) : null;
					<div class="profile">
						<div class="profile-head">
							<button class="icon-btn" onclick="@CloseProfile"><i class="material-icons" style="@AppliedGlyphStyle()">arrow_back</i></button>
							<span>Player Profile</span>
						</div>

						<div class="profile-card">
							<div class="profile-identity-row">
								<div class="profile-identity">
									<img class="profile-avatar" src="avatar:@profileSteamId" style="@ProfilePortraitAccentStyle()"/>
									<div class="profile-identity-copy">
										<div class="profile-name">@( detail.Found ? detail.Name : "Off-roster target" )</div>
									</div>
								</div>

								@if ( StaffMenuHost.CanView( "ability.teleport" ) )
								{
									var tpTarget = _players.FirstOrDefault( p => p.SteamId == profileSteamId );
									var canTp = tpTarget.SteamId != 0 && tpTarget.CanTarget && profileSteamId != StaffMenuHost.LocalSteamId;
									// A disabled control that says nothing reads as broken. Name the reason.
									var tpReason = profileSteamId == StaffMenuHost.LocalSteamId
										? "Cannot target yourself"
										: ( tpTarget.SteamId == 0 ? "Player is not on the roster" : "Target is protected" );
									<div class="profile-tp">
										@* Quick teleports follow severity order: Return, then Goto and Bring. *@
										<button class="tp-btn tp-return @( canTp ? "" : "control-disabled tp-disabled-state tp-return-disabled-state" )"
										        tooltip="@( canTp ? "Return Player" : tpReason )"
										        onclick="@(() => QuickTeleport( "return", tpTarget ))">
											<i class="material-icons">undo</i>
										</button>
										<button class="tp-btn tp-go @( canTp ? "" : "control-disabled tp-disabled-state tp-goto-disabled-state" )"
										        tooltip="@( canTp ? "Go to Player" : tpReason )"
										        onclick="@(() => QuickTeleport( "goto", tpTarget ))">
											<i class="material-icons">my_location</i>
										</button>
										<button class="tp-btn tp-bring @( canTp ? "" : "control-disabled tp-disabled-state tp-bring-disabled-state" )"
										        tooltip="@( canTp ? "Bring Player" : tpReason )"
										        onclick="@(() => QuickTeleport( "bring", tpTarget ))">
											<i class="material-icons">pan_tool</i>
										</button>
									</div>
								}
							</div>

							<div class="profile-body">

								@* Keep four aligned rows and an always-present footer in each profile column.
								   Permission-gated controls and off-roster values must not change the card geometry. *@
								@{
									var statusHealthStyle = detail.Found
										? $"color: {StaffMenuHost.HealthColorHex( detail.Health, detail.MaxHealth )}"
										: "";
								}
								<div class="profile-columns">
									<div class="profile-col">
										<div class="profile-section-head">Identity</div>
										<div class="profile-section">
											<div class="profile-rows">
												<div class="field">
													<span class="k">Steam ID</span>
													<button type="button" class="v steamid-value @( steamIdCopied ? "copied-text" : "" )"
													        tooltip="@( steamIdCopied ? "Copied!" : "Copy Steam ID" )"
													        onclick="@(() => CopySteamId( profileSteamId ))">@( steamIdCopied ? "Copied!" : profileSteamId.ToString() )</button>
												</div>
												<div class="field">
													<span class="k">Role</span>
													<span class="v v-role @( detail.Found ? "" : "v-tone-zero" )" style="@( detail.Found ? $"color: {detail.RankColorHex};" : "" )">@detail.Role</span>
												</div>
												<div class="field">
													<span class="k">Level</span>
													<span class="v @( detail.Found ? "" : "v-tone-zero" )">@( detail.Found ? detail.Level.ToString() : "—" )</span>
												</div>
												<div class="field">
													<span class="k">Time played</span>
													<span class="v @( detail.Found ? "" : "v-tone-zero" )">@( detail.Found ? $"{detail.PlayTimeMinutes / 60}h" : "—" )</span>
												</div>
											</div>
											@* Show flags only for a resolved player. An empty flag list for an unresolved player
											   does not establish that they have no active flags. Unauthorized flags retain flag-illegit. *@
											<div class="profile-footer profile-footer-flags">
												@if ( !detail.Found )
												{
													<span class="k">Flags</span>
													<span class="v v-tone-zero">—</span>
												}
												else
												{
													var stateFlags = StaffMenuHost.GetStateFlags( profileSteamId );
													@if ( stateFlags.Count == 0 )
													{
														<span class="k">Flags</span>
														<span class="v v-tone-zero">None</span>
													}
													else
													{
														@* Named chips use the whole footer width so they can wrap into two rows. *@
														<span class="flags-list">
															@foreach ( var flag in stateFlags )
															{
																<span class="flag-chip @( ProfileFlagClass( flag ) )"
																      tooltip="@( flag.Illegitimate ? "Active WITHOUT the permission that grants it" : "Permitted for this player" )">@flag.Label</span>
															}
														</span>
													}
												}
											</div>
										</div>
									</div>

									<div class="profile-col">
										<div class="profile-section-head">Economy</div>
										<div class="profile-section">
											<div class="profile-rows">
												<div class="field">
													<span class="k">Job</span>
													@if ( profileJobAction is not null )
													{
														<button type="button" class="v profile-stat-value v-job @( detail.Found ? "" : "v-tone-zero" )" style="@( detail.Found && !string.IsNullOrEmpty( detail.JobColorHex ) ? $"color: {detail.JobColorHex}" : "" )"
														        tooltip="Open Set Job for this player; pick a job and confirm"
														        onclick="@(() => OpenProfileStat( "setjob", profileSteamId ))">@detail.Job</button>
													}
													else
													{
														<span class="v v-job @( detail.Found ? "" : "v-tone-zero" )" style="@( detail.Found && !string.IsNullOrEmpty( detail.JobColorHex ) ? $"color: {detail.JobColorHex}" : "" )">@( detail.Found ? detail.Job : "—" )</span>
													}
												</div>
												<div class="field">
													<span class="k">Base salary</span>
													<span class="v @( detail.BaseSalary > 0 ? "v-cash" : "v-tone-zero" )">@( detail.Found ? "$" + detail.BaseSalary.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture ) : "—" )</span>
												</div>
												<div class="field">
													<span class="k">Cash</span>
													@if ( profileMoneyAction is not null )
													{
														<button type="button" class="v profile-stat-value @( detail.Wallet > 0 ? "v-cash" : "v-tone-zero" )"
														        tooltip="Open Give Money for this player; choose an amount and confirm"
														        onclick="@(() => OpenProfileStat( "givemoney", profileSteamId, "cash" ))">@( "$" + detail.Wallet.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture ) )</button>
													}
													else
													{
														<span class="v @( detail.Wallet > 0 ? "v-cash" : "v-tone-zero" )">@( detail.Found ? "$" + detail.Wallet.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture ) : "—" )</span>
													}
												</div>
												<div class="field">
													<span class="k">Bank</span>
													@if ( profileMoneyAction is not null )
													{
														<button type="button" class="v profile-stat-value @( detail.Bank > 0 ? "v-cash" : "v-tone-zero" )"
														        tooltip="Open Give Money for this player; choose an amount and confirm"
														        onclick="@(() => OpenProfileStat( "givemoney", profileSteamId, "bank" ))">@( "$" + detail.Bank.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture ) )</button>
													}
													else
													{
														<span class="v @( detail.Bank > 0 ? "v-cash" : "v-tone-zero" )">@( detail.Found ? "$" + detail.Bank.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture ) : "—" )</span>
													}
												</div>
											</div>
											<div class="profile-footer">
												@if ( detail.Found && StaffMenuHost.CanViewInventory( profileSteamId ) )
												{
													<button type="button" class="profile-data-trigger profile-inventory-trigger"
													        tooltip="Open read-only Portal inventory"
													        onclick="@(() => ViewInventory( profileSteamId ))">
														<i class="material-icons">inventory</i> View inventory
													</button>
												}
											</div>
										</div>
									</div>

									<div class="profile-col">
										<div class="profile-section-head">Status</div>
										<div class="profile-section">
											<div class="profile-rows">
												<div class="field">
													<span class="k">Health</span>
													@if ( profileHealthAction is not null )
													{
														<button type="button" class="v profile-stat-value" style="@statusHealthStyle"
														        tooltip="Open Set Health for this player; choose an amount and confirm"
														        onclick="@(() => OpenProfileStat( "sethealth", profileSteamId ))">@( $"{detail.Health} / {detail.MaxHealth}" )</button>
													}
													else
													{
														<span class="v @( detail.Found ? "" : "v-tone-zero" )" style="@statusHealthStyle">@( detail.Found ? $"{detail.Health} / {detail.MaxHealth}" : "—" )</span>
													}
												</div>
												<div class="field">
													<span class="k">Armor</span>
													@if ( profileArmorAction is not null )
													{
														<button type="button" class="v profile-stat-value @( detail.Armor > 0 ? "v-armor" : "v-tone-zero" )"
														        tooltip="Open Set Armor for this player; choose an amount and confirm"
														        onclick="@(() => OpenProfileStat( "setarmor", profileSteamId ))">@( $"{detail.Armor} / {detail.MaxArmor}" )</button>
													}
													else
													{
														<span class="v @( detail.Armor > 0 ? "v-armor" : "v-tone-zero" )">@( detail.Found ? $"{detail.Armor} / {detail.MaxArmor}" : "—" )</span>
													}
												</div>
												<div class="field">
													<span class="k">Kills</span>
													<span class="v @( detail.Found ? "" : "v-tone-zero" )">@( detail.Found ? detail.Kills.ToString() : "—" )</span>
												</div>
												<div class="field">
													<span class="k">Deaths</span>
													<span class="v @( detail.Found ? "" : "v-tone-zero" )">@( detail.Found ? detail.Deaths.ToString() : "—" )</span>
												</div>
											</div>
											<div class="profile-footer">
												@if ( detail.Found && StaffMenuHost.CanViewPocket( profileSteamId ) )
												{
													<button type="button" class="profile-data-trigger profile-pocket-trigger" tooltip="Open read-only pocket"
													        onclick="@(() => ViewPocket( profileSteamId ))">
														<i class="material-icons">inventory_2</i> View pocket
													</button>
												}
											</div>
										</div>
									</div>
								</div>

								@* Quick sanctions follow the profile details and precede target selection. *@
								@if ( detail.Found )
								{
									<div class="quick-sanctions">
										@foreach ( var key in QuickSanctionKeys )
										{
											var qs = StaffMenuActions.All.FirstOrDefault( x => x.Key == key );
											var qsTarget = _players.FirstOrDefault( p => p.SteamId == profileSteamId );
											var qsOk = qs is not null && StaffMenuHost.CanView( qs.PermissionId )
											           && qsTarget.SteamId != 0 && qsTarget.CanTarget
											           && profileSteamId != StaffMenuHost.LocalSteamId;
											var qsReason = profileSteamId == StaffMenuHost.LocalSteamId
												? "Cannot target yourself"
												: "Not permitted on this player";
											@if ( qs is not null )
											{
												<button class="quick-sanction @( qsOk ? "" : "control-disabled quick-sanction-disabled-state" )"
												        tooltip="@( qsOk ? qs.Tooltip : qsReason )"
												        onclick="@(() => OpenProfileAction( qs, profileSteamId, qsOk ))">
													<i class="material-icons">@qs.Icon</i>
													<span class="quick-sanction-label">@qs.Label</span>
												</button>
											}
										}
									</div>
								}

							</div>

							<button class="confirm-btn" onclick="@(() => ConfirmTarget( profileSteamId ))">
								<i class="material-icons">bolt</i> Actions for this player
							</button>

							@if ( StaffMenuHost.CanViewAudit() || StaffMenuHost.CanViewSanctions( profileSteamId ) )
							{
								<div class="profile-links">
									@if ( StaffMenuHost.CanViewAudit() )
									{
										<button class="confirm-btn confirm-btn-secondary btn-observe" onclick="@(() => OpenAuditForPlayer( profileSteamId ))">
											<i class="material-icons">history</i> View audit log
										</button>
									}
								@if ( StaffMenuHost.CanViewSanctions( profileSteamId ) )
								{
									<button class="confirm-btn confirm-btn-secondary confirm-btn-severe-state" onclick="@(() => OpenSanctionsForPlayer( profileSteamId ))">
											<i class="material-icons">gavel</i> Open sanctions
										</button>
									}
								</div>
							}

							@if ( _pocketModalOpen && _pocketModalSteamId == profileSteamId )
							{
								var pocketItems = PocketItemsFor( profileSteamId );
								var pocketLoading = PocketViewIsLoading( profileSteamId );
								var pocketUnavailable = PocketViewIsUnavailable( profileSteamId );
								var pocketSlotCount = StaffMenuHost.GetPocketSlotCount();
								var pocketSlotSubtitle = $"{pocketSlotCount} storage {( pocketSlotCount == 1 ? "slot" : "slots" )}";
								var pocketEmptyText = pocketSlotCount == 1
									? "Pocket empty -- 1 slot is available."
									: $"Pocket empty -- all {pocketSlotCount} slots are available.";
								<div class="pocket-modal-layer">
									<div class="pocket-modal-scrim" onclick="@ClosePocketModal"></div>
									<div class="pocket-modal">
										<div class="pocket-modal-head">
											<div class="pocket-modal-title">
												<span>Read-only pocket</span>
												<span class="pocket-modal-subtitle">@pocketSlotSubtitle</span>
											</div>
											<button class="icon-btn pocket-modal-close" tooltip="Close pocket" onclick="@ClosePocketModal">
												<i class="material-icons">close</i>
											</button>
										</div>
										<div class="pocket-slots">
											@for ( var slot = 0; slot < pocketSlotCount; slot++ )
											{
												var item = slot < pocketItems.Count ? pocketItems[slot] : "";
												var empty = string.IsNullOrWhiteSpace( item );
												<div class="@PocketSlotClass( empty, pocketLoading, pocketUnavailable )">
													<span class="pocket-slot-number">@( slot + 1 )</span>
													<i class="material-icons pocket-slot-fallback">@( empty ? "inventory_2" : "deployed_code" )</i>
													<span class="pocket-slot-label">@PocketSlotLabel( item, pocketLoading, pocketUnavailable )</span>
												</div>
											}
										</div>
										@if ( pocketUnavailable )
										{
											<div class="pocket-empty-state">Pocket request unavailable -- try again shortly.</div>
										}
										else if ( !pocketLoading && pocketItems.Count == 0 )
										{
											<div class="pocket-empty-state">@pocketEmptyText</div>
										}
									</div>
								</div>
							}

							@if ( _inventoryModalOpen && _inventoryModalSteamId == profileSteamId
							     && StaffMenuHost.CanViewInventory( profileSteamId ) )
							{
								var inventoryItems = StaffMenuHost.GetInventoryItems( profileSteamId );
								var inventoryState = StaffMenuHost.GetInventoryState( profileSteamId );
								var inventoryMessage = StaffMenuHost.GetInventoryMessage( profileSteamId );
								var inventorySubtitle = inventoryState == StaffInventoryReadState.Populated
									? $"{inventoryItems.Count} item {( inventoryItems.Count == 1 ? "type" : "types" )}"
									: $"{detail.Name} · Portal account inventory";
								<div class="pocket-modal-layer inventory-modal-layer">
									<div class="pocket-modal-scrim" onclick="@CloseInventoryModal"></div>
									<div class="pocket-modal inventory-modal">
										<div class="pocket-modal-head">
											<div class="pocket-modal-title">
												<span>Read-only inventory</span>
												<span class="pocket-modal-subtitle">@inventorySubtitle</span>
											</div>
											<button class="icon-btn pocket-modal-close" tooltip="Close inventory" onclick="@CloseInventoryModal">
												<i class="material-icons">close</i>
											</button>
										</div>

										@if ( inventoryState == StaffInventoryReadState.Loading )
										{
											<div class="inventory-modal-state">
												<i class="material-icons">sync</i>
												<span>@inventoryMessage</span>
											</div>
										}
										else if ( inventoryState == StaffInventoryReadState.Unavailable )
										{
											<div class="inventory-modal-state inventory-modal-unavailable">
												<i class="material-icons">link_off</i>
												<span>@inventoryMessage</span>
											</div>
										}
										else if ( inventoryState == StaffInventoryReadState.CompletedEmpty )
										{
											<div class="inventory-modal-state">
												<i class="material-icons">inventory_2</i>
												<span>@inventoryMessage</span>
											</div>
										}
										else if ( inventoryState == StaffInventoryReadState.Populated )
										{
											<div class="inventory-modal-list lp-ui-scroll-region lp-ui-measured-scroll">
												@foreach ( var item in inventoryItems )
												{
													<div class="inventory-modal-row">
														<i class="material-icons inventory-item-icon">inventory_2</i>
														<div class="inventory-item-copy">
															<span class="inventory-item-name">@InventoryItemLabel( item.Name )</span>
															<span class="inventory-item-meta">@($"{item.Type} · {item.Rarity}")</span>
														</div>
														<span class="inventory-item-quantity">×@item.Quantity</span>
													</div>
												}
											</div>
										}
									</div>
								</div>
							}
						</div>
					</div>
				}
				else
				{
				<div class="target-identity @( _selectedSteamId != null ? "target-identity-active" : "" )">
					@if ( _selectedSteamId != null )
					{
						<div class="target-identity-main">
							<i class="material-icons">person</i>
							<div class="target-identity-copy">
								<span class="target-name">@( hasTarget ? selected.Name : $"SteamID {_selectedSteamId}" )</span>
								@if ( hasTarget && !string.IsNullOrWhiteSpace( selected.Role ) )
								{
									<span class="target-role" style="@( $"color: {selected.RankColorHex};" )">@selected.Role</span>
								}
								<span class="target-steamid">SteamID @_selectedSteamId</span>
							</div>
						</div>
						<div class="target-identity-state">
							@if ( hasTarget )
							{
								<span class="target-online">Online</span>
									<span class="targetability @( selected.CanTarget ? "targetability-targetable" : "targetability-protected" )">@( selected.CanTarget ? "Targetable" : "Protected or unavailable" )</span>
								@if ( selected.IsFrozen )
								{
									<span class="target-frozen">Frozen</span>
								}
							}
							else
							{
								<span class="target-off-roster">Off-roster target — availability unknown</span>
								<span class="targetability targetability-protected">Unavailable for player actions</span>
							}
						</div>
						<div class="target-identity-actions">
							@if ( hasTarget )
							{
								<button class="profile-preview-btn btn-observe" onclick="@(() => Select( profileSteamId ))">
									<i class="material-icons">visibility</i> View profile
								</button>
							}
							<button class="icon-btn clear-target" tooltip="Deselect player" onclick="@Deselect">
								<i class="material-icons">close</i>
							</button>
						</div>
					}
					else
					{
						<i class="material-icons" style="@AppliedGlyphStyle()">public</i>
						<div class="target-identity-copy">
							<span class="target-name">No target selected</span>
							<span class="target-identity-hint">Self and server actions remain available.</span>
						</div>
					}
				</div>

				@if ( _pendingAction is { } pending )
				{
					var requiredArgsComplete = pending.Args
						.All( arg => IsArgSatisfied( pending, arg ) );
					var moneyState = StaffMenuHost.MoneyGrantState;
					var moneyLocked = pending.Dispatch == StaffDispatchKind.GiveMoney
						&& moneyState is StaffMoneyGrantState.Pending or StaffMoneyGrantState.Succeeded or StaffMoneyGrantState.Unknown;
					var moneyNavigationLocked = pending.Dispatch == StaffDispatchKind.GiveMoney
						&& moneyState is StaffMoneyGrantState.Pending or StaffMoneyGrantState.Unknown;
					var formCanConfirm = requiredArgsComplete && !moneyLocked && HasRequiredToggleState( pending );
					var targetContext = pending.Dispatch == StaffDispatchKind.GiveMoney
					                    && moneyState != StaffMoneyGrantState.Idle
					                    && _moneyGrantTargetSteamId != 0
						? _moneyGrantTargetName
						: pending.TargetMode == StaffActionTarget.OtherPlayer
						? ( hasTarget ? selected.Name : "No target selected" )
						: ( pending.TargetMode == StaffActionTarget.SelfOnly ? "Self" : "Server" );
					<div class="arg-form @( pending.Dispatch == StaffDispatchKind.GiveMoney ? ( moneyLocked ? "arg-form-money arg-form-money-receipt" : "arg-form-money" ) : pending.Key == "setjob" ? "arg-form-setjob" : "" )">
						<div class="arg-form-head">
							<div class="arg-context">
								<span class="arg-action">@PendingActionLabel( pending )</span>
								<span class="arg-target">Target: @targetContext</span>
								@if ( IsToggleAction( pending ) )
								{
									<span class="arg-target">Current state: @ToggleStateLabel( _pendingToggleState )</span>
								}
							</div>
							<button class="icon-btn @( moneyNavigationLocked ? "control-disabled" : "" )"
							        tooltip="@( moneyState == StaffMoneyGrantState.Pending ? "Waiting for the host result" : moneyState == StaffMoneyGrantState.Unknown ? "Waiting for an authoritative result" : "Close" )"
							        onclick="@CancelArgs"><i class="material-icons">close</i></button>
						</div>

						@if ( moneyLocked )
						{
							@* Pending, Unknown and Succeeded grants show the submitted payload as a read-only receipt.
							   Idle and Rejected retain editable inputs; unresolved grants cannot start another request. *@
							<div class="grant-receipt">
								<div class="field"><span class="k">Amount</span><span class="v grant-amount">$@_amount</span></div>
								<div class="field"><span class="k">Destination</span><span class="v">@_destination</span></div>
								<div class="field"><span class="k">Target</span><span class="v">@targetContext</span></div>
								<div class="field"><span class="k">Reason</span><span class="v grant-receipt-reason">@_reason</span></div>
							</div>
						}
						else
						{
						@foreach ( var arg in pending.Args )
						{
							// Clear the required marker only when the field is satisfied; validation still checks the value.
							var argHasValue = !string.IsNullOrWhiteSpace( ValueFor( arg.Name ) );
							var argSatisfied = IsArgSatisfied( pending, arg );
							var argLabel = arg.Kind == StaffArgKind.Number && ( pending.Key is "sethealth" or "setarmor" )
								? $"{arg.Label} ({NumberInputRangeLabel( pending )})" : arg.Label;
							var argMarker = arg.Required ? ( argSatisfied ? "" : ( argHasValue ? "Invalid" : "Required" ) ) : "Optional";
							<div class="arg-row @( pending.Dispatch == StaffDispatchKind.GiveMoney && arg.Name == "reason" ? "arg-row-money-reason" : "" )">
								@if ( pending.Dispatch == StaffDispatchKind.GiveMoney )
								{
									<div class="arg-money-label">
										<span class="arg-money-label-text">@arg.Label</span>
										<span class="arg-required @( argMarker.Length == 0 ? "arg-required-off" : "" )">@argMarker</span>
									</div>
								}
								else
								{
									<label>@argLabel <span class="arg-required @( argMarker.Length == 0 ? "arg-required-off" : "" )">@argMarker</span></label>
								}

								@if ( arg.Kind == StaffArgKind.Duration )
								{
									<div class="chips">
										@foreach ( var preset in StaffMenuConfig.DurationPresets( pending.Key ) )
										{
											var allowed = pending.Key != "ban"
												|| StaffMenuConfig.IsBanDurationAllowed( StaffMenuHost.LocalRankOrder, preset.Hours );
											<button class="chip @( _duration == preset.Token ? "chip-active" : "" ) @( allowed ? "" : "control-disabled" )"
											        onclick="@(() => SetDuration( preset.Token, allowed ))">
												@preset.Label
											</button>
										}
									</div>
									<TextEntry class="arg-input" Placeholder="@arg.Placeholder" Value:bind="@_duration"/>
								}
								else if ( arg.Kind == StaffArgKind.Destination )
								{
									<div class="chips">
										<button class="chip @( _destination == "cash" ? "chip-active" : "" )"
										        onclick="@(() => SetDestination( "cash" ))">Cash</button>
										<button class="chip @( _destination == "bank" ? "chip-active" : "" )"
										        onclick="@(() => SetDestination( "bank" ))">Bank</button>
									</div>
								}
								else if ( arg.Kind == StaffArgKind.Number )
								{
									@if ( pending.Dispatch == StaffDispatchKind.GiveMoney )
									{
										<div class="money-amount-controls">
											<TextEntry class="arg-input arg-input-money-amount" Numeric="@true" Placeholder="@arg.Placeholder" Value:bind="@_amount"/>
											<div class="chips money-amount-presets">
												@foreach ( var preset in MoneyAmountPresets )
												{
													var presetValue = preset.ToString( System.Globalization.CultureInfo.InvariantCulture );
													<button type="button" class="chip @( _amount == presetValue ? "chip-active" : "" )"
													        onclick="@(() => SetMoneyAmountPreset( preset ))">@( $"${preset / 1000}k" )</button>
												}
											</div>
										</div>
									}
									else
									{
										<TextEntry class="arg-input" Numeric="@true" Placeholder="@arg.Placeholder" Value:bind="@_amount"/>
									}
								}
								else if ( arg.Kind == StaffArgKind.Job )
								{
									<div class="job-dropdown">
										<button type="button" class="job-dropdown-header" onclick="@ToggleJobDropdown">
											@if ( !string.IsNullOrEmpty( _job ) )
											{
												var sel = StaffMenuHost.AssignableJobs().FirstOrDefault( j => j.Token == _job );
												<span class="job-swatch" style="background-color: @( sel.ColorHex ?? "#888" )"></span>
												<span>@( sel.Label ?? _job )</span>
											}
											else
											{
												<span class="job-placeholder">Select a job…</span>
											}
											<i class="material-icons job-chevron">@(_jobDropdownOpen ? "expand_less" : "expand_more")</i>
										</button>
										@if ( _jobDropdownOpen )
										{
											var jobOptions = FilteredJobOptions().ToList();
											@* Keep the job picker shell fixed so filtering does not move Confirm. The list fits up to
											   four rows with end clearance; a reserved cue indicates more rows. Query changes reset scroll. *@
											<div class="job-dropdown-shell">
												<TextEntry class="arg-input job-filter" Placeholder="Filter jobs" Value:bind="@_jobFilter"/>
												<div class="job-dropdown-list">
													@if ( jobOptions.Count == 0 )
													{
														<div class="job-empty">@( $"No job matches \"{_jobFilter?.Trim()}\"." )</div>
													}
													else
													{
														<div class="lp-ui-scroll-region job-option-scroll lp-ui-measured-scroll" @ref="_jobScroll">
															@foreach ( var job in jobOptions )
															{
																<button type="button" class="job-option @( _job == job.Token ? "job-option-active" : "" )"
																        onclick="@(() => SetJob( job.Token ))">
																	<span class="job-swatch" style="background-color: @job.ColorHex"></span>
																	<span>@job.Label</span>
																</button>
															}
															@if ( jobOptions.Count > JobVisibleRows )
															{
																<div class="job-option-tail"></div>
															}
														</div>
													}
												</div>
												<div class="job-scroll-cue">
													@if ( jobOptions.Count > JobVisibleRows && !_jobScrollAtEnd )
													{
														<i class="material-icons">unfold_more</i>
														<Label Tokenize=@(false) Text=@( $"Scroll for {jobOptions.Count - JobVisibleRows} more" ) class="job-scroll-cue-text" />
													}
												</div>
											</div>
										}
									</div>
								}
								else if ( arg.Name == "name" )
								{
									<TextEntry class="arg-input" Placeholder="@arg.Placeholder" Value:bind="@RpNameInput"/>
								}
								else
								{
									<TextEntry class="@( pending.Dispatch == StaffDispatchKind.GiveMoney ? "arg-input arg-input-money-reason" : "arg-input" )"
									           Multiline="@( pending.Dispatch == StaffDispatchKind.GiveMoney )"
									           Placeholder="@arg.Placeholder" Value:bind="@_reason"/>
								}
							</div>
						}
						}

						@if ( pending.Dispatch == StaffDispatchKind.GiveMoney )
						{
							@* Reserve the status lane so validation, confirmation and host results do not move the controls. *@
							<div class="grant-status-lane">
								@* Status priority: armed confirmation, edited rejection hint, host result, field hint, then ready. *@
								@if ( _severeConfirm && requiredArgsComplete
								      && moneyState is StaffMoneyGrantState.Idle or StaffMoneyGrantState.Rejected )
								{
									<div class="grant-confirm">
										<span class="grant-confirm-line"><span class="grant-word-lead">Are you sure? Give</span><span class="grant-amount">$@_amount</span><span class="grant-word-mid">to</span><span class="grant-target">@targetContext</span><span class="grant-word-lead">, into their</span><span class="grant-amount">@_destination</span>?</span>
										<span class="grant-confirm-sub">This is recorded in the host audit ring; portal delivery is asynchronous. It cannot be reversed from this console.</span>
									</div>
								}
								else if ( moneyState == StaffMoneyGrantState.Rejected && !requiredArgsComplete )
								{
									<div class="arg-required-hint">Complete the required fields before confirming.</div>
								}
								else if ( moneyState != StaffMoneyGrantState.Idle )
								{
									<div class="grant-result @MoneyGrantResultClass( moneyState )">
										<i class="material-icons">@MoneyGrantResultIcon( moneyState )</i>
										<span>@StaffMenuHost.MoneyGrantMessage</span>
									</div>
								}
								else if ( !requiredArgsComplete )
								{
									<div class="arg-required-hint">Complete the required fields before confirming.</div>
								}
								else
								{
									<div class="arg-required-hint">Fields complete. Confirm below; the grant is restated here before it sends.</div>
								}
							</div>
							@if ( moneyState == StaffMoneyGrantState.Succeeded )
							{
								@* Close the completed grant through the same guarded form-reset path as its header X. *@
								<button class="confirm-btn grant-close-btn" tooltip="Return to Commands" onclick="@CancelArgs">
									<i class="material-icons">close</i> Close Give Money
								</button>
							}
							@if ( moneyState == StaffMoneyGrantState.Unknown )
							{
								<button class="confirm-btn grant-reconcile-btn" onclick="@StaffMenuHost.ReconcileMoneyGrant">
									<i class="material-icons">sync</i> Recheck original request
								</button>
							}
						}
						else if ( !requiredArgsComplete )
						{
							<div class="arg-required-hint">Complete the required fields before confirming.</div>
						}

						@* Moderation keeps the actual restatement in normal flow from form opening. Its natural
						   content height stays present when the first click arms, so the second click keeps
						   the same Confirm hit target without a guessed spacer height. *@
						@if ( pending.Dispatch != StaffDispatchKind.GiveMoney
						      && ( pending.Category == StaffMenuActions.CategoryModeration || pending.Key == "forcerpname" || IsToggleAction( pending ) || ( _severeConfirm && requiredArgsComplete ) ) )
						{
							<div class="grant-confirm">
								@* Severe actions and Jail restate the action and target. Money uses the reserved status lane. *@
								<span class="grant-confirm-line"><span class="grant-word-lead">Are you sure?</span><span class="grant-amount">@PendingActionPhrase( pending )</span><span class="grant-word-mid">on</span><span class="grant-target">@targetContext</span>?</span>
								<span class="grant-confirm-sub">@ConfirmActionHint( pending )</span>
							</div>
						}

						@* Frozen grant instances have no Confirm button. Unknown outcomes allow query-only
						   reconciliation; DispatchGiveMoney also guards against another submission. *@
						@if ( ( pending.Key != "kick" || requiredArgsComplete ) && !moneyLocked )
						{
							<button class="@( ConfirmButtonClasses( pending, formCanConfirm ) )"
							        tooltip="@ConfirmButtonTooltip( pending, formCanConfirm )"
							        onclick="@(() => ConfirmArgs( selected ))">
								<i class="material-icons">@( _severeConfirm ? "warning" : "check" )</i> @ConfirmButtonLabel( pending )
							</button>
						}
					</div>
				}

				@* While an arg-form (Set Job, Ban…) is open it owns the pane — the grid would overflow the
				   window frame below it (s&box can't scroll the wrapped grid), so hide it until the form
				   closes (Confirm or X) instead of letting buttons spill past the border. *@
				@if ( _pendingAction is null )
				{
				var visibleActions = GetVisibleTabActions();
				var actionColumns = _playersCollapsed ? 5 : 4;
				<div class="action-grid @( _playersCollapsed ? "action-grid-wide" : "" )">
					@foreach ( var action in visibleActions )
					{
						var enabled = IsEnabled( action, selected, hasTarget );
						var toggleOn = action.Key == "freeze"
							? hasTarget && selected.IsFrozen
							: SelfToggleActionKeys.Contains( action.Key ) && StaffMenuHost.IsSelfToggleOn( action.Key );
							<button class="action-btn @( ActionStateClasses( action, enabled, toggleOn ) )"
							        style="@ActionRestingAccentStyle( action, enabled, toggleOn )"
						        tooltip="@( !enabled && action.TargetMode == StaffActionTarget.SelfOnly ? SelfOnlyLockedHint : ( string.IsNullOrEmpty( action.Tooltip ) ? action.Label : action.Tooltip ) )"
						        onclick="@(() => OnActionClick( action, selected, enabled ))">
							@if ( action.Key == "xray" )
							{
								<StaffXrayIcon class="material-icons xray-skull" />
							}
							else
							{
								<i class="material-icons">@action.Icon</i>
							}
							<span class="action-label">@action.Label</span>
							@* Keep at most one hint per card. The no-target banner already explains missing selection;
							   per-card reasons describe other conditions once a target is selected. *@
							@if ( !enabled && action.TargetMode == StaffActionTarget.OtherPlayer && _selectedSteamId is not null )
							{
								<span class="action-disabled-reason">@( IsSelfSanction( action, selected.SteamId ) ? "Cannot target yourself" : "Target protected" )</span>
							}
							else if ( !enabled && action.TargetMode == StaffActionTarget.SelfOnly )
							{
								<span class="action-disabled-reason">@SelfOnlyLockedHint</span>
							}
						</button>
					}

					@* Complete the final row with invisible cells so the real cards share the
					   available width without stretching into the unused columns. *@
					@for ( var i = 0; i < (actionColumns - visibleActions.Count % actionColumns) % actionColumns; i++ )
					{
						<div class="action-spacer"></div>
					}
				</div>

