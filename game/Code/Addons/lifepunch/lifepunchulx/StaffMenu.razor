	/// <summary>
	/// The one dispatch path behind the Move-a-player controls. Routed through the same
	/// re-validated <see cref="StaffMenuHost.Dispatch"/> as every other catalogue action, so these
	/// buttons carry no authority of their own -- Dispatch re-checks the permission host-side.
	/// </summary>
	private void DispatchTypedTeleport( string actionKey )
	{
		if ( !long.TryParse( _returnSteamId?.Trim(), out var steamId ) || steamId == 0 )
		{
			return;
		}

		var action = StaffMenuActions.All.FirstOrDefault( a => a.Key == actionKey );
		if ( action is null )
		{
			return;
		}

		StaffMenuHost.Dispatch( action, steamId, new Dictionary<string, string>() );
		_returnSteamId = "";
		StateHasChanged();
	}

	/// <summary>
	/// Profile-pane quick teleport (Goto/Bring/Return) on the previewed player, routed through the
	/// same re-validated <see cref="Dispatch"/> as the Ability tab (ability.teleport) -- no extra
	/// authority. The buttons are disabled in-UI for non-targetable/self; Dispatch re-checks anyway.
	/// </summary>
	private void QuickTeleport( string key, StaffMenuPlayer target )
	{
		if ( target.SteamId == 0 || !target.CanTarget || target.SteamId == StaffMenuHost.LocalSteamId )
		{
			return;
		}

		var action = StaffMenuActions.All.FirstOrDefault( a => a.Key == key );
		if ( action is null )
		{
			return;
		}

		Dispatch( action, target );
		StateHasChanged();
	}

