	private bool WebsiteDraftIsDirty() =>
		!string.Equals(
			( _websiteDraft ?? string.Empty ).Trim(),
			( StaffMenuHost.WebsiteUrl ?? string.Empty ).Trim(),
			StringComparison.Ordinal );

	// Save feedback is TRANSIENT UI STATE on the button: never persisted with the settings, never carried
	// across a panel close/open. "Saved" holds WebsiteSavedHoldSeconds or until the input changes; "Failed"
	// holds until the input changes. A fresh Settings open starts idle: SeedWebsiteDraft() is the reset site.
	private const float WebsiteSavedHoldSeconds = 2f;
	private int _websiteWriteVersionSeen;
	private string _websiteSubmittedDraft = "";
	private bool _websiteSaveConfirmed;
	private bool _websiteSaveFailed;
	private RealTimeSince _websiteSaveConfirmedAge;

	private void ResetWebsiteSaveFeedback()
	{
		_websiteWriteVersionSeen = StaffMenuHost.WebsiteWriteVersion;
		_websiteSaveConfirmed = false;
		_websiteSaveFailed = false;
	}

	private void SyncWebsiteSaveFeedback()
	{
		if ( _activeTab != TabSettings )
		{
			return;
		}

		var version = StaffMenuHost.WebsiteWriteVersion;
		if ( version != _websiteWriteVersionSeen )
		{
			_websiteWriteVersionSeen = version;
			if ( !StaffMenuHost.WebsiteWriteIsPending )
			{
				_websiteSaveConfirmed = StaffMenuHost.WebsiteWriteSucceeded;
				_websiteSaveFailed = !StaffMenuHost.WebsiteWriteSucceeded
					&& !string.IsNullOrWhiteSpace( StaffMenuHost.WebsiteWriteMessage );
				_websiteSaveConfirmedAge = 0;
			}
		}

		if ( _websiteSaveConfirmed && ( _websiteSaveConfirmedAge >= WebsiteSavedHoldSeconds || WebsiteDraftIsDirty() ) )
		{
			_websiteSaveConfirmed = false;
		}

		if ( _websiteSaveFailed && !string.Equals( ( _websiteDraft ?? string.Empty ).Trim(), _websiteSubmittedDraft, StringComparison.Ordinal ) )
		{
			_websiteSaveFailed = false;
		}
	}

	private bool WebsiteSaveIsSaved() => !StaffMenuHost.WebsiteWriteIsPending && _websiteSaveConfirmed;

	private bool WebsiteSaveIsFailed() => !StaffMenuHost.WebsiteWriteIsPending && _websiteSaveFailed;

	private string WebsiteSaveClasses()
	{
		if ( StaffMenuHost.WebsiteWriteIsPending )
		{
			return "control-disabled settings-save-disabled settings-save-pending";
		}

		if ( WebsiteSaveIsSaved() )
		{
			return "settings-save-saved";
		}

		var classes = WebsiteSaveIsFailed() ? "settings-save-failed" : "";
		if ( !WebsiteDraftIsDirty() )
		{
			classes += " control-disabled settings-save-disabled";
		}

		return classes.Trim();
	}

	private string WebsiteSaveLabel()
	{
		if ( StaffMenuHost.WebsiteWriteIsPending ) return "Saving";
		if ( WebsiteSaveIsSaved() ) return "Saved";
		if ( WebsiteSaveIsFailed() ) return "Failed";
		return "Save";
	}

	private string WebsiteSaveIcon()
	{
		if ( StaffMenuHost.WebsiteWriteIsPending ) return "sync";
		if ( WebsiteSaveIsSaved() ) return "check";
		if ( WebsiteSaveIsFailed() ) return "error";
		return "save";
	}

	private string WebsiteSaveTooltip()
	{
		if ( StaffMenuHost.WebsiteWriteIsPending ) return "Waiting for the server API result";
		if ( WebsiteSaveIsSaved() ) return string.IsNullOrWhiteSpace( StaffMenuHost.WebsiteWriteMessage ) ? "Saved" : StaffMenuHost.WebsiteWriteMessage;
		if ( WebsiteSaveIsFailed() ) return $"{StaffMenuHost.WebsiteWriteMessage} — edit and Save to retry";
		return WebsiteDraftIsDirty() ? "Save the network website link" : "No website changes to save";
	}

	/// <summary>Save the typed network website URL (host re-checks the owner grant). Empty clears it.</summary>
	private void SaveWebsiteFromInput()
	{
		if ( !WebsiteDraftIsDirty() || StaffMenuHost.WebsiteWriteIsPending )
		{
			return;
		}

		_websiteDraftTouched = true;
		_websiteSubmittedDraft = ( _websiteDraft ?? string.Empty ).Trim();
		_websiteSaveConfirmed = false;
		_websiteSaveFailed = false;
		StaffMenuHost.SaveWebsite( _websiteSubmittedDraft );
	}

	private void SeedWebsiteDraft()
	{
		_websiteDraft = StaffMenuHost.WebsiteUrl;
		_websiteDraftBaseline = _websiteDraft;
		_websiteDraftTouched = false;
		_lastSettingsVersion = StaffMenuHost.SettingsVersion;
		// Every Settings open (including a fresh panel after close/reopen) starts with an idle Save button.
		ResetWebsiteSaveFeedback();
	}

	private void SyncWebsiteDraftFromHost()
	{
		if ( _activeTab != TabSettings )
		{
			return;
		}

		// Detect typing before accepting an async refresh; this preserves a real operator edit even
		// when the response and input arrive in the same frame.
		if ( !string.Equals( _websiteDraft ?? string.Empty, _websiteDraftBaseline ?? string.Empty,
			StringComparison.Ordinal ) )
		{
			_websiteDraftTouched = true;
		}

		var version = StaffMenuHost.SettingsVersion;
		if ( version == _lastSettingsVersion )
		{
			return;
		}

		_lastSettingsVersion = version;
		if ( !_websiteDraftTouched )
		{
			_websiteDraft = StaffMenuHost.WebsiteUrl;
			_websiteDraftBaseline = _websiteDraft;
		}
		else if ( !WebsiteDraftIsDirty() )
		{
			_websiteDraftBaseline = _websiteDraft;
			_websiteDraftTouched = false;
		}
	}

	private static bool MoneyGrantNavigationLocked() =>
