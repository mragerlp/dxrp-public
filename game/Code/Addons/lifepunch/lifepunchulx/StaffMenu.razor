		_jobDropdownOpen = !_jobDropdownOpen;
		StateHasChanged();
	}

	private IEnumerable<StaffJobOption> FilteredJobOptions()
	{
		var query = _jobFilter?.Trim() ?? "";
		var jobs = StaffMenuHost.AssignableJobs();
		if ( query.Length == 0 )
		{
			return jobs;
		}

		return jobs.Where( job =>
			job.Label.Contains( query, StringComparison.OrdinalIgnoreCase )
			|| job.Token.Contains( query, StringComparison.OrdinalIgnoreCase ) );
	}

	private void ConfirmArgs( StaffMenuPlayer selected )
	{
		if ( _pendingAction is not { } action || ( action.Key == "xray" && !StaffMenuHost.CanUseXray() ) )
		{
			return;
		}

		// Do not execute an operation whose displayed direction changed before this click.
		if ( RefreshPendingToggleState() || !HasRequiredToggleState( action ) )
		{
			return;
		}

		var args = new Dictionary<string, string>();
		foreach ( var arg in action.Args )
		{
			var value = ValueForDispatch( action, arg );
			if ( !IsArgSatisfied( action, arg ) )
			{
				return; // missing or semantically invalid input -- keep the form open
			}

			args[arg.Name] = value;
		}

		// Guarded actions arm on the first click and restate the action and target.
		// UsesDoubleClickConfirm requires the second click within SevereDoubleClickWindow;
		// a later click only rearms. This confirmation runs in the live build and does not
		// replace host-side authorization.
		if ( RequiresArmedConfirm( action ) )
		{
			var currentPayloadFingerprint = BuildArmedPayloadFingerprint( action, selected, args, _pendingToggleState );
			if ( !_severeConfirm
				|| !string.Equals( _armedPayloadFingerprint, currentPayloadFingerprint, StringComparison.Ordinal ) )
			{
				_severeConfirm = true;
				_armedPayloadFingerprint = currentPayloadFingerprint;
				_severeArmAge = 0;
				StateHasChanged();
				return;
			}

			if ( UsesDoubleClickConfirm( action ) && _severeArmAge > SevereDoubleClickWindow )
			{
				_severeArmAge = 0;
				StateHasChanged();
				return;
			}
		}

		if ( action.Dispatch == StaffDispatchKind.GiveMoney )
		{
			_moneyGrantTargetSteamId = selected.SteamId;
			_moneyGrantTargetName = string.IsNullOrWhiteSpace( selected.Name )
				? $"SteamID {selected.SteamId}"
				: selected.Name;
		}

		Dispatch( action, selected, args, _pendingToggleState );
		if ( action.Dispatch == StaffDispatchKind.GiveMoney )
		{
			InvalidateArmedConfirm();
			StateHasChanged();
			return;
		}

		CancelArgs();
	}

	private static string BuildArmedPayloadFingerprint(
		StaffAction action,
		StaffMenuPlayer selected,
		IReadOnlyDictionary<string, string> args,
		bool? toggleState )
	{
		var fingerprint = new System.Text.StringBuilder();
		AppendFingerprintPart( fingerprint, action.Key );
		var targetSteamId = action.TargetMode == StaffActionTarget.OtherPlayer
			? selected.SteamId
			: StaffMenuHost.LocalSteamId;
		AppendFingerprintPart( fingerprint, targetSteamId.ToString( System.Globalization.CultureInfo.InvariantCulture ) );
		if ( IsToggleAction( action ) )
		{
			AppendFingerprintPart( fingerprint, ToggleStateLabel( toggleState ) );
		}

		foreach ( var arg in action.Args )
		{
			AppendFingerprintPart( fingerprint, arg.Name );
			AppendFingerprintPart( fingerprint, args.TryGetValue( arg.Name, out var value ) ? value : "" );
		}

		return fingerprint.ToString();
	}

	private static void AppendFingerprintPart( System.Text.StringBuilder fingerprint, string value )
	{
		value ??= "";
		fingerprint.Append( value.Length ).Append( ':' ).Append( value ).Append( '|' );
	}

	private void InvalidateArmedConfirm()
	{
		_severeConfirm = false;
		_armedPayloadFingerprint = "";
	}

	private string ValueFor( string argName ) => argName switch
	{
		"destination" => _destination,
		"reason" => _reason,
		"duration" => _duration,
		"amount" => _amount,
		"name" => _name,
		"job" => _job,
		_ => ""
	};

	// Canonical duration is shared by confirmation and dispatch; other argument text stays verbatim.
	private string ValueForDispatch( StaffAction action, StaffActionArg arg )
	{
		var value = ValueFor( arg.Name );
		if ( arg.Kind != StaffArgKind.Duration )
		{
			return value;
		}

		if ( string.IsNullOrWhiteSpace( value ) )
		{
			return "";
		}

		return StaffMenuConfig.TryNormalizeDurationToken( value, action.Key == "ban", out var normalized )
			? normalized
			: value;
	}

	private bool IsArgSatisfied( StaffAction action, StaffActionArg arg )
	{
		var value = ValueFor( arg.Name )?.Trim() ?? "";
		if ( value.Length == 0 )
		{
			return !arg.Required;
		}

		return arg.Kind switch
		{
			StaffArgKind.Duration => IsDurationSatisfied( action, value ),
			StaffArgKind.Number => IsNumberSatisfied( action, value ),
			StaffArgKind.Destination => value is "cash" or "bank",
			_ => true
		};
	}

	private bool IsNumberSatisfied( StaffAction action, string value )
	{
		if ( !uint.TryParse( value, out var amount ) || amount > int.MaxValue )
		{
			return false;
		}

		if ( action.Key is "sethealth" or "setarmor" )
		{
			return StaffMenuHost.TryGetNumberInputBounds( action.Key, _selectedSteamId ?? 0,
				out var minimum, out var maximum ) && amount >= minimum && amount <= maximum;
		}

		return amount > 0;
	}

	private string NumberInputRangeLabel( StaffAction action )
	{
		return StaffMenuHost.TryGetNumberInputBounds( action.Key, _selectedSteamId ?? 0,
			out var minimum, out var maximum )
			? $"{minimum.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture )}–{maximum.ToString( "N0", System.Globalization.CultureInfo.InvariantCulture )}"
			: "limit unavailable";
	}

	private static bool IsDurationSatisfied( StaffAction action, string value )
	{
		if ( action.Key == "ban" )
		{
			return StaffMenuConfig.IsBanDurationTokenAllowed( StaffMenuHost.LocalRankOrder, value );
		}

		return StaffMenuConfig.TryNormalizeDurationToken( value, allowPermanent: false, out _ );
	}

	private static string MoneyGrantResultClass( StaffMoneyGrantState state ) => state switch
	{
		StaffMoneyGrantState.Succeeded => "grant-result-success",
		StaffMoneyGrantState.Pending => "grant-result-pending",
		StaffMoneyGrantState.Unknown => "grant-result-unknown",
		_ => "grant-result-rejected"
	};

	private static string MoneyGrantResultIcon( StaffMoneyGrantState state ) => state switch
	{
		StaffMoneyGrantState.Succeeded => "check_circle",
		StaffMoneyGrantState.Pending => "hourglass_top",
		StaffMoneyGrantState.Unknown => "help",
		_ => "error"
	};

	private void Dispatch( StaffAction action, StaffMenuPlayer selected, IReadOnlyDictionary<string, string>? args = null,
		bool? expectedToggleState = null )
	{
		// Direct self toggles capture this click; confirmed forms retain the state they displayed.
		if ( args is null && StaffMenuHost.IsGuardedStatusToggle( action.Key ) )
		{
			expectedToggleState = StaffMenuHost.GetCommandToggleState( action.Key,
				action.TargetMode == StaffActionTarget.OtherPlayer ? selected.SteamId : StaffMenuHost.LocalSteamId );
		}

		args ??= new Dictionary<string, string>();

		if ( action.TargetMode != StaffActionTarget.OtherPlayer )
		{
			// Belt and braces behind the eligibility gate: a self-only ability never dispatches while another
			// player is the selected target, so it can never be silently applied to the caller instead.
			if ( action.TargetMode == StaffActionTarget.SelfOnly && !SelfOnlyTargetIsCaller() )
			{
				Log.Warning( $"[lifepunchulx] Refused self-only '{action.Key}': selected target {_selectedSteamId} is not the caller {StaffMenuHost.LocalSteamId}." );
				return;
			}

			StaffMenuHost.Dispatch( action, StaffMenuHost.LocalSteamId, args, expectedToggleState );
			return;
		}

		if ( selected.SteamId == 0 || !selected.CanTarget || IsSelfSanction( action, selected.SteamId ) )
		{
			return;
		}

		StaffMenuHost.Dispatch( action, selected.SteamId, args, expectedToggleState );
	}

	private void ClearAuditPlayer()
	{
		_auditPlayerId = "";
		StateHasChanged();
	}

	private void ClearAuditEntity()
	{
		_auditEntity = "";
		StateHasChanged();
	}

	// Presentation only: raw keys stay untouched for filtering, counts, and storage.
	// Audit descriptions can prefix a key (for example "[Generic] #governance...")
	// so replace every recognized token, not only strings whose first byte is '#'.
	private static string PresentAuditText( string text )
	{
		if ( string.IsNullOrWhiteSpace( text ) || !text.Contains( '#' ) )
		{
			return text;
		}

		return System.Text.RegularExpressions.Regex.Replace( text, @"#[A-Za-z0-9._-]+", match =>
		{
			var key = match.Value[1..];
			var localized = StaffMenuHost.Localize( key );
			return string.IsNullOrWhiteSpace( localized ) || localized == key || localized == match.Value
				? match.Value
				: localized;
		} );
	}

	private const float AuditEndSnapDistance = 8f;

	// The list has no synthetic tail. When native scrolling stops within the final
	// small band, finish at the real content boundary so the last row is complete.
	private void SnapAuditScrollEnd()
	{
		if ( _activeTab != TabAudit || !_auditScroll.IsValid() )
		{
			return;
		}

		var viewportHeight = _auditScroll.Box.Rect.Height;
		if ( viewportHeight <= 1f )
		{
			return;
		}

		// Share the opted-in measured limit with the clamp; keep the end snap in those same units.
		var maxY = LifePunchUiScrollPolicy.GetMeasuredScrollMaxY( _auditScroll );
		var remaining = maxY - _auditScroll.ScrollOffset.y;
		if ( remaining > AuditEndSnapDistance || remaining <= 0.01f )
		{
			return;
		}

		_auditScroll.ScrollOffset = new Vector2( 0f, maxY );
	}

	// End-of-list sensor for the Set Job cue. Share the core measured limit with the clamp and audit
	// end snap. Short lists contain only their option rows; lists longer than four retain the 8px tail.
	// For long lists, content = 30N + 8 against a viewport of min(content, 128); for
	// N > 4 the reachable maximum is 30(N-4) (the tail and the viewport's extra 8px cancel) -- the same
	// clamp the manual scroll policy applies. "At end" therefore means the final option's bottom edge
	// sits 8px above the viewport bottom (the tail filling the gap) within JobEndTolerance: four complete
	// option rows in view, the alphabetically last job in the fourth slot, and the cue clears. Read-only:
	// it never moves the offset. _jobScrollAtEnd reaches BuildHash so the cue repaints the frame the end
	// is reached; a closed dropdown reads as "not at end" so the next open starts with the cue showing.
	private Panel _jobScroll;
	private bool _jobScrollAtEnd;
	private const float JobEndTolerance = 2f;

	// Rows the Set Job viewport shows before it scrolls (sheet: 4 x 30px plus end clearance).
	private const int JobVisibleRows = 4;

	// TextEntry binds the job filter directly. Detect query changes and reset its scroll offset;
	// LifePunchUiScrollPolicy then clamps against the filtered content height.
	private string _jobFilterSeen = "";

	private void SenseJobFilterChange()
	{
		var current = _jobFilter ?? "";
		if ( string.Equals( current, _jobFilterSeen, StringComparison.Ordinal ) )
		{
			return;
		}

		_jobFilterSeen = current;
		if ( _jobDropdownOpen && _jobScroll.IsValid() )
		{
			_jobScroll.ScrollOffset = Vector2.Zero;
		}
	}

	private void SenseJobScrollEnd()
	{
		var atEnd = false;
		if ( _jobDropdownOpen && _jobScroll.IsValid() )
		{
			var viewportHeight = _jobScroll.Box.Rect.Height;
			if ( viewportHeight > 1f )
			{
				var maxY = LifePunchUiScrollPolicy.GetMeasuredScrollMaxY( _jobScroll );
				atEnd = maxY <= JobEndTolerance || _jobScroll.ScrollOffset.y >= maxY - JobEndTolerance;
			}
		}

		if ( atEnd == _jobScrollAtEnd )
		{
			return;
		}

		_jobScrollAtEnd = atEnd;
		StateHasChanged();
	}

	private static string ActionPillClass( string action )
		=> StaffMenuHost.AuditActionTone( action );

	private bool IsAuditActionSelected( string action )
		=> _auditActions.Any( selected => selected.Equals( action, StringComparison.OrdinalIgnoreCase ) );

	// Use a standalone active class because compound selectors are unreliable in s&box.
	// is-empty dims actions with no matches under the other filters.
	private string AuditActionFilterPillClass( string action, IReadOnlyDictionary<string, int> counts )
	{
		var css = "audit-action-chip " + ActionPillClass( action );
		if ( IsAuditActionSelected( action ) )
		{
			css += " is-active";
		}

		if ( AuditActionCount( action, counts ) == 0 )
		{
			css += " is-empty";
		}

		return css;
	}

	/// <summary>
	/// Per-action counts while the popover is open; otherwise an empty map.
	/// Counting walks the feed, so closed popovers skip that work.
	/// </summary>
	private IReadOnlyDictionary<string, int> AuditActionCounts()
		=> _auditActionOpen
			? StaffMenuHost.AuditActionCounts( _auditPlayerId, _auditEntity, _auditScope, _auditWindowMinutes )
			: EmptyActionCounts;

	private static readonly Dictionary<string, int> EmptyActionCounts = new();

	private static int AuditActionCount( string action, IReadOnlyDictionary<string, int> counts )
	{
		if ( counts is null || string.IsNullOrEmpty( action ) )
		{
			return 0;
		}

		return counts.TryGetValue( action, out var count ) ? count : 0;
	}

