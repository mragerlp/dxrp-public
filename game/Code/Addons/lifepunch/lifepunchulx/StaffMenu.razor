	private static string MoneyGrantCloseTooltip() => StaffMenuHost.MoneyGrantState switch
	{
		StaffMoneyGrantState.Pending => "Close unavailable while the host confirms this money grant",
		StaffMoneyGrantState.Unknown => "Close unavailable until the original money grant has a terminal result",
		_ => "Close Menu"
	};

	/// <summary>Copy the owner-configured website link to the clipboard, with a brief "copied" confirmation.</summary>
	private void CopyWebsite()
	{
		if ( !StaffMenuHost.HasWebsite )
		{
			return;
		}

		Clipboard.SetText( StaffMenuHost.WebsiteUrl );
		_websiteCopied = true;
		StateHasChanged();
		_ = RevertWebsiteLabel();
	}

	private async System.Threading.Tasks.Task RevertWebsiteLabel()
	{
		await GameTask.DelayRealtimeSeconds( 1.8f );
		_websiteCopied = false;
		StateHasChanged();
	}

	/// <summary>Copy a player's SteamID64 from the profile pane to the OS clipboard.</summary>
	private void CopySteamId( long steamId )
	{
		Clipboard.SetText( steamId.ToString() );
		_copiedSteamId = steamId;
		StateHasChanged();
		_ = RevertSteamIdLabel( steamId );
	}

	private async System.Threading.Tasks.Task RevertSteamIdLabel( long copiedSteamId )
	{
		await GameTask.DelayRealtimeSeconds( 1.8f );
		if ( _copiedSteamId != copiedSteamId )
		{
			return;
		}

		_copiedSteamId = 0;
		StateHasChanged();
	}

	/// <summary>Copy the saved network website from the Settings "Current" line to the clipboard.</summary>
	private void CopyCurrentWebsite()
	{
		if ( !StaffMenuHost.HasWebsite )
		{
			return;
		}

		Clipboard.SetText( StaffMenuHost.WebsiteUrl );
		_currentCopied = true;
		StateHasChanged();
		_ = RevertCurrentLabel();
	}

	private async System.Threading.Tasks.Task RevertCurrentLabel()
	{
		await GameTask.DelayRealtimeSeconds( 1.8f );
		_currentCopied = false;
		StateHasChanged();
	}

	protected override int BuildHash()
	{
		// _detailHash is refreshed on the throttled cadence (RecomputeDetailHash), NOT recomputed here
		// every frame -- otherwise a live stat change would rebuild the whole menu continuously and the
		// sidebar/cog hover would flicker.
		return HashCode.Combine(
			HashCode.Combine(
				HashCode.Combine( _selectedSteamId, _profileSteamId, _showProfile, _searchText ),
				HashCode.Combine( _rosterHash, _playersCollapsed, _staffSectionCollapsed, _playersSectionCollapsed ),
				_activeTab,
				HashCode.Combine( _pendingAction?.Key, _pendingToggleState ),
				HashCode.Combine( _destination, _severeConfirm, StaffMenuHost.MoneyGrantVersion,
					(int)StaffMenuHost.MoneyGrantState, StaffMenuHost.MoneyGrantMessage ),
				HashCode.Combine( _reason, _duration, _amount, _name, _job, _jobFilter, _jobDropdownOpen, _jobScrollAtEnd ),
				HashCode.Combine(
					HashCode.Combine( _auditPlayerId, _auditEntity, _auditActionsVersion, _auditActionOpen ),
					// Own group rather than a sixth argument above: HashCode.Combine tops out at 8, and
					// every audit filter MUST reach the hash or its control moves while the grid does not.
					HashCode.Combine( _auditScope, _auditWindowMinutes, _auditWindowOpen ),
					HashCode.Combine(
						HashCode.Combine( _websiteDraft, _websiteCopied, _copiedSteamId, _currentCopied,
							StaffMenuHost.SettingsVersion, StaffMenuHost.WebsiteWriteVersion, _websiteSaveConfirmed, _websiteSaveFailed ),
						HashCode.Combine( _pocketModalOpen, _pocketModalSteamId, StaffMenuHost.GetPocketSlotCount(),
							StaffMenuHost.PocketClientRevision,
							StaffMenuHost.PocketAnsweredFor,
							StaffMenuHost.PocketIsLoading( _pocketModalSteamId ) ),
						HashCode.Combine( _inventoryModalOpen, _inventoryModalSteamId,
							StaffMenuHost.InventoryClientRevision, StaffMenuHost.InventoryAnsweredFor,
							(int)StaffMenuHost.GetInventoryState( _inventoryModalSteamId ) ) ) ),
				// Hash response revision and answered subject alongside request state, following
				// DXRP PlayerSanctionHistory.razor. A response for another player must not satisfy this view.
				// Keep a nested group because HashCode.Combine accepts at most eight arguments.
				HashCode.Combine( _waypointName, StaffMenuHost.WaypointVersion, _returnSteamId, _wpPendingDelete,
					_sanctionsSeedVersion,
					HashCode.Combine( StaffMenuHost.SanctionsVersion, _sanctionsSteamId,
						StaffMenuHost.SanctionsClientRevision, StaffMenuHost.SanctionsAnsweredFor,
						(int)StaffMenuHost.GetSanctionsState( _sanctionsSteamId ),
						StaffMenuHost.CanViewSanctions( _sanctionsSteamId ),
						StaffMenuHost.CanViewPocket( _profileSteamId ?? _selectedSteamId ?? 0 ),
						StaffMenuHost.CanViewInventory( _profileSteamId ?? _selectedSteamId ?? 0 ) ) ) ),
			_detailHash,
			// View state with no backend. It MUST reach the hash or the chosen swatch would not
			// repaint until something else happened to rebuild the panel. The draft holder colour is in
			// here for the same reason PartyMenu hashes its picker: the preview swatch and the Apply gate
			// follow the picker before anything is committed.
			HashCode.Combine( _appliedAccentColor, _accentDirty, _accentHolder.Color,
				_copiedAppliedAccentHex, _copiedSelectedAccentHex, _accentHexInput, _accentHexInvalid ) );
	}
