	protected override void OnStart()
	{
		RefreshRoster();
		LifePunchUiScrollPolicy.Apply( Panel );

		// Fetch owner settings on open so the network tag is click-to-copy immediately (not only after
		// the Settings view is visited).
		StaffMenuHost.RefreshSettings();

		if ( StaffMenuHost.CanUseWaypoints() )
		{
			StaffMenuHost.RefreshWaypoints();
		}
	}

	protected override void OnUpdate()
	{
		// Wheel-only scroll: disable drag-scroll and clamp offsets every frame (sidebar roster, audit, etc.).
		// NOTE: do NOT call LifePunchScrollRegionBootstrap.UpgradeScrollRegionsFromHost here -- StaffMenu's
		// scroll regions hold razor-managed lists, and the upgrade reparents them out from under razor's
		// render tree (continuous "Fixing parent" + BuildRenderTree asserts = visible flicker).
		LifePunchUiScrollPolicy.Apply( Panel );
		SnapAuditScrollEnd();
		SenseJobFilterChange();
		SenseJobScrollEnd();
		SyncWebsiteDraftFromHost();
		SyncWebsiteSaveFeedback();

		// Refresh on the fixed cadence to keep volatile reads from replaying menu hover states.
		if ( _sinceRosterRefresh >= RosterRefreshInterval )
		{
			_sinceRosterRefresh = 0;
			RefreshRoster();
		}

		if ( _sinceRefresh < RefreshInterval )
		{
			return;
		}

		_sinceRefresh = 0;
		RefreshPendingToggleState();
		RecomputeDetailHash();
		SyncHealthActionStyle();
	}

	private void RefreshRoster()
	{
		_players = StaffMenuHost.OnlinePlayers();

		var rosterHash = 0;
		foreach ( var p in _players )
		{
			rosterHash = HashCode.Combine( rosterHash, p.SteamId, p.Name, p.CanTarget,
				HashCode.Combine( p.IsFrozen, p.GroupName, p.GroupOrder, p.Role, p.RankColorHex ) );
		}

		// Permission definitions can change without changing a player's rank label or roster order.
		// Fold every action permission plus the non-card surfaces into the sampled identity hash so
		// tabs and affordances repaint on the next roster tick. Host dispatch remains authoritative.
		foreach ( var permissionId in StaffMenuActions.All.Select( action => action.PermissionId )
			         .Concat( SupplementalPermissionIds ).Distinct() )
		{
			rosterHash = HashCode.Combine( rosterHash, permissionId, StaffMenuHost.CanView( permissionId ) );
		}

		// If a live rank edit revokes the permission behind an already-open privileged surface,
		// leave that surface on the same one-second permission sample instead of keeping stale data open.
		if ( (_activeTab == TabWaypoints && !StaffMenuHost.CanUseWaypoints())
		     || (_activeTab == TabAudit && !StaffMenuHost.CanViewAudit())
		     || (_activeTab == TabSanctions && !StaffMenuHost.CanViewSanctions( _sanctionsSteamId )) )
		{
			_activeTab = StaffMenuActions.CategoryModeration;
			_sanctionsSteamId = 0;
			_pendingAction = null;
			InvalidateArmedConfirm();
		}

		if ( _inventoryModalOpen && !StaffMenuHost.CanViewInventory( _inventoryModalSteamId ) )
		{
			ResetInventoryModal();
		}

		if ( _pocketModalOpen && !StaffMenuHost.CanViewPocket( _pocketModalSteamId ) )
		{
			ResetPocketModal();
		}

		rosterHash = HashCode.Combine( rosterHash, StaffMenuHost.CanUseXray() );
		if ( _pendingAction?.Key == "xray" && !StaffMenuHost.CanUseXray() )
		{
			CancelArgs();
		}

		_rosterHash = rosterHash;

		// Drop a selection whose player left -- unless it was a manually typed Steam ID (off-roster target).
		if ( _selectedSteamId.HasValue
		     && _selectedSteamId != _manualSteamId
		     && !MoneyGrantNavigationLocked()
		     && _players.All( p => p.SteamId != _selectedSteamId.Value ) )
		{
			_selectedSteamId = null;
			_showProfile = false;
		}
	}

	// Snapshot the open profile's volatile stats into a single hash on the refresh cadence (not every
	// frame), so BuildHash only flips the menu when a value really changed -- keeping the surrounding
	// chrome (sidebar, cog) stable between updates.
	private void RecomputeDetailHash()
	{
		if ( _showProfile && _profileSteamId is { } sid && sid != 0 )
		{
			var d = StaffMenuHost.GetPlayerDetail( sid );
			_detailHash = HashCode.Combine(
				d.Health, d.MaxHealth, d.Armor, d.Level, d.Wallet, d.Bank, d.BaseSalary,
				HashCode.Combine( d.Kills, d.Deaths, d.Job, d.JobColorHex, d.Role, d.PlayTimeMinutes, d.MaxArmor, d.RankColorHex ) );

			foreach ( var flag in StaffMenuHost.GetStateFlags( sid ) )
			{
				_detailHash = HashCode.Combine( _detailHash, flag.Label, flag.Illegitimate );
			}
		}
		else
		{
			_detailHash = 0;
		}

		// Toggle state is live DXRP state, so it is sampled on the same throttled cadence as the
		// other volatile values -- sampling it in BuildHash would re-read it every frame.
		_detailHash = HashCode.Combine( _detailHash, SelfToggleHash() );
		if ( _pendingAction?.Key == "setarmor" )
		{
			var hasBounds = StaffMenuHost.TryGetNumberInputBounds( "setarmor", _selectedSteamId ?? 0,
				out var minimum, out var maximum );
			_detailHash = HashCode.Combine( _detailHash, hasBounds, minimum, maximum );
		}

		// A new audit row must appear while the Audit tab is on screen --
		// nothing else in the hash changes when the ring grows. Cheap static int read.
		_detailHash = HashCode.Combine( _detailHash, StaffMenuHost.AuditVersion );

		// Relative "When" labels ("2 minutes ago") go stale while the tab sits open; a minute
		// bucket re-renders them on the minute, and only for the views that show timestamps.
		if ( _activeTab == TabAudit || _activeTab == TabWaypoints || _activeTab == TabSettings
		     || _activeTab == TabSanctions || _showProfile )
		{
			_detailHash = HashCode.Combine( _detailHash, DateTime.UtcNow.Ticks / TimeSpan.TicksPerMinute );
		}
	}

	// Quick sanctions retain their profile danger colors and escalation order:
	// Jail first, then Kick and Ban in catalogue order. Self-toggle state is separate from severity.
	private static readonly string[] QuickSanctionKeys = { "jail", "kick", "ban" };

	private static readonly string[] SelfToggleActionKeys =
	{
		"god", "cloak", "incognito", "noclip", "xray"
	};

	private static readonly string[] SupplementalPermissionIds =
	{
		StaffMenuHost.AuditPermissionId,
		StaffMenuHost.WaypointUsePermissionId,
		StaffMenuHost.WaypointEditPermissionId,
		StaffMenuHost.SettingsEditPermissionId,
		"player.pocket.view",
		"inventory.view",
		"player.sanctions.view.self",
		"player.sanctions.view.other"
	};

	private static string ProfileFlagClass( StaffStateFlag flag )
	{
		if ( flag.Illegitimate )
		{
			return "flag-illegit";
		}

		var actionKey = flag.Label switch
		{
			"God mode" => "god",
			"Cloaked" => "cloak",
			"Incognito" => "incognito",
			"Noclip" => "noclip",
			"X-ray" => "xray",
			"Frozen" => "freeze",
			"Jailed" => "jail",
			"Gagged" => "gag",
			_ => ""
		};
		var action = StaffMenuActions.All.FirstOrDefault( candidate => candidate.Key == actionKey );
		if ( action is null )
		{
			return "";
		}

		return action.DisplayTone switch
		{
			StaffActionDisplayTone.Cloak => "profile-flag-cloak",
			StaffActionDisplayTone.Freeze => "profile-flag-freeze",
			_ => action.Severity switch
			{
				StaffActionSeverity.Light => "profile-flag-light",
				StaffActionSeverity.Medium => "profile-flag-medium",
				StaffActionSeverity.Severe => "profile-flag-severe",
				_ => ""
			}
		};
	}

	private static string SeverityClass( StaffActionSeverity severity ) => severity switch
	{
		StaffActionSeverity.Light => "action-severity-light",
		StaffActionSeverity.Medium => "action-severity-medium",
		StaffActionSeverity.Severe => "action-severity-severe",
		_ => throw new ArgumentOutOfRangeException( nameof( severity ), severity, "Unknown staff action severity" )
	};

	/// <summary>
	/// Severity, display-tone, and live-state classes for one action card, returned as ONE string: the transpiler
	/// cannot take two adjacent @() expressions in a single attribute.
	/// </summary>
	private string ActionStateClasses( StaffAction action, bool enabled, bool toggleOn )
	{
		var classes = enabled ? "" : "control-disabled action-disabled-state";
		classes += $" {SeverityClass( action.Severity )}";

		if ( action.DisplayTone == StaffActionDisplayTone.Money )
		{
			classes += " action-tone-money";
		}
		else if ( action.DisplayTone == StaffActionDisplayTone.Armor )
		{
			classes += " action-tone-armor";
		}
		else if ( action.DisplayTone == StaffActionDisplayTone.Cloak )
		{
			classes += " action-tone-cloak";
		}
		else if ( action.DisplayTone == StaffActionDisplayTone.Freeze )
		{
			classes += " action-tone-freeze";
		}
		else if ( enabled && action.DisplayTone == StaffActionDisplayTone.Health )
		{
			classes += " action-tone-health";
		}

		// Read from the host, never from a local click flag -- a click echo would desync from the
		// HUD the moment anything else changed the state (death, respawn, another admin, reconnect).
		if ( toggleOn )
		{
			classes += " action-toggle-on";
			if ( action.Key == "cloak" )
			{
				classes += " action-cloak-on";
			}
			else if ( action.Key == "freeze" )
			{
				classes += " action-freeze-on";
			}
		}

		return classes.Trim();
	}

	// Deleting a waypoint is permanent and its control sits one pixel from Go in a repeated
	// column -- a misclick loses data with no undo. The row confirms in place instead.
	private string? _wpPendingDelete;

	private void AskClearWaypoint( string name )
	{
		_wpPendingDelete = name;
		StateHasChanged();
	}

	private void CancelClearWaypoint()
	{
		_wpPendingDelete = null;
		StateHasChanged();
	}

	private void ConfirmClearWaypoint( string name )
	{
		_wpPendingDelete = null;
		ClearWaypoint( name );
	}

	/// <summary>Live self-toggle state, folded into the throttled detail hash so cards re-render.</summary>
	private int SelfToggleHash()
	{
		var bits = 0;
		for ( var i = 0; i < SelfToggleActionKeys.Length; i++ )
		{
			if ( StaffMenuHost.IsSelfToggleOn( SelfToggleActionKeys[i] ) )
			{
				bits |= 1 << i;
			}
		}

		return bits;
	}

	/// <summary>The roster filtered by the search box (by name); unfiltered when empty or a Steam ID.</summary>
	private IEnumerable<StaffMenuPlayer> FilteredPlayers()
	{
		var query = _searchText?.Trim() ?? "";
		if ( query.Length == 0 || IsSteamId( query ) )
		{
			return _players;
		}

		return _players.Where( p => p.Name.Contains( query, StringComparison.OrdinalIgnoreCase ) );
	}

	/// <summary>A typed value looks like a SteamID64 (17 digits; accept 16-20 to be lenient).</summary>
	private static bool IsSteamId( string? text )
	{
		text = text?.Trim() ?? "";
		return text.Length is >= 16 and <= 20 && text.All( char.IsDigit );
	}

	/// <summary>
	/// Staff sub-groups under the "Staff" parent -- one row per portal rank name that has someone online
	/// with staff-menu permissions, highest portal rank order first. Optional
	/// <see cref="StaffMenuConfig.ReferenceTiers"/> may add empty "(0)" placeholder tiers when populated.
	/// </summary>
	private List<(string Name, List<StaffMenuPlayer> Players)> StaffTierGroups()
	{
		var staff = FilteredPlayers().Where( p => p.GroupName != StaffMenuHost.NonStaffGroup ).ToList();
		var groups = new List<(string Name, List<StaffMenuPlayer> Players)>();

		foreach ( var tier in StaffMenuConfig.ReferenceTiers )
		{
			groups.Add( ( tier.Name, staff
				.Where( p => string.Equals( p.GroupName.Trim(), tier.Name.Trim(), StringComparison.OrdinalIgnoreCase ) )
				.OrderBy( p => p.Name )
				.ToList() ) );
		}

		foreach ( var online in staff
			.Where( p => !StaffMenuConfig.ReferenceTiers.Any( t => string.Equals( t.Name.Trim(), p.GroupName.Trim(), StringComparison.OrdinalIgnoreCase ) ) )
			.GroupBy( p => p.GroupName )
			.OrderByDescending( g => g.Max( p => p.GroupOrder ) )
			.ThenBy( g => g.Key ) )
		{
			groups.Add( ( online.Key, online.OrderBy( p => p.Name ).ToList() ) );
		}

		return groups;
	}

	/// <summary>
	/// Clicking a roster row PREVIEWS that player's profile -- it does not target them. Re-clicking the
	/// open preview closes it. Targeting only happens via <see cref="ConfirmTarget"/> ("Actions for
	/// this player"), so a click never silently arms a command.
	/// </summary>
	private void Select( long steamId )
	{
		if ( MoneyGrantNavigationLocked() )
		{
			return;
		}

		ResetPocketModal();
		ResetInventoryModal();

		// Re-clicking the player whose profile is already open closes the preview.
		if ( _showProfile && _profileSteamId == steamId )
		{
			_profileSteamId = null;
			_showProfile = false;
			CancelArgs();
			return;
		}

		_profileSteamId = steamId;
		_showProfile = true;
		CancelArgs();
	}

	/// <summary>Preview the profile for a Steam ID typed into the search box (off-roster allowed).</summary>
	private void SelectTypedSteamId()
	{
		if ( MoneyGrantNavigationLocked() )
		{
			return;
		}

		var text = _searchText?.Trim() ?? "";
		if ( !IsSteamId( text ) || !long.TryParse( text, out var steamId ) )
		{
			return;
		}

		ResetPocketModal();
		ResetInventoryModal();
		_profileSteamId = steamId;
		_showProfile = true;
		CancelArgs();
	}

	/// <summary>
	/// Commit the previewed player as the active command target ("Actions for this player"), close the
	/// profile, and land on the action grid. Off-roster (typed) ids are flagged manual so the
	/// roster-presence auto-clear leaves them alone.
	/// </summary>
	private void ConfirmTarget( long steamId )
	{
		if ( steamId == 0 || MoneyGrantNavigationLocked() )
		{
			return;
		}

		ResetPocketModal();
		ResetInventoryModal();
		_selectedSteamId = steamId;
		_manualSteamId = _players.All( p => p.SteamId != steamId ) ? steamId : null;
		_showProfile = false;
		_profileSteamId = null;
		CancelArgs();
	}

	// Profile stat shortcuts use the catalog target policy, including eligible self targets.
	private StaffAction? GetProfileStatAction( string actionKey, long steamId )
	{
		var action = StaffMenuActions.All.FirstOrDefault( x => x.Key == actionKey );
		var target = _players.FirstOrDefault( p => p.SteamId == steamId );
		return action is not null && !MoneyGrantNavigationLocked()
		       && StaffMenuHost.CanView( action.PermissionId )
		       && IsEnabled( action, target, target.SteamId != 0 )
			? action
			: null;
	}

	// A money shortcut presets the Give Money destination. _destination is sticky across forms
	// (BeginArgs never resets it; SetDestination is its only writer), so the preset is applied
	// explicitly once the form is open instead of trusting the default.
	private void OpenProfileStat( string actionKey, long steamId, string? destination = null )
	{
		// Recheck the catalog, permission and current roster policy at the click boundary.
		var action = GetProfileStatAction( actionKey, steamId );
		if ( action is null )
		{
			return;
		}

		ConfirmTarget( steamId );
		_activeTab = action.Category;
		BeginArgs( action );

		if ( destination is not null && _pendingAction == action )
		{
			SetDestination( destination );
		}
	}

	// A profile shortcut must commit its subject before opening the named form.
	private void OpenProfileAction( StaffAction action, long steamId, bool enabled )
	{
		if ( !enabled || steamId == 0 || steamId == StaffMenuHost.LocalSteamId || MoneyGrantNavigationLocked() )
		{
			return;
		}

		ConfirmTarget( steamId );
		_activeTab = action.Category;
		BeginArgs( action );
	}

