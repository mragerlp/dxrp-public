	// The console uses one fixed XL layout.
	private const LifePunchUiScaleSize FrozenUiScale = LifePunchUiScaleSize.ExtraLarge;

	// Appearance uses one session-static applied color and one instance-local draft.
	private const string DefaultAccentHex = "#1689ff";
	private static Color ParseAccentHex( string hex ) => Color.Parse( hex ) ?? Color.White;
	private static readonly Color DefaultAccentColor = ParseAccentHex( DefaultAccentHex );
	private static Color _appliedAccentColor = DefaultAccentColor;
	private static Color OpaqueAccent( Color color ) => color.WithAlpha( 1f );
	private static bool IsDefaultAccent( Color color ) => OpaqueAccent( color ) == DefaultAccentColor;

	// Holder + SerializedObject binding: the ColorHolder / EnsureColorBinding shape from PartyMenu.razor.
	private sealed class AccentHolder
	{
		public Color Color { get; set; } = Color.White;
	}

	// Only applied ULX accents enter this session history; dragging does not flood it.
	private static readonly List<Color> _recentAccentColors = new() { DefaultAccentColor };
	private readonly AccentHolder _accentHolder = new();
	private SerializedObject? _accentObject;
	private SerializedProperty? _accentProperty;
	private Color _lastObservedAccent = DefaultAccentColor;
	private bool _normalizingAccent;
	private bool _accentDirty;
	private string _accentHexInput = DefaultAccentHex;
	private bool _accentHexInvalid;
	private string _copiedAppliedAccentHex = "";
	private string _copiedSelectedAccentHex = "";
	private int _appliedAccentCopyGeneration;
	private int _selectedAccentCopyGeneration;

	private string AccentHexInput
	{
		get => _accentHexInput;
		set
		{
			// Keep the user's text intact while typing; a six-digit hex passes through three digits.
			_accentHexInput = value ?? "";
			_accentHexInvalid = !TryNormalizeAccentHex( _accentHexInput, out var normalized );
			if ( !_accentHexInvalid )
			{
				var parsed = Color.Parse( normalized );
				if ( parsed.HasValue )
				{
					_accentHolder.Color = OpaqueAccent( parsed.Value );
					_lastObservedAccent = _accentHolder.Color;
					_accentDirty = _accentHolder.Color != _appliedAccentColor;
				}
				else
				{
					_accentHexInvalid = true;
				}
			}

			StateHasChanged();
		}
	}

	private static bool TryNormalizeAccentHex( string input, out string normalized )
	{
		normalized = "";
		var digits = (input ?? "").Trim();
		if ( digits.StartsWith( "#", StringComparison.Ordinal ) )
		{
			digits = digits.Substring( 1 );
		}

		if ( digits.Length != 3 && digits.Length != 6 )
		{
			return false;
		}

		foreach ( var digit in digits )
		{
			if ( !(digit >= '0' && digit <= '9') && !(digit >= 'a' && digit <= 'f') && !(digit >= 'A' && digit <= 'F') )
			{
				return false;
			}
		}

		if ( digits.Length == 3 )
		{
			digits = $"{digits[0]}{digits[0]}{digits[1]}{digits[1]}{digits[2]}{digits[2]}";
		}

		normalized = "#" + digits.ToUpperInvariant();
		return true;
	}

	private bool CanApplyAccent() => _accentDirty && !_accentHexInvalid;

	private bool CanCancelAccent() => _accentDirty || _accentHexInvalid
		|| !string.Equals( _accentHexInput, AppliedAccentCopyHex(), StringComparison.OrdinalIgnoreCase );

	private SerializedProperty? AccentProperty
	{
		get
		{
			EnsureAccentBinding();
			return _accentProperty;
		}
	}

	private void EnsureAccentBinding()
	{
		if ( _accentObject is not null )
		{
			return;
		}

		SyncAccentDraft();
		_accentObject = TypeLibrary.GetSerializedObject( _accentHolder );
		_accentObject.OnPropertyChanged += _ => SenseAccentPicker();
		_accentObject.TryGetProperty( nameof( AccentHolder.Color ), out _accentProperty );
	}

	// Native picker writes arrive through SerializedObject.OnPropertyChanged. Alpha is deliberately
	// ignored: ULX exposes one opaque accent, never a transparency control.
	private void SenseAccentPicker()
	{
		if ( _accentObject is null || _normalizingAccent )
		{
			return;
		}

		var selected = OpaqueAccent( _accentHolder.Color );
		if ( _accentHolder.Color != selected )
		{
			_normalizingAccent = true;
			_accentHolder.Color = selected;
			_normalizingAccent = false;
		}

		_accentHexInput = "#" + selected.Hex.TrimStart( '#' );
		_accentHexInvalid = false;

		if ( selected == _lastObservedAccent )
		{
			return;
		}

		_lastObservedAccent = selected;
		_accentDirty = selected != _appliedAccentColor;
	}

	/// <summary>
	/// Reset the draft to the applied accent on Settings entry and Cancel.
	/// </summary>
	private void SyncAccentDraft()
	{
		_accentHolder.Color = OpaqueAccent( _appliedAccentColor );
		_lastObservedAccent = _accentHolder.Color;
		_accentDirty = false;
		_accentHexInput = AppliedAccentCopyHex();
		_accentHexInvalid = false;
	}

	private string AccentDraftHex() => OpaqueAccent( _accentHolder.Color ).Hex;

	private string AccentDraftLabel() => IsDefaultAccent( _accentHolder.Color )
		? "Blue (default)"
		: AccentDraftHex();

	private static string AppliedAccentHex() => OpaqueAccent( _appliedAccentColor ).Hex;

	// Theme only decorative chrome. Explicit values also restore the default on Reset.
	private static string AppliedGlyphStyle() => $"color: {AppliedAccentHex()};";

