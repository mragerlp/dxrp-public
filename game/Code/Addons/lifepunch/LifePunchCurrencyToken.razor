@namespace LifePunch.DXRP.Addons
@using System
@using Sandbox.UI
@inherits Panel
@attribute [StyleSheet]

<root class="lp-currency-token @TokenClass">
	<span class="@SignClass">@Sign</span>
	<span class="lp-money-amt">@Amount</span>
	@if ( !string.IsNullOrWhiteSpace( Label ) )
	{
		<span class="lp-money-unit lp-currency-label">@Label</span>
	}
</root>

@code {
	public string Sign { get; set; } = string.Empty;
	public string Amount { get; set; } = string.Empty;
	public string Label { get; set; } = string.Empty;
	public string SignClass { get; set; } = "lp-money-btc";
	public string TokenClass { get; set; } = string.Empty;

	protected override int BuildHash()
		=> HashCode.Combine( Sign, Amount, Label, SignClass, TokenClass );
}
