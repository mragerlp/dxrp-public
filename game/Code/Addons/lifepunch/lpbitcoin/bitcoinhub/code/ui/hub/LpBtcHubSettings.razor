   Bitcoin Hub UI skeleton - Settings tab (spec 6.1 row Settings; keep list K19-K23).
   Hub power is a read-only mirror (R-BTCUI-5) pointing at the Player Hub BTC tab, which can switch it
   today. Change PIN, the terminal link toggle and Clear notifications are inert. The recipe names only
   places that work today (BH-SHOWCASE-1).
   UNVERIFIED in the editor.
   ----------------------------------------------------------------------------- *@
@namespace LifePunch.DXRP.Addons.Bitcoin.HubUi
@using System
@using Sandbox
@using Sandbox.UI
@inherits Panel

@attribute [StyleSheet]

<root class="btchub-tab">
	<div class="lp-hub-panel">
		<div class="lp-hub-bar">
			<div class="btchub-panel-title">Settings</div>
		</div>
		<div class="btchub-row">
			<div class="btchub-value">
				<span>Hub power</span>
				<span class="btchub-label">Switch it from the BTC tab of your Player Hub</span>
			</div>
			<span class="@( Model.IsPowered ? "btchub-chip-good" : "btchub-chip" )">@( Model.IsPowered ? "ON" : "OFF" )</span>
		</div>
		<div class="btchub-row">
			<div class="btchub-value">
				<span>Hub PIN</span>
				<span class="btchub-label">@( Model.PinSet ? "Set" : "Not set" )</span>
			</div>
			<button class="btchub-action-inert" tooltip="@( LpBtcHubCommandSpy.Reason( "pin" ) )" onclick="@( () => OnBlocked?.Invoke( "pin" ) )">
				<i class="material-icons inert-lock">lock</i>
				<span>@( Model.PinSet ? "Change PIN" : "Set PIN" )</span>
			</button>
		</div>
		<div class="btchub-row">
			<div class="btchub-value">
				<span>Terminal link</span>
				<span class="btchub-label">@( Model.TerminalLinked ? "Linked" : "Not linked" )</span>
			</div>
			<button class="btchub-action-inert" tooltip="@( LpBtcHubCommandSpy.Reason( LinkAction ) )" onclick="@( () => OnBlocked?.Invoke( LinkAction ) )">
				<i class="material-icons inert-lock">lock</i>
				<span>@( Model.TerminalLinked ? "Unlink" : "Link" )</span>
			</button>
		</div>
		<div class="btchub-row">
			<div class="btchub-value">
				<span>Notifications</span>
				<span class="btchub-label">@NotificationText</span>
			</div>
			<button class="btchub-action-inert" tooltip="@( LpBtcHubCommandSpy.Reason( "clearalerts" ) )" onclick="@( () => OnBlocked?.Invoke( "clearalerts" ) )">
				<i class="material-icons inert-lock">lock</i>
				<span>Clear</span>
			</button>
		</div>
		<div class="btchub-row">
			<div class="btchub-value">
				<span>Hub id</span>
				<span class="btchub-label">The same hub always shows the same id</span>
			</div>
			<span class="btchub-value">@HubIdText</span>
		</div>
	</div>

	<div class="lp-hub-panel">
		<div class="lp-hub-bar">
			<div class="btchub-panel-title">Getting started</div>
		</div>
		<div class="btchub-hint">@Recipe</div>
	</div>
</root>

@code
{
	[Property] public ILpBitcoinHubState Model { get; set; } = null!;
	[Property] public ILpBitcoinHubFormat Format { get; set; } = null!;

	// BH-SHOWCASE-1: every step names a place that works today (terminal link switch: ui/LpHashdPanel.razor:906;
	// terminal verbs: bitcoinmining/LpBitcoinTerminalCommands.cs:37-144; Player Hub BTC tab: LpPlayerHubBtcSource.cs:102-143).
	private const string Recipe =
		"Power the hub from the BTC tab of your Player Hub. Link a nearby HASHD terminal with the Bitcoin terminal " +
		"switch in Settings on the classic hub screen. At the terminal, type link with a rack id for each GPU rack, " +
		"mining start all to start them, and deposit all to move rack BTC into the hub wallet. Cash out from the " +
		"BTC tab of your Player Hub. Buttons with a lock are not wired in this view yet.";

	private string NotificationText => Model.Alerts.Count == 1 ? "1 entry" : Model.Alerts.Count + " entries";

	/// <summary>BH-SHOWCASE-1: an inert control was pressed; the shell counts it and shows the reason.</summary>
	public Action<string>? OnBlocked { get; set; }

	private string LinkAction => Model.TerminalLinked ? "unlink" : "link";

	// Stable hub identity: the first 8 hex digits of the hub's id, upper case.
	private string HubIdText => Model.HasHub ? Model.HubId.ToString( "N" ).Substring( 0, 8 ).ToUpperInvariant() : "-";

	protected override int BuildHash() => HashCode.Combine( Model?.StateHash ?? 0 );
}
