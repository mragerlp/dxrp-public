	// LAW 17 in logs AND helper strings: sign gets its own colored span; digits get
	// .lp-money-amt (white); labels/units stay plainCls (default .lp-money-unit for logs;
	// pass "" at sites whose prose must inherit the parent's own text style). Never pack
	// sign+digits in one colored segment. Codex 0051 manifest sites render through this.
	private static System.Collections.Generic.List<(string Text, string Cls)> AlertMessageSegments( string msg, string plainCls = "lp-money-unit" )
	{
		var segs = new System.Collections.Generic.List<(string, string)>();
		if ( string.IsNullOrEmpty( msg ) )
			return segs;

		var buf = new System.Text.StringBuilder();
		void FlushPlain()
		{
			if ( buf.Length > 0 )
			{
				segs.Add( (buf.ToString(), plainCls) );
				buf.Clear();
			}
		}

		var i = 0;
		while ( i < msg.Length )
		{
			var c = msg[i];
			if ( c == '$' || c == '\u20BF' )
			{
				FlushPlain();
				var signCls = c == '$' ? "lp-money-cash" : "lp-money-btc";
				segs.Add( (c.ToString(), signCls) );
				var j = i + 1;
				if ( j < msg.Length && msg[j] == ' ' )
					j++;

				var amtStart = j;
				while ( j < msg.Length && (char.IsDigit( msg[j] ) || msg[j] == '.' || msg[j] == ',') )
					j++;

				if ( j > amtStart )
					segs.Add( (msg.Substring( amtStart, j - amtStart ), "lp-money-amt") );

				i = j;
				continue;
			}

			if ( char.IsDigit( c ) )
			{
				var j = i;
				while ( j < msg.Length && (char.IsDigit( msg[j] ) || msg[j] == '.' || msg[j] == ',') )
					j++;

				if ( j + 4 <= msg.Length && msg.Substring( j, 4 ) == " BTC" )
				{
					FlushPlain();
					segs.Add( ("\u20BF", "lp-money-btc") );
					segs.Add( (msg.Substring( i, j - i ), "lp-money-amt") );
					i = j + 4;
					continue;
				}
			}

			buf.Append( c );
			i++;
		}

		FlushPlain();
		return segs;
	}

