	/// success/rejection from these. Envelope-driven only -- the panel never advances a tier
	/// optimistically. code: 0=Ok - 1=InsufficientFunds - 2=PreconditionTier - 3=HubGuard.</summary>
	public void OnPurchaseResult( int code, int newTier, long costSats, float newClockGhz, float newBufferCap, long shortfallSats )
	{
		_purchasePendingRackId = Guid.Empty;
		_purchaseResultCode = code;
