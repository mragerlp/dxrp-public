	private readonly record struct OverviewMinerSlot( string DisplayLabel, string TerminalToken, LpBitcoinRackEntity Rack );

	/// <summary>Fixed rig0 slots (2x GPU + 1x Advanced) -- Overview + Servers.</summary>
	private IReadOnlyList<OverviewMinerSlot> GetServersRackSlots()
	{
		var racks = GetLinkedRacks();
		LpBitcoinRackEntity standard1 = null;
		LpBitcoinRackEntity standard2 = null;
		LpBitcoinRackEntity advanced = null;
		var standardCount = 0;

		foreach ( var rack in racks )
		{
			if ( !rack.IsValid() )
				continue;

			if ( rack.AdvancedRack )
			{
				advanced = rack;
				continue;
			}

			if ( standardCount == 0 )
			{
				standard1 = rack;
				standardCount++;
				continue;
			}

			if ( standardCount == 1 )
			{
				standard2 = rack;
				standardCount++;
			}
		}

		return new OverviewMinerSlot[]
		{
			new( "GPU Rack 1", "gpurack-1", standard1 ),
			new( "GPU Rack 2", "gpurack-2", standard2 ),
			new( LpBitcoinIdent.AdvancedRackDisplayName, LpBitcoinIdent.AdvancedRackTerminalToken, advanced )
		};
	}

	// Servers low-clutter nav: home grid (one box per slot) -> drill into one server's detail -> back.
	private OverviewMinerSlot? GetServerDetailSlot()
	{
		if ( string.IsNullOrEmpty( _serverDetailToken ) )
			return null;

		foreach ( var slot in GetServersRackSlots() )
		{
			if ( slot.TerminalToken == _serverDetailToken )
				return slot;
		}

		return null;
	}

