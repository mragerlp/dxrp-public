	// Receipt is a re-derived ledger projection: quotes are deterministic per rack class,
	// so SUM(QuoteSats 1..tier) equals the ledger's SUM(costSats) -- gate-3 asserts it to
	// the sat. Client-derived; MUST become host-synced if pricing ever goes dynamic (R3).
	// Amount only — call sites emit ₿ + .lp-money-amt (Law 17).
	private static string HeroInvestedReceipt( LpBitcoinRackEntity rack )
	{
		long sats = 0;
		for ( var t = 1; t <= rack.ComputeTier; t++ )
			sats += LpBitcoinComputeTrack.QuoteSats( rack, t );

		return $"{sats / 100_000_000f:0.##}";
	}

