@* ─────────────────────────────────────────────────────────────────────────────
   PROPRIETARY & CONFIDENTIAL — © 2026 lifepunch.co. All rights reserved.
   "LIFEPUNCH Bitcoin Miner for DXRP" (s&box ident: lifepunch.bitcoin · addon ident: bitcoinmining)
   ───────────────────────────────────────────────────────────────────────────── *@
@namespace LifePunch.DXRP.Addons.Bitcoin
@using System
@using System.Collections.Generic
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="@GetRootClass()" onmousedown="@OnRootMouseDown">
	@if ( ShowPinGate() )
	{
		<div class="shell">
			<div class="shell-body">
				<div class="pin-gate">
				<header class="pin-header">
					<div class="pin-brand">
						@* BRANDING_SCOPE_RULING_2026-07-15: the LP roundel is OUT of job surfaces.
						   The HASHD mark does not exist yet — the slot stays empty (no mark beats
						   the wrong mark, SIDEBAR DESIGN CANON v1 d). *@
						<div class="pin-brand-copy">
							<div class="pin-title">@PinGateTitle()</div>
							<div class="pin-sub">@PinGateSubtitle()</div>
						</div>
					</div>
					@if ( PinChangeGateMode() )
					{
						<button class="lp-ui-chrome-btn close" tooltip="Cancel" onclick="@CancelPinChangeGate">
							<i class="material-icons">close</i>
						</button>
					}
					else
					{
						<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
							<i class="material-icons">close</i>
						</button>
					}
				</header>

				<div class="pin-body">
					<div class="pin-entry">
						<div class="pin-label">@PinEntryLabel()</div>
						<div class="pin-dots">
							@for ( var i = 0; i < PinTargetLength(); i++ )
							{
								<span class="pin-dot @(i < _pinBuffer.Length ? "filled" : "")"></span>
							}
						</div>
					</div>
					@if ( !string.IsNullOrWhiteSpace( _pinError ) )
					{
						<div class="pin-error">@_pinError</div>
					}

					<div class="pin-pad">
						@foreach ( var key in _pinKeys )
						{
							<button class="pin-key @(key == "ok" ? "ok" : "") @(key == "clr" ? "clr" : "")"
							        onclick="@(() => PressPinKey(key))">
								@if ( key == "clr" )
								{
									<i class="material-icons">backspace</i>
								}
								else if ( key == "ok" )
								{
									<i class="material-icons">check</i>
								}
								else
								{
									<span>@key</span>
								}
							</button>
						}
					</div>
					</div>
				</div>
			</div>
			<div class="lp-window-watermark">
				<LifePunchUiFooter Product="Bitcoin Ops" AccentColor="#e87d3e" />
			</div>
		</div>
		}
		else
		{
			<LpMenuShell Wordmark="@LpBitcoinIdent.OpsTitle"
			             AccentColor="#e87d3e"
			             NavItems="@ShellNavItems()"
			             DoorCards="@ShellDoorCards()"
			             SnapshotStats="@ShellSnapshotStats()"
			             QuickButtons="@ShellQuickButtons()">
				<Mark>
					@* HASHD mark is pending; the operator avatar remains the shipped interim identity. *@
					<div class="sidebar-avatar" title="@GreetingName()">
						@if ( LocalSteamId() > 0 )
						{
							<img class="sidebar-avatar-img" src="avatar:@LocalSteamId()"/>
						}
						else
						{
							<span class="sidebar-avatar-fallback">@AvatarInitial()</span>
						}
					</div>
				</Mark>
				<TopBarControls>
					<button class="header-power-switch @(Hub?.IsPowered == true ? "on" : "off")"
					        tooltip="@(Hub?.IsPowered == true ? "Power off hub" : "Power on hub")"
					        onclick="@ToggleHubPower">
						<span class="power-switch-track"><span class="power-switch-knob"></span></span>
						<span class="power-switch-label">@HubPowerStateLabel()</span>
					</button>
					<button class="header-chip wallet-chip" tooltip="BTC Wallet" onclick="@SelectWalletTab">
						<i class="material-icons">account_balance_wallet</i>
						<LifePunchCurrencyToken Sign="₿" Amount="@HeaderWalletBtc()" TokenClass="header-wallet-token" />
					</button>
					<button class="header-chip cashout-all-chip @GetCashOutAllButtonClass()" tooltip="Cash out all hub wallet BTC to bank" onclick="@CashOutAll">
						<i class="material-icons">savings</i>
						<span>@CashOutAllLabel()</span>
					</button>
					<button class="lp-ui-chrome-btn close" tooltip="Close" onclick="@Close">
						<i class="material-icons">close</i>
					</button>
				</TopBarControls>
				<ChildContent>
							@* #6b modal backdrop: full-body scrim, inert-dismiss, while a confirm popup is open. *@
							@if ( _confirmRackId != Guid.Empty )
							{
								<div class="confirm-scrim" onclick="@DismissConfirm"></div>
							}
							<div class="main-panel">
							@if ( _active == OpsTab.Racks )
								{
									var serverDetail = GetServerDetailSlot();
									<div class="pane racks">
										<div class="lp-ui-panel racks-panel">
										@if ( _serversView == ServersView.HubDetail )
										{
											<div class="upgrades-toolbar">
												<button class="lp-ui-btn-ghost upgrades-back-btn" onclick="@BackToServersHome">
													<i class="material-icons">arrow_back</i>
													<span>Servers</span>
												</button>
												<button class="entity-detail-ident">
													<i class="material-icons">dns</i>
													<span class="entity-detail-title">Bitcoin Hub</span>
													<span class="entity-detail-token">hub</span>
												</button>
											</div>
											<div class="racks-scroll">
												<div class="rack-grid">
													<div class="rack-card entity-detail">
														<div class="entity-chip-row">
															<span class="entity-chip @( Hub?.IsPowered == true ? "gold" : "red" )">@( Hub?.IsPowered == true ? "POWERED" : "OFF" )</span>
															<span class="entity-chip @( Hub.IsValid() && Hub.Owner != 0 ? "green" : "red" )">@( Hub.IsValid() && Hub.Owner != 0 ? "CLAIMED" : "UNCLAIMED" )</span>
															<span class="entity-chip @HubRacksChipState()">@HubRacksChipLabel()</span>
														</div>
														<div class="server-stat-plate">
															<div class="server-stat-row"><span class="server-stat-label">Wallet</span><span class="server-stat-value"><span class="lp-money-btc">₿</span> <span class="lp-money-amt">@HubWalletVital()</span></span></div>
															<div class="server-stat-row"><span class="server-stat-label">Racks</span><span class="server-stat-value">@HubRacksLinkedVital()</span></div>
															<div class="server-stat-row"><span class="server-stat-label">Power</span><span class="server-stat-value">@( Hub?.IsPowered == true ? "Online" : "Offline" )</span></div>
														</div>
														@{ var hubTracks = HubUpgradeTracks.Append( HubSoundPackCosmetic ).ToList(); }
														<div class="entity-tier-progress transact">
															@foreach ( var track in hubTracks )
															{
																var cosmetic = track.Name == HubSoundPackCosmetic.Name;
																<div class="entity-track-row planned">
																	<div class="entity-track-lead">
																		<i class="material-icons unlit">@track.Icon</i>
																		<div class="entity-track-copy">
																			<span class="entity-track-name">@track.Name</span>
																			<span class="entity-track-why">@TrackWhyLine( track.Name )</span>
																		</div>
																	</div>
																	<div class="lp-stepper centered">
																		@for ( int _tier = 1; _tier <= 5; _tier++ )
																		{
																			if ( _tier > 1 )
																			{
																				<div class="lp-stepper-link dark"></div>
																			}
																			<div class="lp-stepper-cell @( _tier == 5 ? "locked max" : "locked" )" tooltip="@( cosmetic ? $"{track.Name} — cosmetic, NOT ENABLED" : $"{track.Name} — PLANNED, no effects yet" )">
																				<span>@TierRoman( _tier )</span>
																			</div>
																		}
																	</div>
																	<span class="entity-track-planned">@( cosmetic ? "NOT ENABLED" : "PLANNED" )</span>
																</div>
															}
														</div>
													</div>
												</div>
											</div>
										}
										else if ( _serversView == ServersView.TerminalDetail )
										{
											@* Terminal tenant #2 — its OWN adapter. It never borrows the Hub's page:
											   own chips, own vitals, own tracks. All-PLANNED is a true state. *@
											<div class="upgrades-toolbar">
												<button class="lp-ui-btn-ghost upgrades-back-btn" onclick="@BackToServersHome">
													<i class="material-icons">arrow_back</i>
													<span>Servers</span>
												</button>
												<button class="entity-detail-ident">
													<i class="material-icons">dvr</i>
													<span class="entity-detail-title">Terminal</span>
													<span class="entity-detail-token">terminal</span>
												</button>
											</div>
											<div class="racks-scroll">
												<div class="rack-grid">
													<div class="rack-card entity-detail">
														<div class="entity-chip-row">
															<span class="entity-chip @( HasLinkedTerminal() ? "green" : "red" )">@( HasLinkedTerminal() ? "LINKED" : "UNLINKED" )</span>
															<span class="entity-chip @( TerminalOnline() ? "gold" : "red" )">@( TerminalOnline() ? "ONLINE" : "OFFLINE" )</span>
															<span class="entity-chip @( TerminalSecured() ? "green" : "red" )">@( TerminalSecured() ? "SECURED" : "OPEN" )</span>
														</div>
														<div class="server-stat-plate">
															<div class="server-stat-row"><span class="server-stat-label">Link</span><span class="server-stat-value">@TerminalLinkVital()</span></div>
															<div class="server-stat-row"><span class="server-stat-label">Access</span><span class="server-stat-value">@TerminalAccessVital()</span></div>
															<div class="server-stat-row"><span class="server-stat-label">Power</span><span class="server-stat-value">@TerminalPowerVital()</span></div>
														</div>
														@{ var terminalTracks = TerminalUpgradeTracks.Append( TerminalSkinCosmetic ).ToList(); }
														<div class="entity-tier-progress transact">
															@foreach ( var track in terminalTracks )
															{
																var cosmetic = track.Name == TerminalSkinCosmetic.Name;
																<div class="entity-track-row planned">
																	<div class="entity-track-lead">
																		<i class="material-icons unlit">@track.Icon</i>
																		<div class="entity-track-copy">
																			<span class="entity-track-name">@track.Name</span>
																			<span class="entity-track-why">@TrackWhyLine( track.Name )</span>
																		</div>
																	</div>
																	<div class="lp-stepper centered">
																		@for ( int _tier = 1; _tier <= 5; _tier++ )
																		{
																			if ( _tier > 1 )
																			{
																				<div class="lp-stepper-link dark"></div>
																			}
																			<div class="lp-stepper-cell @( _tier == 5 ? "locked max" : "locked" )" tooltip="@( cosmetic ? $"{track.Name} — cosmetic, NOT ENABLED" : $"{track.Name} — PLANNED, no effects yet" )">
																				<span>@TierRoman( _tier )</span>
																			</div>
																		}
																	</div>
																	<span class="entity-track-planned">@( cosmetic ? "NOT ENABLED" : "PLANNED" )</span>
																</div>
															}
														</div>
													</div>
												</div>
											</div>
										}
										else if ( _serversView == ServersView.RackChooser )
										{
											@* GPU RACKS category → the 3-rack chooser. Row content is preserved
											   exactly as it stood on the old Servers home. *@
											<div class="upgrades-toolbar">
												<button class="lp-ui-btn-ghost upgrades-back-btn" onclick="@BackToServersHome">
													<i class="material-icons">arrow_back</i>
													<span>Servers</span>
												</button>
												<button class="entity-detail-ident">
													<i class="material-icons">memory</i>
													<span class="entity-detail-title">GPU Racks</span>
													<span class="entity-detail-token">gpuracks</span>
												</button>
											</div>

											<div class="lp-ui-intro racks-intro">Pick a rack for status and upgrades.</div>

											<div class="racks-scroll">
												<div class="upgrade-home-grid servers-home-grid">
													@foreach ( var slot in GetServersRackSlots() )
													{
														<button class="upgrade-home-box server-home-box @( slot.Rack.IsValid() ? "" : "empty" )" onclick="@(() => EnterServerDetail( slot ))">
															<i class="material-icons upgrade-home-box-icon">@ServerSlotIcon( slot )</i>
															<div class="upgrade-home-box-body">
																<span class="upgrade-home-box-title">@slot.DisplayLabel</span>
																<div class="entity-chip-row">
																	@if ( slot.Rack.IsValid() )
																	{
																		<span class="entity-chip green">LINKED</span>
																		<span class="entity-chip @( slot.Rack.IsMining ? "gold" : "" )">@( slot.Rack.IsMining ? "MINING" : "IDLE" )</span>
																		@if ( slot.Rack.BitcoinAmount >= LpBitcoinEconomy.RackBtcCapacityFor( slot.Rack ) )
																		{
																			<span class="entity-chip red">FULL</span>
																		}
																	}
																	else
																	{
																		<span class="entity-chip red">@( HasAnyPlayerRacksNearbyOrLinked() ? "UNLINKED" : "AVAILABLE" )</span>
																	}
																</div>
																@* #1a: status carried by the chip row above — redundant text dropped. *@
																@* LAW 17 (0051 sites 1+2): ₿ sign colored, digits white, prose inherits. *@
																<span class="upgrade-home-box-desc">
																	@foreach ( var _seg in AlertMessageSegments( ServerSlotHomeDesc( slot ), "" ) )
																	{
																		<span class="@_seg.Cls">@_seg.Text</span>
																	}
																</span>
															</div>
															<div class="upgrade-home-box-foot">
																<span class="upgrade-home-box-meta">
																	@foreach ( var _seg in AlertMessageSegments( ServerSlotHomeMeta( slot ), "" ) )
																	{
																		<span class="@_seg.Cls">@_seg.Text</span>
																	}
																</span>
																<i class="material-icons upgrade-home-box-chevron">chevron_right</i>
															</div>
														</button>
													}
												</div>
											</div>
										}
										else if ( _serversView == ServersView.RackDetail && serverDetail is not null )
										{
											var slot = serverDetail.Value;
											<div class="upgrades-toolbar">
												<button class="lp-ui-btn-ghost upgrades-back-btn" onclick="@BackToRackChooser">
													<i class="material-icons">arrow_back</i>
													<span>GPU Racks</span>
												</button>
												@* Header consolidation: title + click-to-copy ident are ONE element
												   (copy flash, no separate COPY chip). *@
												<button class="entity-detail-ident" onclick="@(() => CopyOverviewMinerToken( slot ))">
													<i class="material-icons">@ServerSlotIcon( slot )</i>
													<span class="entity-detail-title">@slot.DisplayLabel</span>
													<span class="entity-detail-token">@slot.TerminalToken</span>
													<i class="material-icons entity-detail-copyicon">@( _overviewSlotCopyAck == slot.TerminalToken ? "check" : "content_copy" )</i>
													@if ( _overviewSlotCopyAck == slot.TerminalToken )
													{
														<span class="entity-detail-copyflash">Copied</span>
													}
												</button>
											</div>

											<div class="racks-scroll">
												<div class="rack-grid">
														<div class="rack-card entity-detail @( slot.Rack.IsValid() ? "" : "empty" )">
															@* Chip row — Law-13 states (Hashing dedupes into MINING). Identity + copy
															   live in the toolbar ident; the STATUS stat-row is retired. *@
															<div class="entity-chip-row">
																@if ( slot.Rack.IsValid() )
																{
																	<span class="entity-chip green">LINKED</span>
																	<span class="entity-chip @( slot.Rack.IsMining ? "gold" : "" )">@( slot.Rack.IsMining ? "MINING" : "IDLE" )</span>
																	@if ( slot.Rack.BitcoinAmount >= LpBitcoinEconomy.RackBtcCapacityFor( slot.Rack ) )
																	{
																		<span class="entity-chip red">FULL</span>
																	}
																	<span class="entity-chip dim">@RackYieldBadge( slot.Rack )</span>
																	<LifePunchCurrencyToken Sign="₿" Amount="@HeroInvestedReceipt( slot.Rack )" Label="invested" TokenClass="entity-invested-token" />
																}
																else
																{
																	<span class="entity-chip red">@( HasAnyPlayerRacksNearbyOrLinked() ? "UNLINKED" : "AVAILABLE" )</span>
																}
															</div>

															@if ( !slot.Rack.IsValid() )
															{
																<div class="rack-card-body">
																	@if ( !HasAnyPlayerRacksNearbyOrLinked() )
																	{
																		<div class="rack-stat-tiles empty">
																			<div class="rack-stat-tile rack-stat-tile-wide">
																				<div class="rack-stat-tile-value empty market-hint">Purchase racks from the Market.</div>
																			</div>
																		</div>
																	}
																	else
																	{
																		<div class="rack-stat-tiles empty">
																			<div class="rack-stat-tile rack-stat-tile-wide">
																				<div class="rack-stat-tile-value empty">Place rack near hub, then link at rig0 on the terminal — <span class="hashd-prompt-accent">link @slot.TerminalToken</span></div>
																			</div>
																		</div>
																	}
																</div>
															}
															else
															{
																@* Vitals — Compute / Rate / Buffer+bar / Yield (Status row retired). *@
																<div class="server-stat-plate">
																	<div class="server-stat-row">
																		<span class="server-stat-label">Compute</span>
																		<span class="server-stat-value">@RackComputeVital( slot.Rack )</span>
																	</div>
																	<div class="server-stat-row">
																		<span class="server-stat-label">Rate</span>
																		<span class="server-stat-value"><span class="lp-money-btc">₿</span> <span class="lp-money-amt">@CardRateLine( slot.Rack, slot.Rack.ComputeTier )</span><span class="lp-money-unit">/min</span></span>
																	</div>
																	<div class="server-stat-row">
																		<span class="server-stat-label">Buffer</span>
																		<span class="server-stat-value server-buffer-value">
																			<LifePunchCurrencyToken Sign="₿" Amount="@HeroBufferAmount( slot.Rack )" TokenClass="server-buffer-current" />
																			<span class="lp-money-unit server-buffer-separator">/</span>
																			<LifePunchCurrencyToken Sign="₿" Amount="@HeroBufferCapacityAmount( slot.Rack )" Label="@HeroBufferPercentLabel( slot.Rack )" TokenClass="server-buffer-capacity" />
																		</span>
																	</div>
																	<div class="server-buffer-bar">
																		<div class="server-buffer-bar-fill" style="width: @( HeroBufferPercent( slot.Rack ) )%;"></div>
																	</div>
																	<div class="server-stat-row">
																		<span class="server-stat-label">Yield</span>
																		<span class="server-stat-value">@RackYieldBadge( slot.Rack )</span>
																	</div>
																</div>

																@* TIER PROGRESS = the transact surface (track-row law). Each row: icon
																   lit≥T1, name+why, centered display tree, price + visible delta subtext,
																   UPGRADE + the anchor-aware chip. PLANNED rows: badge only. *@
																var rackTracks = GpuRackUpgradeTracks.Append( RackFanRgbCosmetic ).ToList();
																<div class="entity-tier-progress transact">
																	@for ( int _row = 0; _row < rackTracks.Count; _row++ )
																	{
																		var track = rackTracks[_row];
																		var rowIndex = _row;
																		var cosmetic = track.Name == RackFanRgbCosmetic.Name;
																		var trackLive = !cosmetic && IsTrackLive( track );
																		var atMax = trackLive && slot.Rack.ComputeTier >= 5;
																		var iconLit = trackLive && slot.Rack.ComputeTier >= 1;

																		<div class="entity-track-row @( (trackLive ? "live" : "planned") + (ConfirmOpenFor( slot.Rack ) ? " confirm-open" : "") )">
																			<div class="entity-track-lead">
																				<i class="material-icons @( iconLit ? "lit" : "unlit" )">@track.Icon</i>
																				<div class="entity-track-copy">
																					<span class="entity-track-name">@track.Name</span>
																					<span class="entity-track-why">@TrackWhyLine( track.Name )</span>
																				</div>
																			</div>
																			<div class="lp-stepper centered">
																				@for ( int _tier = 1; _tier <= 5; _tier++ )
																				{
																					if ( _tier > 1 )
																					{
																						<div class="lp-stepper-link @( trackLive ? StepperLinkClass( slot.Rack, _tier - 1 ) : "dark" )"></div>
																					}
																					<div class="lp-stepper-cell @( trackLive ? StepperCellClass( slot.Rack, _tier ) : ( _tier == 5 ? "locked max" : "locked" ) )"
																					     tooltip="@( trackLive ? StepperTooltip( slot.Rack, _tier ) : ( cosmetic ? $"{track.Name} — cosmetic, NOT ENABLED" : $"{track.Name} — PLANNED, no effects yet" ) )">
																						<span>@TierRoman( _tier )</span>
																					</div>
																				}
																			</div>
																			@if ( trackLive && !atMax )
																			{
																				<div class="entity-track-transact">
																					<div class="entity-track-price"><span class="lp-money-btc">₿</span> <span class="lp-money-amt">@CardCostBtc( slot.Rack )</span><span class="lp-money-divider">|</span><span class="lp-money-cash">$</span><span class="lp-money-amt">@CardCostUsd( slot.Rack )</span></div>
																					<div class="entity-track-delta">@TrackDeltaSubtext( slot.Rack )</div>
																				</div>
																				<div class="entity-track-action">
																					<button class="lp-ui-btn-primary entity-track-upgrade" onclick="@(() => ToggleConfirm( slot.Rack, slot.Rack.ComputeTier + 1 ))">Upgrade</button>
																					@if ( ConfirmOpenFor( slot.Rack ) )
																					{
																						<div class="lp-stepper-chip row-anchored @ChipFlipClass( rowIndex, rackTracks.Count ) @( _purchaseResultCode > 0 && _sincePurchaseResult < 0.5f ? "shake" : "" )">
																							@if ( StepperWorking( slot.Rack ) )
																							{
																								<div class="lp-stepper-chip-row"><span class="lp-stepper-chip-line working">WORKING…</span></div>
																							}
																							else
																							{
																								<div class="lp-stepper-chip-row">
																									<span class="lp-stepper-chip-line"><span>@StepperChipTierLabel( slot.Rack )</span><span class="lp-chip-sep">·</span><span class="lp-money-btc">₿</span> <span class="lp-money-amt">@CardCostBtc( slot.Rack )</span></span>
																									<button class="lp-stepper-chip-yes" tooltip="Confirm purchase" onclick="@(() => ConfirmPurchase( slot.Rack ))"><i class="material-icons">check</i></button>
																									<button class="lp-stepper-chip-no" tooltip="Cancel" onclick="@DismissConfirm"><i class="material-icons">close</i></button>
																								</div>
																								@if ( _purchaseResultCode == 1 )
																								{
																									@* LAW 17 (0051 site 4): .reject reds the word only — sign stays amber, amount white. *@
																									<div class="lp-stepper-chip-row reject"><span>SHORT</span><span class="lp-money-btc">₿</span> <span class="lp-money-amt">@( ( _purchaseResultShortfallSats / 100_000_000f ).ToString( "0.####" ) )</span></div>
																								}
																								else if ( _purchaseResultCode > 1 )
																								{
																									<div class="lp-stepper-chip-row reject">REJECTED · TIER ORDER / HUB ACCESS</div>
																								}
																							}
																						</div>
																					}
																				</div>
																			}
																			else if ( trackLive && atMax )
																			{
																				<span class="entity-track-planned maxed">MAX TIER</span>
																			}
																			else
																			{
																				<span class="entity-track-planned">@( cosmetic ? "NOT ENABLED" : "PLANNED" )</span>
																			}
																		</div>
																	}
																</div>

																<div class="entity-detail-foot">
																	@* invested token moved to the header chip row (batch 4 C). *@
																</div>
															}
														</div>
												</div>
											</div>
										}
