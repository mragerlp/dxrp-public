			return "Verify current PIN, then enter a new 4-digit PIN twice.";

		if ( PinSetupMode() && Hub?.AccessPinNeedsReEnrollment == true )
			return "This update retired the old hub PIN — set a new one. Your hub balance is untouched.";

		return PinSetupMode() ? "Create a 4-digit hub PIN" : "Enter your 4-digit hub PIN";
	}

	private string PinEntryLabel()
	{
		if ( PinChangeGateMode() )
			return PinChangeEntryLabel();

