	private string PartialCashOutButtonLabel()
	{
		if ( _partialCashOutFeedback == WalletCashOutFeedback.Error )
			return _partialCashOutFeedbackText;

		if ( _partialCashOutFeedback == WalletCashOutFeedback.Success )
			return _partialCashOutFeedbackText;

		if ( !TryParseCashOutAmount( out var amount ) || amount <= 0f )
			return "Enter amount";

		// LAW 17 (0051 site 9): the amount carries its ₿ identity; the call site
		// segment-splits so the sign is amber and the digits stay white.
		return $"Cash out \u20BF {amount:F4}";
	}

	private string PartialCashOutUsdPreview()
	{
		if ( !TryParseCashOutAmount( out var amount ) || amount <= 0f )
			return "\u2014";

		return LpBitcoinEconomy.FormatBtcToCash( amount );
	}

	private string CashOutAllLabel()
	{
		if ( _allCashOutFeedback == WalletCashOutFeedback.Error )
			return _allCashOutFeedbackText;

		if ( _allCashOutFeedback == WalletCashOutFeedback.Success )
			return _allCashOutFeedbackText;

		return "Cash out all";
	}

	private string GetPartialCashOutButtonClass()
	{
		if ( _partialCashOutFeedback == WalletCashOutFeedback.Error )
			return "is-error";

		if ( _partialCashOutFeedback == WalletCashOutFeedback.Success )
			return "is-success";

		return CanAttemptPartialCashOut() ? "is-ready" : "disabled";
	}

	private string GetCashOutAllButtonClass()
	{
		if ( _allCashOutFeedback == WalletCashOutFeedback.Error )
			return "is-error";

		if ( _allCashOutFeedback == WalletCashOutFeedback.Success )
			return "is-success";

		return HubWalletBtc() > 0f ? "is-ready" : "disabled";
	}

	private bool CanAttemptPartialCashOut()
	{
		if ( HubWalletBtc() <= 0f )
			return false;

		return TryParseCashOutAmount( out var amount ) && amount > 0f;
	}

	private bool TryParseCashOutAmount( out float amount )
	{
		amount = 0f;
		return float.TryParse( _cashOutAmount.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out amount );
	}

	private void CashOutPartial()
	{
		if ( !TryParseCashOutAmount( out var amount ) || amount <= 0f )
			return;

		if ( amount > HubWalletBtc() )
		{
			ShowPartialCashOutFeedback( WalletCashOutFeedback.Error, "Insufficient funds" );
			return;
		}

		Hub?.RequestCashOutHub( amount );
	}

	private void CashOutAll()
	{
		if ( HubWalletBtc() <= 0f )
		{
			ShowAllCashOutFeedback( WalletCashOutFeedback.Error, "Insufficient funds" );
			return;
		}

		Hub?.RequestCashOutAllHub();
	}

	private string GreetingName()
	{
		var name = Connection.Local?.DisplayName;
		if ( string.IsNullOrWhiteSpace( name ) )
			return "Operator";

		var first = name.Split( ' ', StringSplitOptions.RemoveEmptyEntries ).FirstOrDefault();
		return string.IsNullOrWhiteSpace( first ) ? "Operator" : first;
	}

	private int LinkedRackCount() => GetLinkedRacks().Count;

	private List<LpBitcoinRackEntity> GetLinkedRacks()
		=> Hub.IsValid() ? Hub.GetLinkedRacks().ToList() : new List<LpBitcoinRackEntity>();

	private float TotalBtc() => GetLinkedRacks().Sum( r => r.BitcoinAmount );

	private float CombinedBtc() => HubWalletBtc() + RackPendingBtc();

	private int CombinedUsd() => (int)LpBitcoinEconomy.BtcToCashUsd( CombinedBtc() );

	private int TotalUsd() => GetLinkedRacks().Sum( r => r.UsdValue );

	private int MiningRackCount() => GetLinkedRacks().Count( r => r.IsMining );

	private float TotalMiningRate()
	{
		if ( Hub?.IsPowered != true )
			return 0f;

		return GetLinkedRacks()
			.Where( r => r.IsMining )
			.Sum( r => r.MiningRatePerMinute );
	}

	private int MiningLoadPercent()
	{
		var total = LinkedRackCount();
		if ( total == 0 )
			return 0;

		return (int)Math.Round( 100f * MiningRackCount() / total );
	}

	protected override void OnUpdate()
	{
		base.OnUpdate();
		LifePunchMenuInputBlock.Apply();
		LifePunchUiScrollPolicy.Apply( Panel );

		if ( !_hub.IsValid() )
		{
			Close();
			return;
		}

		TickTransientNotices();
		MaintainLogsScrollAnchor();

		if ( _sinceTelemetryRefresh < TelemetryRefreshInterval )
		{
			TickLogTimeLabels();
			return;
		}

		_sinceTelemetryRefresh = 0;
		var previous = _telemetryHash;
		RecomputeTelemetryHash();
		if ( _telemetryHash != previous )
			StateHasChanged();

		TickLogTimeLabels();
	}

	// Expire the in-button confirmations (PIN updated / Cleared) and re-render only on the
	// active->inactive (or inactive->active) edge -- no per-frame markup thrash.
	private void TickTransientNotices()
	{
		if ( PinJustUpdated() && _sincePinUpdatedNotice >= PinNoticeHoldSeconds )
			_pinChangeNotice = "";

		var pinActive = PinJustUpdated();
		var logsClearedActive = LogsJustCleared();

		if ( pinActive == _pinNoticeWasActive && logsClearedActive == _logsClearedWasActive )
			return;

		_pinNoticeWasActive = pinActive;
		_logsClearedWasActive = logsClearedActive;
		StateHasChanged();
	}

	private void TickLogTimeLabels()
	{
		if ( _active != OpsTab.Logs )
			return;

		if ( _sinceLogTimeRefresh < LogTimeRefreshInterval )
			return;

		_sinceLogTimeRefresh = 0;
		var bucket = (int)(Time.Now / LogTimeRefreshInterval);
		if ( bucket == _logTimeBucket )
			return;

		_logTimeBucket = bucket;

		// Feed rows are razor-owned; a bucket change re-renders so "just now" ages to
		// "Nm ago" (the bucket is also in BuildHash).
		if ( GetHubAlerts().Count > 0 )
			StateHasChanged();
	}

	// Scroll-anchor law for the razor-owned feed: when entries prepend while the user is
	// scrolled down, push ScrollOffset by the new rows' laid-out height so the content
	// under their eyes stays put. Never moves the view in any other case.
	private void MaintainLogsScrollAnchor()
	{
		if ( _active != OpsTab.Logs || !_logsScroll.IsValid() )
		{
			_logsAnchorKey = null;
			return;
		}

		var alerts = GetHubAlerts();
		if ( alerts.Count == 0 )
		{
			_logsAnchorKey = null;
			return;
		}

		var headKey = AlertKey( alerts[0] );
		if ( _logsAnchorKey == headKey )
			return;

		if ( _logsAnchorKey is not null && _logsScroll.ScrollOffset.y > 4f )
		{
			// Prepended-row count = the previous head's index in the new list. Not found
			// (feed cleared or fully rotated past the cap) -> re-key without compensating.
			var prepended = 0;
			for ( var i = 0; i < alerts.Count; i++ )
			{
				if ( AlertKey( alerts[i] ) != _logsAnchorKey )
					continue;

				prepended = i;
				break;
			}

			var list = _logsScroll.GetChild( 0 );
			if ( prepended > 0 && list.IsValid() )
			{
				var added = 0f;
				var index = 0;
				foreach ( var row in list.Children )
				{
					if ( index++ >= prepended )
						break;

					added += row.Box.Rect.Height;
				}

				// New rows render one frame before layout sizes them -- retry next frame.
				if ( added <= 0f )
					return;

				_logsScroll.ScrollOffset += new Vector2( 0f, added * _logsScroll.ScaleFromScreen );
			}
		}

		_logsAnchorKey = headKey;
	}

	private void RecomputeTelemetryHash()
	{
		var hash = new HashCode();
		hash.Add( MiningRackCount() );
		hash.Add( Hub?.IsPowered );
		hash.Add( HasLinkedTerminal() );
		hash.Add( HasNearbyUnlinkedTerminal() );
		hash.Add( Hub?.UnreadAlertCount ?? 0 );
		// Sat resolution, not 4dp: the wallet is rendered at 6dp (wallet/transfers panes) and 8dp
		// (Hub detail vital), so a 4dp hash left sub-0.0001 BTC movement invisible until something
		// else moved the hash. Same shape as the rack-buffer line below. Recompute stays throttled
		// to TelemetryRefreshInterval (0.5s), so this costs at most one redraw per half-second.
		hash.Add( (long)( HubWalletBtc() * 100_000_000f ) );

		var alerts = GetHubAlerts();
		hash.Add( alerts.Count );
		for ( var i = 0; i < alerts.Count && i < 12; i++ )
		{
			hash.Add( alerts[i].Kind );
			hash.Add( alerts[i].Message );
		}

		foreach ( var rack in GetLinkedRacks() )
		{
			hash.Add( rack.GameObject.Id );
			hash.Add( rack.AdvancedRack );
			hash.Add( rack.IsMining );
			hash.Add( rack.ComputeTier );
			// Buffer BTC at sat resolution -- the GPU RACKS aggregate quotes this to the sat,
			// so it has to move the hash or the card renders stale. Recompute is already
			// throttled to TelemetryRefreshInterval, so this costs at most one redraw per 0.5s.
			hash.Add( (long)( rack.BitcoinAmount * 100_000_000f ) );
		}

		if ( Hub.IsValid() )
		{
			hash.Add( HasAnyPlayerRacksNearbyOrLinked() );
		}

		_telemetryHash = hash.ToHashCode();
	}

	protected override int BuildHash()
	{
		// _telemetryHash includes wallet (4dp) + rack structure -- no per-frame display tick.
		// Do not hash TextEntry bind values (_cashOutAmount).
		var hash = new HashCode();
		hash.Add( _active );
		hash.Add( (int)_serversView );
		hash.Add( _serverDetailToken ?? string.Empty );
		hash.Add( HubRackCount() );
		hash.Add( _confirmRackId );
		hash.Add( _transactTrackName ?? string.Empty );
		hash.Add( _receiveCopyAck );
		hash.Add( _sendExampleCopyAck );
		hash.Add( _rackSlotCopyAckId );
		hash.Add( _overviewSlotCopyAck );
		hash.Add( _pinUnlocked );
		hash.Add( _pinBuffer );
		hash.Add( _pinSetupPass );
		hash.Add( _pinError );
		hash.Add( (int)_pinGatePurpose );
		hash.Add( _pinChangePass );
		hash.Add( _pinChangeNotice );
		hash.Add( LogsJustCleared() );
		hash.Add( _hub?.IsPowered );
		hash.Add( _hub?.AccessPinIsSet );
		hash.Add( _hub?.AccessPinNeedsReEnrollment );
		hash.Add( _perfRange );
		hash.Add( _profitRange );
		hash.Add( LinkedRackCount() );
		hash.Add( _telemetryHash );
		hash.Add( Hub?.Owner ?? 0 );
		hash.Add( _cashOutAmount );
		hash.Add( (int)_partialCashOutFeedback );
		hash.Add( _partialCashOutFeedbackText );
		hash.Add( (int)_allCashOutFeedback );
		hash.Add( _allCashOutFeedbackText );
		hash.Add( _purchasePendingRackId );
		hash.Add( _purchaseResultCode );
		hash.Add( _purchaseResultTier );
		hash.Add( LpBitcoinEconomy.PortalBaseCashUsdPerBtc );
		hash.Add( LpBitcoinEconomy.CashUsdPerBtc );
		hash.Add( LpBitcoinEconomy.PortalEconomyRevision );
		hash.Add( Hub?.UnreadAlertCount ?? 0 );
		hash.Add( Hub?.AlertFeed ?? string.Empty );
		hash.Add( _logTimeBucket );
		return hash.ToHashCode();
	}
}
