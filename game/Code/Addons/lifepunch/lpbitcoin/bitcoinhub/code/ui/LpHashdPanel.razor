		_purchaseResultCostSats = costSats;
		_purchaseResultShortfallSats = shortfallSats;
		_sincePurchaseResult = 0;

		// Success closes the popover (the bubble's just-bought motion is the confirmation);
		// failures keep it open as the rejection surface (shortfall/reason + shake).
		if ( code == 0 )
			_confirmRackId = Guid.Empty;
	}

