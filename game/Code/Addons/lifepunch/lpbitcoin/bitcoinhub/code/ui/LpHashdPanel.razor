	// Slice-3 stepper state -- set ONLY by the OnPurchaseResult broadcast (envelope-driven,
	// never optimistic). _purchasePendingRackId is the "working" gate: set when a purchase
	// RPC is fired, cleared when the result lands; if the broadcast never arrives the stepper
	// stays working and never falsely advances (the kill-the-broadcast-mid-test case).
	// resultCode: 0=Ok - 1=InsufficientFunds - 2=PreconditionTier - 3=HubGuard - -1=none.
	private Guid _purchasePendingRackId = Guid.Empty;
	private int _purchaseResultCode = -1;
	private int _purchaseResultTier;
	private long _purchaseResultCostSats;
	private long _purchaseResultShortfallSats;
	private TimeSince _sincePurchaseResult;

	// Stepper interaction (sketch spec): _confirmRackId = which rack's anchored popover is
	// open. The popover doubles as the rejection surface -- a failure envelope re-renders it
	// with the reason instead of the YES/NO body.
	private Guid _confirmRackId = Guid.Empty;

	private static bool IsComputeTrack( UpgradeTrackShell track ) => track.Name == "Compute Profile";

	private bool StepperWorking( LpBitcoinRackEntity rack )
		=> rack.IsValid() && _purchasePendingRackId == rack.GameObject.Id;

	private long StepperNextQuoteSats( LpBitcoinRackEntity rack )
		=> rack.ComputeTier >= 5 ? -1L : LpBitcoinComputeTrack.QuoteSats( rack, rack.ComputeTier + 1 );

	private bool StepperAffordable( LpBitcoinRackEntity rack )
	{
		var quote = StepperNextQuoteSats( rack );
		return quote >= 0 && Hub.IsValid() && Hub.HubWalletBtc >= quote / 100_000_000f;
	}

	// Circuit ruling: owned bubbles + their links are one energized accent segment ending at
	// the owned frontier - purchase frontier is GREY with the click affordance, tint = can
	// afford - beyond is uniform grey inert. Tier V is the square terminal node (MAX).
	private string StepperCellClass( LpBitcoinRackEntity rack, int tier )
	{
		var max = tier == 5 ? " max" : "";

		if ( tier <= rack.ComputeTier )
			return "owned" + max + ( _purchaseResultCode == 0 && _purchaseResultTier == tier && _sincePurchaseResult < 1.2f ? " just-bought" : "" );

		if ( tier == rack.ComputeTier + 1 )
			return "actionable" + max
				+ ( StepperAffordable( rack ) ? " affordable" : " unaffordable" )
				+ ( StepperWorking( rack ) ? " working" : "" );

		return "locked" + max;
	}

	// Wire between bubble N and N+1: lit only inside the owned segment; everything past the
	// owned frontier is grey.
	private string StepperLinkClass( LpBitcoinRackEntity rack, int afterTier )
	{
		return afterTier < rack.ComputeTier ? "solid" : "dark";
	}

	// Tooltip informs, never asks: "COMPUTE II - x4 rate". LAW 17 (0051 site 3): a plain
	// tooltip attribute cannot color a currency sign, so the monetary value is OMITTED
	// here — the price renders Law-17-split in the styled .entity-track-price element.
	private string StepperTooltip( LpBitcoinRackEntity rack, int tier )
	{
		if ( tier > rack.ComputeTier + 1 )
			return $"Requires Tier {TierRoman( tier - 1 )}";

		if ( tier <= rack.ComputeTier )
			return $"COMPUTE {TierRoman( tier )} \u00B7 \u00D7{LpBitcoinComputeTrack.EffectMultiplierFor( tier )} rate \u00B7 owned";

		return $"COMPUTE {TierRoman( tier )} \u00B7 \u00D7{LpBitcoinComputeTrack.EffectMultiplierFor( tier )} rate \u00B7 see price below";
	}

	// Row's right status slot per sketch 4: PLANNED (future tracks) -> next-price or blank
	// (active track) -> MAX TIER (ladder complete). Cosmetics keep NOT ENABLED.
	private string TrackRowStatus( UpgradeTrackShell track, bool cosmetic, LpBitcoinRackEntity rack )
	{
		if ( cosmetic ) return "NOT ENABLED";
		if ( !IsComputeTrack( track ) || !rack.IsValid() ) return "PLANNED";
		if ( rack.ComputeTier >= 5 ) return "MAX TIER";

		var quote = StepperNextQuoteSats( rack );
		return quote >= 0 ? $"\u20BF {quote / 100_000_000f:0.##}" : "";
	}

	// Row tier sub-label: real tier for the live Compute track, static baseline for planned rows.
	private string RowTierLabel( UpgradeTrackShell track, LpBitcoinRackEntity rack )
	{
		if ( IsComputeTrack( track ) && rack.IsValid() )
			return rack.ComputeTier == 0
				? $"Tier \u2014 \u00B7 Stock Clocks"
				: $"Tier {TierRoman( rack.ComputeTier )} \u00B7 \u00D7{LpBitcoinComputeTrack.EffectMultiplierFor( rack.ComputeTier )} rate";

		return CurrentTierLabel( track );
	}

	private bool ConfirmOpenFor( LpBitcoinRackEntity rack )
		=> rack.IsValid() && _confirmRackId == rack.GameObject.Id;

	private void ToggleConfirm( LpBitcoinRackEntity rack, int tier )
	{
		// Only the actionable bubble opens the popover; owned/locked cells are inert clicks.
		if ( !rack.IsValid() || tier != rack.ComputeTier + 1 || tier > 5 || StepperWorking( rack ) )
			return;

		_confirmRackId = ConfirmOpenFor( rack ) ? Guid.Empty : rack.GameObject.Id;
		_purchaseResultCode = -1;
	}

	private void DismissConfirm()
	{
		_confirmRackId = Guid.Empty;
		_purchaseResultCode = -1;
	}

	// Transact view (blocker-a): UPGRADE on a row hands the page to that track's
	// purchase card; Back returns to the row list. One track, one card, one page.
	private string _transactTrackName;

	private void OpenTransact( string trackName )
	{
		_transactTrackName = trackName;
		DismissConfirm();
	}

	private void CloseTransact()
	{
		_transactTrackName = null;
		DismissConfirm();
	}

	private void ConfirmPurchase( LpBitcoinRackEntity rack )
	{
		if ( !rack.IsValid() || StepperWorking( rack ) )
			return;

		_purchasePendingRackId = rack.GameObject.Id;
		_purchaseResultCode = -1;
		rack.RequestPurchaseComputeTier();
	}

	// -- Rack-detail hero (hierarchy inversion): per-track delta cards --
	// Cards bind to the track registry; live tracks render real data (Compute today),
	// the grid grows per track registration with zero card code.

	private static bool IsTrackLive( UpgradeTrackShell track ) => IsComputeTrack( track );

	private static float ProjectedClockGhz( int tier )
		=> LpBitcoinEconomy.StartClockGhz * LpBitcoinComputeTrack.EffectMultiplierFor( tier );

	private static string CardGhz( int tier )
		=> $"{ProjectedClockGhz( tier ):F2} GHz";

	// Separator Law: the "TIER n - GHz" composite is assembled here and interpolated as ONE
	// node. Written in markup it would put a bare " - " text node between two @-expressions.
	private static string RackComputeVital( LpBitcoinRackEntity rack )
	{
		var tier = rack.ComputeTier;
		var head = tier > 0 ? $"TIER {TierRoman( tier )}" : "STOCK";
		return $"{head} \u00B7 {CardGhz( tier )}";
	}

	// Confirm chip: the tier half is one node; the money halves keep their own colour spans
	// (Law 13), so the separator between them is a discrete element, never a bare literal.
	private static string StepperChipTierLabel( LpBitcoinRackEntity rack )
		=> $"TIER {TierRoman( rack.ComputeTier + 1 )}";

	// BTC/min at a given tier -- while-hashing implicit (delta ruling). Same Apply-math
	// the host uses, so the gate can assert card values against QuoteSats/reconcile.
	private static float CardRatePerMin( LpBitcoinRackEntity rack, int tier )
		=> LpBitcoinEconomy.MiningRatePerMinute( ProjectedClockGhz( tier ), rack.CoreCount, rack.YieldMultiplier );

	// Amount only — call sites emit ₿ + .lp-money-amt (Law 17).
	private static string CardRateLine( LpBitcoinRackEntity rack, int tier )
		=> $"{CardRatePerMin( rack, tier ):0.####}";

	private static float CardDeltaPerMin( LpBitcoinRackEntity rack )
		=> CardRatePerMin( rack, rack.ComputeTier + 1 ) - CardRatePerMin( rack, rack.ComputeTier );

	private static string CardDeltaLine( LpBitcoinRackEntity rack )
		=> $"+{CardDeltaPerMin( rack ):0.####} BTC/min";

	// Advanced parity is structural: yield scales quote and delta alike, so payback is
	// identical to same-tier standard -- gate asserts it to the minute.
	private string CardPaybackLine( LpBitcoinRackEntity rack )
	{
		var quoteBtc = StepperNextQuoteSats( rack ) / 100_000_000f;
		var delta = CardDeltaPerMin( rack );
		return delta > 0f ? $"pays back ~{quoteBtc / delta:N0} min" : "";
	}

	// Payback auto-scaled (ruling: the "6d" sketch value is illustrative) -- the unit grows
	// with magnitude so early tiers (days) and high-rate racks (minutes) both read naturally.
	private string CardPaybackAuto( LpBitcoinRackEntity rack )
	{
		var quoteBtc = StepperNextQuoteSats( rack ) / 100_000_000f;
		var delta = CardDeltaPerMin( rack );
		if ( delta <= 0f )
			return "";

		var minutes = quoteBtc / delta;
		if ( minutes < 90f )
			return $"~{minutes:N0} min payback";

		var hours = minutes / 60f;
		return hours < 48f ? $"~{hours:0.#} hr payback" : $"~{hours / 24f:0.#} d payback";
	}

	// Clock delta for the row subtext ("+12.5 GHz").
	private static string CardDeltaGhz( LpBitcoinRackEntity rack )
		=> $"+{ProjectedClockGhz( rack.ComputeTier + 1 ) - ProjectedClockGhz( rack.ComputeTier ):0.#} GHz";

	// The VISIBLE delta subtext (ruling: not tooltip-only) -- "+X GHz - ~N payback".
	private string TrackDeltaSubtext( LpBitcoinRackEntity rack )
		=> $"{CardDeltaGhz( rack )} \u00B7 {CardPaybackAuto( rack )}";

