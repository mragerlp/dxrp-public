   BTC-UI-2 pre-build (slice SHELL-1b): the Bitcoin Hub UI skeleton in the house shell, per
   docs/superpowers/specs/2026-10-17-btc-ui-design.md section 6.1. Markup ports
   playerhub/code/ui/LpPlayerHubRoot.razor (the ULX grammar, R-2832-A) through
   _dev/shellkit/ShellKitSample.razor. Seven tabs read ILpBitcoinHubState through ILpBitcoinHubFormat.
   NO rails, NO money paths: every action control is inert and says which rail the build slice binds.
   BTC-HUB-OVERHAUL-1 U2: moved from _dev/btcui2; the hub press mounts it (LpBtcHubUiHost) and binds
   the pressed hub; the PIN keypad asks the host (unlock HE:995, set / re-enroll HE:928) - the only
   rails bound here. Every other action stays inert until U3.
   ----------------------------------------------------------------------------- *@
@namespace LifePunch.DXRP.Addons.Bitcoin.HubUi
@using System
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent

@attribute [StyleSheet]

<root class="lp-btchub">
	<div class="window">
		<div class="hub-shell-header">
			<div class="hub-shell-title">
				<div class="title-stack">
					<span class="title-primary brand-wordmark"><span class="wordmark-life">lifepunch</span><span class="wordmark-accent">.btc</span></span>
					<span class="title-sub">BITCOIN HUB</span>
				</div>
			</div>
			<div class="header-actions">
				<div class="@PinChipClass" tooltip="Hub PIN state">@PinChipText</div>
				<div class="header-chip" tooltip="Linked racks out of the slot cap">@RackChipText</div>
				<button class="header-chip header-chip-btn" tooltip="Hub wallet; opens the Wallet tab" onclick="@OpenWallet">
					<LifePunchCurrencyToken Sign="@BtcSign" Amount="@WalletText" />
				</button>
				<div class="header-power" tooltip="@PowerTooltip" onclick="@( () => Blocked( "power" ) )">
					<i class="material-icons inert-lock">lock</i>
					<span class="@PowerLabelClass">@PowerLabelText</span>
					<div class="@PowerSwitchClass">
						<div class="lp-switch-knob"></div>
					</div>
				</div>
				<button class="lp-ui-chrome-btn chrome-close" tooltip="Close the Bitcoin Hub (Esc)" onclick="@Close">
					<i class="material-icons">close</i>
				</button>
			</div>
		</div>

		@if ( !_pinView )
		{
			<div class="hub-shell-tabs">
				@foreach ( var tab in Tabs )
				{
					<button class="@TabClass( tab )" onclick="@( () => SetTab( tab ) )">
						<span>@LpBtcHubTabInfo.Label( tab )</span>
						@if ( tab == LpBtcHubTab.Logs && State.UnreadAlerts > 0 )
						{
							<span class="tab-dot" tooltip="Unread alerts">@State.UnreadAlerts</span>
						}
					</button>
				}
			</div>
		}

		<div class="hub-workspace">
			<div class="hub-page-head">
				<div class="hub-title">@PageTitle</div>
				<div class="hub-blurb">@PageBlurb</div>
				<div class="@ProvenanceClass" tooltip="@ProvenanceTooltip">@ProvenanceText</div>
			</div>
			@if ( !string.IsNullOrEmpty( _blockedNote ) )
			{
				<div class="blocked-note">
					<i class="material-icons">lock</i>
					<span>@_blockedNote</span>
				</div>
			}

			<div class="hub-tabhost">
				@if ( _pinView )
				{
					<div class="pin-view">
						<div class="pin-title">@PinTitle</div>
						<div class="pin-sub">@PinSubText</div>
						<div class="pin-dots">
							@for ( var i = 0; i < PinLength; i++ )
							{
								<div class="@DotClass( i )"></div>
							}
						</div>
						@if ( !string.IsNullOrEmpty( _pinError ) )
						{
							<div class="pin-error">@_pinError</div>
						}
						<div class="pin-pad">
							@foreach ( var row in PadRows )
							{
								<div class="pin-pad-row">
									@foreach ( var key in row )
									{
										<button class="pin-key" onclick="@( () => PressKey( key ) )">
											<span>@key</span>
										</button>
									}
								</div>
							}
						</div>
						<div class="pin-note">@PinNote</div>
					</div>
				}
				else if ( _activeTab == LpBtcHubTab.Overview )
				{
					<LpBtcHubOverview Model="@State" Format="@Format" OnOpenRacks="@(() => SetTab( LpBtcHubTab.Racks ))" OnBlocked="@((string action) => Blocked( action ))" />
				}
				else if ( _activeTab == LpBtcHubTab.Racks )
				{
					<LpBtcHubRacks Model="@State" Format="@Format" SelectedToken="@_selectedRackToken" OnSelectRack="@((string token) => SelectRack( token ))" OnBlocked="@((string action) => Blocked( action ))" />
				}
				else if ( _activeTab == LpBtcHubTab.Terminal )
				{
					<LpBtcHubTerminal Model="@State" Format="@Format" OnBlocked="@((string action) => Blocked( action ))" />
				}
				else if ( _activeTab == LpBtcHubTab.Wallet )
				{
					<LpBtcHubWallet Model="@State" Format="@Format" OnBlocked="@((string action) => Blocked( action ))" />
				}
				else if ( _activeTab == LpBtcHubTab.Transfers )
				{
					<LpBtcHubTransfers Model="@State" Format="@Format" />
				}
				else if ( _activeTab == LpBtcHubTab.Logs )
				{
					<LpBtcHubLogs Model="@State" Format="@Format" />
				}
				else
				{
					<LpBtcHubSettings Model="@State" Format="@Format" OnBlocked="@((string action) => Blocked( action ))" />
				}
			</div>
		</div>

		<LifePunchUiFooter Product="Bitcoin Hub" />
	</div>
</root>

@code
{
	/// <summary>Positive code-string ID for this skeleton. Exists nowhere else in the tree.</summary>
	public const string SkeletonMark = "LP_BTCUI2_SKELETON_20261017";

	private const int PinLength = 4;

	// Display glyphs are built from their code points so this block stays ASCII.
	private static readonly string BtcSign = ((char)0x20BF).ToString();

	private const string PinNote =
		"The hub checks every PIN; 5 wrong tries lock it briefly. Only the hub owner can set the PIN.";

	// Instance, not static readonly: hotload keeps a static readonly field's old value
	// (LpPlayerHubRoot.razor:97-99). The skeleton is rebuilt on every mount.
	private readonly LpBtcHubTab[] Tabs =
	{
		LpBtcHubTab.Overview,
		LpBtcHubTab.Racks,
		LpBtcHubTab.Terminal,
		LpBtcHubTab.Wallet,
		LpBtcHubTab.Transfers,
		LpBtcHubTab.Logs,
		LpBtcHubTab.Settings,
	};

	private readonly string[][] PadRows =
	{
		new[] { "1", "2", "3" },
		new[] { "4", "5", "6" },
		new[] { "7", "8", "9" },
		new[] { "clr", "0", "ok" },
	};

	private static bool _announced;

	// BTC-UI-2 read-only half: the viewer's own hub, read live (LpBitcoinHubStateLive); the fixture
	// only on request. Resolve order: BindHub, else the hub this viewer owns (BS:31-35), else NO HUB.
	private readonly LpBitcoinHubStateFixture _fixture = new();
	private readonly LpBitcoinHubStateLive _noHub = new LpBitcoinHubStateLive( null );
	private LpBitcoinHubStateLive? _live;
	private TimeSince _sinceResolve = 10f;

	/// <summary>Show the literal fixture instead of the live hub (design review and proof only).</summary>
	[Property] public bool UseFixture { get; set; }

	// BH-SHOWCASE-1: set on this one instance by LpBtcHubShowcase.Attach (editor only); a pressed hub
	// mounts a new instance, which never has it, so the live path never reads showcase figures.
	private LpBtcHubShowcaseFixture? _showcase;

	private bool Preview => _showcase is not null || UseFixture;

	private ILpBitcoinHubState State => _showcase is not null ? _showcase
		: UseFixture ? (ILpBitcoinHubState)_fixture : ( _live ?? _noHub );

	// The plain reason for the last inert control pressed; cleared by any navigation.
	private string _blockedNote = string.Empty;
	private readonly ILpBitcoinHubFormat Format = LpBitcoinHubFormatUnruled.Instance;

	private LpBtcHubTab _activeTab = LpBtcHubTab.Overview;
	private string _selectedRackToken = string.Empty;
	private bool _pinView = true;
	private string _pinEntry = string.Empty;
	private string _pinError = string.Empty;
	private bool _pinPending;
	private string _pinSetFirst = string.Empty;

	/// <summary>The hub this panel reads, or null before a bind (U2: LpBtcHubUiHost routes the PIN result by it).</summary>
	public LpBitcoinHubEntity? BoundHub => _live?.Hub;

	// A hub with no PIN, or a legacy hub whose PIN must be set again, opens on the set flow (HP:2457).
	private bool PinSetupMode => !Preview && ( !State.PinSet || State.PinNeedsReEnroll );

	private string PinChipText => State.PinSet ? "PIN SET" : "NO PIN";
	private string PinChipClass => State.PinSet ? "header-chip header-chip-good" : "header-chip header-chip-warn";
	private string RackChipText => State.RackCount + "/" + State.RackMax + " RACKS";
	private string WalletText => Format.Btc( State.WalletBtc );
	private string PowerLabelText => State.IsPowered ? "ON" : "OFF";
	private string PowerLabelClass => State.IsPowered ? "power-label power-label-on" : "power-label";
	// Inert: the switch shows state; pressing it shows where power is switched today (LpBtcHubCommandSpy.Reason).
	private string PowerSwitchClass => State.IsPowered ? "lp-switch lp-switch-on" : "lp-switch";
	private string PowerTooltip => "Hub power. " + LpBtcHubCommandSpy.Reason( "power" );

	// Provenance in player terms (BH-SHOWCASE-1): where the figures on screen come from.
	/// <summary>LIVE, PREVIEW or UNAVAILABLE, as the chip shows it.</summary>
	public string ProvenanceText => Preview ? "PREVIEW" : State.HasHub ? "LIVE" : "UNAVAILABLE";
	private string ProvenanceClass => Preview ? "header-chip provenance-chip header-chip-warn"
		: State.HasHub ? "header-chip provenance-chip header-chip-good" : "header-chip provenance-chip";
	private string ProvenanceTooltip => Preview ? "Example figures for a walkthrough. Nothing here is your hub."
		: State.HasHub ? "Figures read from this hub as it is now." : "No hub is linked to this view.";

	private string PinTitle => !PinSetupMode ? "Enter hub PIN"
		: string.IsNullOrEmpty( _pinSetFirst ) ? "Set a hub PIN" : "Confirm the PIN";
	private string PinSubText => _pinPending ? "Checking with the hub..."
		: State.PinNeedsReEnroll ? "Your PIN must be set again."
		: PinSetupMode && !string.IsNullOrEmpty( _pinSetFirst ) ? "Enter the same 4 digits again"
		: "4 digits";

	private string PageTitle => _pinView ? "Hub PIN" : LpBtcHubTabInfo.Label( _activeTab );
	private string PageBlurb => _pinView ? "Unlock to open the hub" : LpBtcHubTabInfo.Blurb( _activeTab );

	private string TabClass( LpBtcHubTab tab ) => tab == _activeTab ? "tab tab-sel" : "tab";

	private string DotClass( int index ) => index < _pinEntry.Length ? "pin-dot pin-dot-on" : "pin-dot";

	/// <summary>Deep-link entry for a future tab route; same path as a tab click.</summary>
	public void SelectTab( LpBtcHubTab tab ) => SetTab( tab );

	/// <summary>Bind the hub this panel reads (pattern: LpHashdPanel BindHub). Logs the live positive ID on every bind.</summary>
	public void BindHub( LpBitcoinHubEntity hub )
	{
		if ( !hub.IsValid() || ( _live is not null && _live.Hub == hub ) )
			return;

		_live = new LpBitcoinHubStateLive( hub );
		// A new hub starts at its own PIN gate (U2: the press binds the pressed hub, not the viewer's own).
		_pinView = true;
		_pinEntry = string.Empty;
		_pinError = string.Empty;
		_pinPending = false;
		_pinSetFirst = string.Empty;
		_selectedRackToken = string.Empty;
		Log.Info( "[btcui2] " + LpBitcoinHubStateLive.LiveMark + " hub=" + hub.GameObject.Id + " racks=" + _live.RackCount + " source=live" );
		var top = LpBitcoinHubStateLive.TrackTopTier( out var fromTrack );
		Log.Info( "[btcui2] " + LpBitcoinHubStateLive.PolishMark + " maxTier=" + top + " tierSource=" + ( fromTrack ? "track" : "fallback" ) + " unread=" + _live.UnreadAlerts + " panels=noshrink" );
		StateHasChanged();
	}

	// Once a second until bound: the hub this viewer owns (same resolver as LpPlayerHubBtcSource, BS:33-34).
	private void ResolveHub()
	{
		if ( Preview || ( _live is not null && _live.HasHub ) || _sinceResolve < 1f )
			return;

		_sinceResolve = 0f;
		var steamId = Game.SteamId;
		if ( steamId == 0 )
			return;

		var hub = LpBitcoinHubEntity.FindHubByOwnerSteamId( steamId );
		if ( hub.IsValid() )
			BindHub( hub );
	}

	// Proof seams (DRIVE-AWAY-1 A): OS-synthesised clicks do not reach panels, so a tool call drives the
	// same local paths a click would. Local state only: no rail, no network, no ConCmd, nothing sent.
	/// <summary>
	/// Proof: open the tabs past the PIN gate, visual only. U2: never through the keypad, which now asks
	/// the host and would count a failed attempt against the hub. The host gates nothing on this view.
	/// </summary>
	public void ProofUnlock()
	{
		_pinEntry = string.Empty;
		_pinError = string.Empty;
		_pinSetFirst = string.Empty;
		_pinPending = false;
		_pinView = false;
		StateHasChanged();
	}

	/// <summary>Proof: select a tab by its index in Tabs (0 = Overview .. 6 = Settings).</summary>
	public void ProofSelectTabIndex( int index )
	{
		if ( index >= 0 && index < Tabs.Length )
			SetTab( Tabs[index] );
	}

	/// <summary>Proof: open a rack detail through the slot-card path.</summary>
	public void ProofSelectRack( string token ) => SelectRack( token );

	/// <summary>Proof: raise Esc so OnUpdate runs the real Esc branch (rack detail first, then close).</summary>
	public void ProofEscape() => Input.EscapePressed = true;

	/// <summary>
	/// BH-SHOWCASE-1 (editor only, from LpBtcHubShowcase): read the showcase fixture on this instance and
	/// open past the PIN gate. The PIN stays out of the showcase; nothing is sent to any hub.
	/// </summary>
	public void AttachShowcase( LpBtcHubShowcaseFixture fixture )
	{
		if ( !Application.IsEditor || fixture is null )
			return;

		_showcase = fixture;
		_blockedNote = string.Empty;
		ProofUnlock();
	}

	/// <summary>Proof: press an inert control by its action name, the same path a click takes.</summary>
	public void ProofPressInert( string action ) => Blocked( action );

	/// <summary>
	/// Spy positive control: one PIN unlock pushed through the spy door, which must refuse it. Showcase
	/// only: without one this does nothing, so a proof can never spend a PIN try on a real hub.
	/// </summary>
	public void ProofMutationProbe()
	{
		if ( _showcase is null )
		{
			Log.Warning( "[btcui2] BH-SHOWCASE-1 probe skipped: no showcase attached" );
			return;
		}

		LpBtcHubCommandSpy.Send( _showcase is not null, "pin-unlock-probe", () => BoundHub?.RequestUnlockAccessPin( "0000" ) );
	}

	/// <summary>The hub id on screen (the showcase's fixed id, or the bound hub's), for the walkthrough log.</summary>
	public Guid ViewHubId => State.HubId;

	public string ActiveTabName => _pinView ? "PIN" : LpBtcHubTabInfo.Label( _activeTab );

	public string SelectedRackToken => _selectedRackToken;

	// An inert control was pressed: count it, send nothing, say why in player terms.
	private void Blocked( string action )
	{
		LpBtcHubCommandSpy.Blocked( action );
		_blockedNote = LpBtcHubCommandSpy.Reason( action );
		StateHasChanged();
	}

	private void SetTab( LpBtcHubTab tab )
	{
		if ( _pinView || _activeTab == tab )
			return;

		_activeTab = tab;
		_selectedRackToken = string.Empty;
		_blockedNote = string.Empty;
		StateHasChanged();
	}

	private void OpenWallet() => SetTab( LpBtcHubTab.Wallet );

	private void SelectRack( string token )
	{
		// U2 sensor for ESC-PROOF-F-RACK-CARD-NO-OPEN: the parent half of a rack-card click.
		Log.Info( "[btcui2] U2 SelectRack token=" + ( string.IsNullOrEmpty( token ) ? "(none)" : token ) + " pin=" + _pinView + " tab=" + _activeTab );
		_selectedRackToken = token ?? string.Empty;
		_blockedNote = string.Empty;
		StateHasChanged();
	}

	private void PressKey( string key )
	{
		if ( key == "clr" )
		{
			// Backspace one digit: the R-BTCUI-6 recommendation, recorded open.
			if ( _pinEntry.Length > 0 )
				_pinEntry = _pinEntry.Substring( 0, _pinEntry.Length - 1 );
			_pinError = string.Empty;
		}
		else if ( key == "ok" )
		{
			var hub = BoundHub;
			if ( _pinPending )
			{
				// One request in flight at a time; the host answers through OnPinGateResult.
			}
			else if ( _pinEntry.Length < PinLength )
			{
				_pinError = "Enter all " + PinLength + " digits.";
			}
			else if ( !hub.IsValid() || Preview )
			{
				// No hub bound (dev mount with no hub, fixture): local only, nothing sent.
				_pinEntry = string.Empty;
				_pinError = string.Empty;
				_pinView = false;
			}
			else if ( PinSetupMode )
			{
				// Set (or re-enroll) the PIN: enter, confirm, then the host checks owner and match
				// (SetAccessPinHost, HE:928-960; same flow as LpHashdPanel PinSetupMode, HP:2457,2572).
				if ( string.IsNullOrEmpty( _pinSetFirst ) )
				{
					_pinSetFirst = _pinEntry;
					_pinEntry = string.Empty;
					_pinError = string.Empty;
				}
				else
				{
					var first = _pinSetFirst;
					var confirm = _pinEntry;
					_pinSetFirst = string.Empty;
					_pinEntry = string.Empty;
					_pinError = string.Empty;
					// BH-SHOWCASE-1: through the spy door (pass-through on this live path). Pending is set first:
					// on a listen host the result can arrive inside the call and must win.
					_pinPending = true;
					if ( !LpBtcHubCommandSpy.Send( _showcase is not null, "pin-set", () => hub.RequestSetAccessPin( first, confirm ) ) )
						_pinPending = false;
				}
			}
			else
			{
				// U2: the host checks the PIN, ownership and the lockout (UnlockAccessPinHost, HE:995-1030).
				var pin = _pinEntry;
				_pinEntry = string.Empty;
				_pinError = string.Empty;
				_pinPending = true;
				if ( !LpBtcHubCommandSpy.Send( _showcase is not null, "pin-unlock", () => hub.RequestUnlockAccessPin( pin ) ) )
					_pinPending = false;
			}
		}
		else if ( _pinEntry.Length < PinLength )
		{
			_pinEntry += key;
			_pinError = string.Empty;
		}
		else
		{
			_pinError = "The PIN is " + PinLength + " digits.";
		}

		StateHasChanged();
	}

	/// <summary>The host's answer to a PIN unlock (LpBtcHubUiHost.OnPinResult). Pattern: LpHashdPanel.OnPinGateResult.</summary>
	public void OnPinGateResult( bool ok, string message )
	{
		_pinPending = false;
		_pinSetFirst = string.Empty;
		Log.Info( "[btcui2] U2 pin result ok=" + ok );
		if ( ok )
		{
			_pinError = string.Empty;
			_pinView = false;
		}
		else
		{
			_pinError = string.IsNullOrEmpty( message ) ? "Incorrect PIN." : message;
		}

		StateHasChanged();
	}

	// U2: through the host - a panel mounted on the shared HUD object must never take the HUD with it.
	private void Close() => LpBtcHubUiHost.Close( this );

	protected override void OnStart()
	{
		LifePunchUiScrollPolicy.Apply( Panel );
		if ( !_announced )
		{
			_announced = true;
			Log.Info( "[btcui2] " + SkeletonMark + " shell=house tabs=" + Tabs.Length + " rails=none" );
		}
	}

	protected override void OnUpdate()
	{
		ResolveHub();

		// Esc closes the innermost layer first (spec section 11): rack detail, then the panel.
		// Esc is routed to this panel ahead of the pause menu (LifePunchEscapeRouter).
		if ( LifePunchMenuInputBlock.TakeEscape() )
		{
			if ( !_pinView && !string.IsNullOrEmpty( _selectedRackToken ) )
			{
				Log.Info( "[btcui2] ESC-CONFLICT-1 esc closed rack detail" );
				SelectRack( string.Empty );
				return;
			}

			Log.Info( "[btcui2] ESC-CONFLICT-1 hub closed by Esc" );
			Close();
			return;
		}

		LifePunchUiScrollPolicy.Apply( Panel );
	}

	protected override void OnEnabled()
	{
		LifePunchMenuInputBlock.NotifyMenuOpened();
		LifePunchMenuInputBlock.ClaimEscape();
	}

	protected override void OnDisabled()
	{
		LifePunchMenuInputBlock.ReleaseEscape();
		LifePunchMenuInputBlock.NotifyMenuClosed();
	}

	protected override int BuildHash() =>
		HashCode.Combine( (int)_activeTab, _selectedRackToken, _pinView, _pinEntry, _pinError, _pinPending, HashCode.Combine( _pinSetFirst.Length, _blockedNote, _showcase is not null ), State.StateHash );
}
