   PROPRIETARY & CONFIDENTIAL - (c) 2026 lifepunch.co. All rights reserved.

   LIFEPUNCH Player Hub for DXRP
   Shell in the ULX grammar (StaffMenu.razor @ d9c08031): wordmark header, top tab strip, workspace, footer.
   Tabs: Overview / $BTC (LIVE) / $LP Store / Skills / Stats. The four fixture tabs are unchanged inside.
*@
@namespace LifePunch.DXRP.Addons.PlayerHub
@using System
@using Sandbox
@using Sandbox.UI
@using LifePunch.DXRP.Addons
@inherits PanelComponent
@implements ILpHubResult

@attribute [StyleSheet]

<root class="@RootClass()">
	<div class="window">
		<div class="hub-shell-header">
			<div class="hub-shell-title">
				<div class="title-stack">
					<span class="title-primary brand-wordmark"><span class="wordmark-life">lifepunch</span><span class="wordmark-accent">.hub</span></span>
					<span class="title-sub">PLAYER HUB</span>
				</div>
			</div>
			<div class="header-actions">
				<div class="header-chip" tooltip="Fixture level">
					<i class="material-icons">military_tech</i>
					<span>@LevelLabel</span>
				</div>
				<div class="header-chip" tooltip="@LpTooltip">
					<span class="lp-mark">$LP</span>
					<span>@LpAmount</span>
				</div>
				<button class="lp-ui-chrome-btn chrome-close" tooltip="Close Player Hub" onclick="@Close">
					<i class="material-icons">close</i>
				</button>
			</div>
		</div>

		<div class="hub-shell-tabs">
			@foreach ( var tab in Tabs )
			{
				<button class="@TabClass( tab )" onclick="@( () => SetTab( tab ) )">
					<span>@LpPlayerHubTabInfo.Label( tab )</span>
				</button>
			}
		</div>

		<div class="hub-workspace">
			<div class="hub-page-head">
				<div class="hub-title">@LpPlayerHubTabInfo.Label( ActiveTab )</div>
				<div class="hub-blurb">@LpPlayerHubTabInfo.Blurb( ActiveTab )</div>
				@if ( VisibleTabIsFixture )
				{
					<div class="header-chip hub-preview-chip" tooltip="@PreviewTooltip">PREVIEW &#183; FIXTURE DATA</div>
				}
				else
				{
					<div class="header-chip hub-live-chip" tooltip="Read live from your Bitcoin Hub and racks">LIVE</div>
				}
			</div>

			<div class="hub-tabhost">
				@if ( ActiveTab == LpPlayerHubTab.Overview )
				{
					<LpPlayerHubOverview Model="@OverviewModel" />
				}
				else if ( ActiveTab == LpPlayerHubTab.Btc )
				{
					<LpPlayerHubBtc Model="@BtcModel" />
				}
				else if ( ActiveTab == LpPlayerHubTab.Stats )
				{
					<LpPlayerHubStats Model="@StatsModel" />
				}
				else if ( ActiveTab == LpPlayerHubTab.Skills )
				{
					<LpPlayerHubSkills Model="@SkillsModel" />
				}
				else if ( ActiveTab == LpPlayerHubTab.Store )
				{
					<LpPlayerHubStore Model="@StoreModel" />
				}
			</div>
		</div>

		<LifePunchUiFooter Product="Player Hub" />
	</div>
</root>

@code
{
	public const string SliceMark = "LP_PLAYERHUB_ULX_BTC_20261016";
	public const string QaMark = "LP_PLAYERHUB_NO_SCROLL_FIXTURE_20260722";

	// Instance, not static readonly: hotload keeps a static readonly field's OLD value (the engine upgrades
	// the old instance in place instead of re-running the initialiser), which rendered a stale 4-tab strip
	// on 2026-10-16. The hub is rebuilt on every open, so an instance field is always current.
	private readonly LpPlayerHubTab[] Tabs =
	{
		LpPlayerHubTab.Overview,
		LpPlayerHubTab.Btc,
		LpPlayerHubTab.Store,
		LpPlayerHubTab.Skills,
		LpPlayerHubTab.Stats,
	};

	private static bool _sliceAnnounced;

	private LpPlayerHubTab _activeTab = LpPlayerHubTab.Overview;
	private string _selectedSkillTrackId = "resilience";
	private string _selectedSkillId = "resilience-slot-1";
	private string _selectedStoreCategoryId = "all";
	private string _selectedStoreItemId = "identity-banner";

	private LpPlayerHubTab ActiveTab => _activeTab;
	private LpPlayerHubShellVm Vm => LpPlayerHubFixture.Shell( _activeTab );

	private LpOverviewVm OverviewModel => LpPlayerHubFixture.Overview(
		new[]
		{
			new LpHubActionVm(
				Id: "btc",
				Label: "Open $BTC",
				Icon: "currency_bitcoin",
				Hint: "Your Bitcoin Hub and racks, live",
				Enabled: true,
				OnSelected: () => SetTab( LpPlayerHubTab.Btc )),
			new LpHubActionVm(
				Id: "skills",
				Label: "View skills",
				Icon: "account_tree",
				Hint: "Browse skill tracks",
				Enabled: true,
				OnSelected: () => SetTab( LpPlayerHubTab.Skills )),
			new LpHubActionVm(
				Id: "store",
				Label: "Open store",
				Icon: "storefront",
				Hint: "Browse the fixture catalog",
				Enabled: true,
				OnSelected: () => SetTab( LpPlayerHubTab.Store )),
			new LpHubActionVm(
				Id: "tags",
				Label: "Open tags",
				Icon: "label",
				Hint: "Your tags and titles",
				Enabled: true,
				OnSelected: OpenTagsDoor),
			new LpHubActionVm(
				Id: "serverhub",
				Label: "Server hub",
				Icon: "dns",
				Hint: "Jobs and server info",
				Enabled: true,
				OnSelected: OpenServerHubDoor),
		});

	// HUB-RACKS-1: the rack upgrade this open hub has asked for, and the host's answer. Per open (the panel is rebuilt on
	// every open), so a request left unanswered when the hub was closed cannot leave a control disabled next time.
	private readonly LpBtcUpgradeState _upgrade = new();

	private LpBtcVm BtcModel => LpPlayerHubBtcSource.Build( StateHasChanged, _upgrade );

	/// <summary>The hub result relay (SPINE-1) delivers the Bitcoin hub's purchase answer here, to the caller who asked.</summary>
	public void OnHubResult( string hubKey, Guid callerId, string kind, string payload )
		=> LpPlayerHubBtcSource.OnRelayResult( _upgrade, hubKey, callerId, kind, payload, StateHasChanged );

	private LpStatsVm StatsModel => LpPlayerHubFixture.Stats();

	private LpSkillsVm SkillsModel => LpPlayerHubFixture.Skills(
		_selectedSkillTrackId,
		_selectedSkillId,
		SelectSkillTrack,
		SelectSkill);

	private LpStoreVm StoreModel => LpPlayerHubFixture.Store(
		_selectedStoreCategoryId,
		_selectedStoreItemId,
		SelectStoreCategory,
		SelectStoreItem);

	private bool VisibleTabIsFixture => _activeTab switch
	{
		LpPlayerHubTab.Btc => false,
		LpPlayerHubTab.Overview => OverviewModel.IsFixture,
		LpPlayerHubTab.Skills => SkillsModel.IsFixture,
		LpPlayerHubTab.Store => StoreModel.IsFixture,
		LpPlayerHubTab.Stats => StatsModel.IsFixture,
		_ => Vm.IsFixture,
	};

	private const string PreviewTooltip =
		"This tab uses deterministic preview fixtures. Values are not live player state.";

	private const string LpTooltip =
		"$LP is a TEMPORARY display sign and colour. This fixture does not spend currency.";

	private string LpAmount => Vm.LpBalance.ToString( "N0" );
	private string LevelLabel => "LEVEL " + Vm.Level;

	private string RootClass() => "lp-playerhub is-open";

	private string TabClass( LpPlayerHubTab tab ) => tab == _activeTab ? "tab tab-sel" : "tab";

	/// <summary>Deep-link entry used by <c>playerhub_tab</c>; same path as a nav click.</summary>
	public void SelectTab( LpPlayerHubTab tab ) => SetTab( tab );

	private void SetTab( LpPlayerHubTab tab )
	{
		if ( _activeTab == tab )
			return;

		_activeTab = tab;
		StateHasChanged();
	}

	private void SelectSkillTrack( string trackId )
	{
		_selectedSkillTrackId = trackId;
		_selectedSkillId = trackId + "-slot-1";
		StateHasChanged();
	}

	private void SelectSkill( string skillId )
	{
		if ( _selectedSkillId == skillId )
			return;

		_selectedSkillId = skillId;
		StateHasChanged();
	}

	private void SelectStoreCategory( string categoryId )
	{
		_selectedStoreCategoryId = categoryId;
		_selectedStoreItemId = categoryId switch
		{
			"identity" => "identity-banner",
			"utility" => "job-route-card",
			_ => _selectedStoreItemId,
		};
		StateHasChanged();
	}

	private void SelectStoreItem( string itemId )
	{
		if ( _selectedStoreItemId == itemId )
			return;

		_selectedStoreItemId = itemId;
		StateHasChanged();
	}

	private void Close() => LpPlayerHubHost.RequestClose();

	// Overview doors. Each hands over to the other menu's own host entry point (no new ConCmd, no HASHD door: a remote
	// HASHD open would skip the in-world range gate). The hub closes FIRST so the target menu captures a released camera
	// lock instead of this hub's locked one, and a target that is already open is left alone because Toggle() would
	// close it. The try/catch keeps a failing host from taking this click handler down with it.
	private static void OpenTagsDoor()
	{
		try
		{
			if ( LifePunch.DXRP.Addons.Tags.LpTagsMenuHost.IsOpen )
				return;

			LpPlayerHubHost.RequestClose();
			LifePunch.DXRP.Addons.Tags.LpTagsMenuHost.Toggle();
		}
		catch ( Exception e )
		{
			Log.Warning( "[playerhub] tags door failed: " + e.Message );
		}
	}

	private static void OpenServerHubDoor()
	{
		try
		{
			if ( LifePunch.DXRP.Addons.ServerHub.LpServerHubHost.IsOpen )
				return;

			LpPlayerHubHost.RequestClose();
			LifePunch.DXRP.Addons.ServerHub.LpServerHubHost.Toggle();
		}
		catch ( Exception e )
		{
			Log.Warning( "[playerhub] serverhub door failed: " + e.Message );
		}
	}

	protected override void OnStart()
	{
		LifePunchUiScrollPolicy.Apply( Panel );
		if ( !_sliceAnnounced )
		{
			_sliceAnnounced = true;
			Log.Info( "[playerhub] " + SliceMark + " shell=ulx tabs=5 btc=live" );
		}
	}

	protected override void OnUpdate()
	{
		LifePunchUiScrollPolicy.Apply( Panel );
	}

	protected override void OnEnabled()
	{
		LifePunchMenuInputBlock.NotifyMenuOpened();
	}

	protected override void OnDisabled()
	{
		LifePunchMenuInputBlock.NotifyMenuClosed();
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();
		hash.Add( (int)_activeTab );
		hash.Add( _selectedSkillTrackId );
		hash.Add( _selectedSkillId );
		hash.Add( _selectedStoreCategoryId );
		hash.Add( _selectedStoreItemId );
		hash.Add( VisibleTabIsFixture );
		hash.Add( _upgrade.RackId );
		hash.Add( _upgrade.Note );
		if ( _activeTab == LpPlayerHubTab.Btc )
			hash.Add( LpPlayerHubBtcSource.LiveHash() );
		return hash.ToHashCode();
	}
}
