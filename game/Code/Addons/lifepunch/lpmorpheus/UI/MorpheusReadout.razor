@using Sandbox
@using Sandbox.UI
@inherits PanelComponent
@namespace LifePunch.DXRP.Addons.Morpheus
@attribute [StyleSheet]

<root>
	@if ( Kind != LpMorpheusReadoutKind.Hidden )
	{
		<div class="morpheus-readout">
			<label class="speaker">@Speaker</label>
			<label class="line">@Line</label>
		</div>
	}
</root>

@code
{
	[Property]
	public string Speaker { get; set; } = LpMorpheusReadout.SpeakerName;

	[Property]
	public string Line { get; set; } = string.Empty;

	[Property]
	public LpMorpheusReadoutKind Kind { get; set; } = LpMorpheusReadoutKind.Hidden;

	protected override int BuildHash() => System.HashCode.Combine( Speaker, Line, Kind );
}
