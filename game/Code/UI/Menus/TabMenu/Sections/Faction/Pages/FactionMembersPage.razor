@namespace Dxura.RP.Game.UI
@using Sandbox.UI
@inherits Panel
@page "/tabmenu/faction/members"

<root>
@if ( !FactionSystem.Instance.IsValid() || !FactionSystem.Instance.IsLoaded )
{
	<div class="faction-state-view"><h2>#faction.loading</h2></div>
}
else if ( !Player.Local.IsInFaction )
{
	<div class="faction-state-view">
		<div class="state-icon"><i class="material-icons">group_off</i></div>
		<h2>#faction.members.join_first</h2>
	</div>
}
else
{
	var system = FactionSystem.Instance;
	var faction = Player.Local.GetFaction();
	if ( faction == null )
	{
		<div class="faction-state-view"><h2>#faction.unavailable</h2></div>
		return;
	}

	var factionId = faction.Value.Id;
	var myRole = Player.Local.GetFactionRole();
	var canInvite = myRole?.Permission.HasFlag( FactionPermission.InviteMember ) ?? false;
	var canKick = myRole?.Permission.HasFlag( FactionPermission.KickMember ) ?? false;
	var canSetRanks = myRole?.Permission.HasFlag( FactionPermission.SetRanks ) ?? false;
	var roles = system.GetFactionRoles( factionId ).OrderBy( role => role.Order ).ThenBy( role => role.Name ).ToList();
	var allMembers = system.GetFactionMembers( factionId ).ToList();
	var members = allMembers
		.Where( member => MatchesMemberSearch( member, _memberSearch ) )
		.OrderByDescending( member => FactionUi.IsMemberOnline( member.PlayerId ) )
		.ThenBy( member => GetRoleOrder( member.RoleId ) )
		.ThenBy( member => FactionUi.GetMemberName( member ) )
		.ToList();
	var onlineCount = allMembers.Count( member => FactionUi.IsMemberOnline( member.PlayerId ) );
	var selectedMember = allMembers.FirstOrDefault( member => member.PlayerId == _selectedMemberId );
	var hasSelectedMember = selectedMember.PlayerId != 0;
	var candidates = canInvite
		? GameUtils.Players
			.Where( player => player.IsValid() && player.IsConnected && !player.IsInFaction && MatchesInviteSearch( player, _inviteSearch ) )
			.OrderBy( player => player.DisplayName )
			.Take( 12 )
			.ToList()
		: [];

	<div class="faction-page faction-members-page">
		<div class="page-toolbar">
			<div class="toolbar-title">
				<h2>#faction.members.roster</h2>
				<span class="toolbar-meta">@string.Format( Language.GetPhrase( "faction.members.count" ), onlineCount, faction.Value.MemberCount )</span>
			</div>
			<div class="faction-search">
				<i class="material-icons">search</i>
				<TabMenuTextEntry placeholder="#faction.members.search_roster" Value:bind="@_memberSearch" />
			</div>
		</div>

		<div class="faction-columns members-layout">
			<div class="faction-column-main">
				<section class="faction-surface member-directory">
					<div class="member-list-header">
						<span class="member-col-player">#faction.members.player</span>
						<span class="member-col-role">#generic.role</span>
						<span class="member-col-status">#faction.members.status</span>
						<span class="member-col-action"></span>
					</div>

					@if ( members.Count > 0 )
					{
						@foreach ( var member in members )
						{
							var player = GameUtils.GetPlayerById( member.PlayerId );
							var isOnline = player.IsValid() && player.IsConnected;
							var isSelf = member.PlayerId == Player.Local.SteamId;
							<div class="member-row @( _selectedMemberId == member.PlayerId ? "selected" : "" )">
								<div class="member-col-player">
									<div class="member-avatar">
										<img src="avatar:@member.PlayerId" alt="avatar" />
										<span class="status-dot @( isOnline ? "online" : "" )"></span>
									</div>
									<div class="member-identity">
										<span>@FactionUi.GetMemberName( member )</span>
										<small>@member.PlayerId</small>
									</div>
									@if ( isSelf )
									{
										<span class="self-badge">#faction.members.you</span>
									}
								</div>
								<div class="member-col-role">
									<span class="member-role">@FactionUi.GetRoleName( member.RoleId )</span>
								</div>
								<div class="member-col-status">
								@if ( player != null && isOnline )
									{
										<span class="online-label">#faction.members.online</span>
										<span class="member-job" style="color: @player.Job.Color.Hex()">@player.JobDisplayName</span>
									}
									else
									{
										<span class="offline-label">#faction.members.offline</span>
									}
								</div>
								<div class="member-col-action">
									@if ( !isSelf && (canKick || canSetRanks) )
									{
										<button class="faction-action icon-only @(_selectedMemberId == member.PlayerId ? "primary" : "")" onclick="@(() => OpenMember( member ))" tooltip="#faction.members.manage">
											<i class="material-icons">manage_accounts</i>
										</button>
									}
								</div>
							</div>
						}
					}
					else
					{
						<div class="empty-state">
							<i class="material-icons">person_search</i>
							<span>#faction.members.no_results</span>
						</div>
					}
				</section>
			</div>

			<div class="faction-column-side member-sidebar">
				@if ( canKick || canSetRanks )
				{
					<section class="faction-surface member-manager">
						<div class="surface-header">
							<i class="material-icons">manage_accounts</i>
							<h3>#faction.members.manage</h3>
						</div>

						@if ( hasSelectedMember )
						{
							var selectedOnline = FactionUi.IsMemberOnline( selectedMember.PlayerId );
							<div class="selected-member-card">
								<img src="avatar:@selectedMember.PlayerId" alt="avatar" />
								<div>
									<b>@FactionUi.GetMemberName( selectedMember )</b>
									<span><span class="status-dot @( selectedOnline ? "online" : "" )"></span>@( selectedOnline ? Language.GetPhrase( "faction.members.online" ) : Language.GetPhrase( "faction.members.offline" ) )</span>
								</div>
								<button class="faction-icon-button" onclick="@CloseMember" tooltip="#generic.close"><i class="material-icons">close</i></button>
							</div>

							<div class="surface-body">
								@if ( canSetRanks )
								{
									<div class="form-field">
										<label>#faction.members.assigned_role</label>
										<DropDown class="faction-dropdown" Options="@GetRoleOptions( roles )" Value="@_selectedRoleValue" ValueChanged="@OnRoleSelectionChanged" />
									</div>
									<button class="faction-action primary" onclick="@(() => TrySetRole( factionId, selectedMember.PlayerId ))">
										<i class="material-icons">save</i><span>#faction.members.save_role</span>
									</button>
								}

								@if ( canKick )
								{
									<div class="manager-divider"></div>
									<button class="faction-action danger" onclick="@(() => TryKick( factionId, selectedMember.PlayerId ))">
										<i class="material-icons">person_remove</i>
										<span>@( _kickPrimedId == selectedMember.PlayerId ? Language.GetPhrase( "faction.members.confirm_kick" ) : Language.GetPhrase( "faction.members.kick" ) )</span>
									</button>
								}
							</div>
						}
						else
						{
							<div class="empty-state"><i class="material-icons">touch_app</i><span>#faction.members.select_member</span></div>
						}
					</section>
				}

				@if ( canInvite )
				{
					<section class="faction-surface invite-surface">
						<div class="surface-header">
							<i class="material-icons">person_add</i>
							<h3>#faction.members.invite</h3>
						</div>
						<div class="invite-search-wrap">
							<div class="faction-search">
								<i class="material-icons">search</i>
								<TabMenuTextEntry placeholder="#faction.members.search" Value:bind="@_inviteSearch" />
							</div>
						</div>
						@if ( candidates.Count > 0 )
						{
							<div class="candidate-list">
								@foreach ( var candidate in candidates )
								{
									<div class="candidate-row">
										<img src="avatar:@candidate.SteamId" alt="avatar" />
										<div class="candidate-copy">
											<span>@candidate.DisplayName</span>
											<small style="color: @candidate.Job.Color.Hex()">@candidate.JobDisplayName</small>
										</div>
										<button class="faction-action icon-only positive" onclick="@(() => TryInvite( factionId, candidate.SteamId ))" tooltip="#faction.members.invite_button">
											<i class="material-icons">person_add</i>
										</button>
									</div>
								}
							</div>
						}
						else
						{
							<div class="empty-state compact-empty"><i class="material-icons">person_search</i><span>@( string.IsNullOrWhiteSpace( _inviteSearch ) ? Language.GetPhrase( "faction.members.no_available" ) : Language.GetPhrase( "faction.members.no_match" ) )</span></div>
						}
					</section>
				}
			</div>
		</div>
	</div>
}
</root>

@code {
	private string _memberSearch = "";
	private string _inviteSearch = "";
	private long? _selectedMemberId;
	private long? _kickPrimedId;
	private string _selectedRoleValue = Guid.Empty.ToString();

	private static bool MatchesMemberSearch( FactionMemberInfo member, string search )
	{
		if ( string.IsNullOrWhiteSpace( search ) ) return true;
		return FactionUi.GetMemberName( member ).Contains( search, StringComparison.OrdinalIgnoreCase ) ||
		       FactionUi.GetRoleName( member.RoleId ).Contains( search, StringComparison.OrdinalIgnoreCase ) ||
		       member.PlayerId.ToString().Contains( search, StringComparison.OrdinalIgnoreCase );
	}

	private static bool MatchesInviteSearch( Player player, string search )
	{
		return string.IsNullOrWhiteSpace( search ) ||
		       player.DisplayName.Contains( search, StringComparison.OrdinalIgnoreCase ) ||
		       player.SteamId.ToString().Contains( search, StringComparison.OrdinalIgnoreCase );
	}

	private static int GetRoleOrder( Guid? roleId )
	{
		return roleId.HasValue && FactionSystem.Instance.FactionRoles.TryGetValue( roleId.Value, out var role )
			? role.Order
			: int.MaxValue;
	}

	private static List<Option> GetRoleOptions( List<FactionRoleInfo> roles )
	{
		var options = new List<Option>
		{
			new( Language.GetPhrase( "faction.members.unassigned" ), Guid.Empty.ToString() )
		};
		options.AddRange( roles.Select( role => new Option( role.Name, role.Id.ToString() ) ) );
		return options;
	}

	private void OpenMember( FactionMemberInfo member )
	{
		_selectedMemberId = member.PlayerId;
		_selectedRoleValue = (member.RoleId ?? Guid.Empty).ToString();
		_kickPrimedId = null;
	}

	private void CloseMember()
	{
		_selectedMemberId = null;
		_kickPrimedId = null;
	}

	private void OnRoleSelectionChanged( string value )
	{
		_selectedRoleValue = value;
	}

	private void TryInvite( Guid factionId, long steamId )
	{
		if ( Cooldown.Current.CheckAndStartCooldown( "faction:invite", Config.Current.Game.ActionCooldown, true ) ) return;
		FactionSystem.Instance.InviteFactionMemberHost( factionId, steamId );
	}

	private void TryKick( Guid factionId, long steamId )
	{
		if ( _kickPrimedId != steamId )
		{
			_kickPrimedId = steamId;
			return;
		}

		if ( Cooldown.Current.CheckAndStartCooldown( "faction:kick", Config.Current.Game.ActionCooldown, true ) ) return;
		_kickPrimedId = null;
		FactionSystem.Instance.KickFactionMemberHost( factionId, steamId );
	}

	private void TrySetRole( Guid factionId, long steamId )
	{
		if ( !Guid.TryParse( _selectedRoleValue, out var roleId ) ) return;
		if ( Cooldown.Current.CheckAndStartCooldown( "faction:setrole", Config.Current.Game.ActionCooldown, true ) ) return;
		FactionSystem.Instance.SetMemberRoleHost( factionId, steamId, roleId );
	}

	protected override int BuildHash()
	{
		if ( !FactionSystem.Instance.IsValid() ) return 0;
		var inputHash = HashCode.Combine( _memberSearch, _inviteSearch, _selectedRoleValue );
		return HashCode.Combine(
			Player.Local?.FactionId,
			Player.Local?.FactionRoleId,
			_selectedMemberId,
			_kickPrimedId,
			FactionSystem.Instance.Revision,
			GameUtils.Players.Count(),
			inputHash
		);
	}
}
