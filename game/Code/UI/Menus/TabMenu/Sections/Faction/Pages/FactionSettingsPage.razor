@namespace Dxura.RP.Game.UI
@using Sandbox.UI
@inherits Panel
@page "/tabmenu/faction/settings"

<root>
@if ( !FactionSystem.Instance.IsValid() || !FactionSystem.Instance.IsLoaded )
{
	<div class="faction-state-view"><h2>#faction.loading</h2></div>
}
else if ( !Player.Local.IsInFaction )
{
	<div class="faction-state-view">
		<div class="state-icon"><i class="material-icons">group_off</i></div>
		<h2>#faction.settings.join_first</h2>
	</div>
}
else
{
	var system = FactionSystem.Instance;
	var faction = Player.Local.GetFaction();
	if ( faction == null )
	{
		<div class="faction-state-view"><h2>#faction.unavailable</h2></div>
		return;
	}

	var factionId = faction.Value.Id;
	var myRole = Player.Local.GetFactionRole();
	var canManage = myRole?.Permission.HasFlag( FactionPermission.ManageFaction ) ?? false;
	var canSetRanks = myRole?.Permission.HasFlag( FactionPermission.SetRanks ) ?? false;
	var roles = system.GetFactionRoles( factionId ).OrderBy( role => role.Order ).ThenBy( role => role.Name ).ToList();
	var members = system.GetFactionMembers( factionId ).ToList();
	if ( !_descriptionInitialized )
	{
		_descriptionText = faction.Value.Description ?? "";
		_descriptionInitialized = true;
	}

	<div class="faction-page faction-settings-page">
		<div class="page-toolbar">
			<div class="toolbar-title">
				<h2>#faction.settings.command</h2>
				<span class="toolbar-meta">@faction.Value.Name | @FactionUi.GetRoleName( Player.Local.FactionRoleId )</span>
			</div>
		</div>

		@if ( canManage )
		{
			<section class="faction-surface profile-settings">
				<div class="surface-header">
					<i class="material-icons">edit_note</i>
					<h3>#faction.settings.profile</h3>
				</div>
				<div class="surface-body profile-form">
					<div class="form-field">
						<label>#faction.settings.description</label>
						<TabMenuTextEntry class="faction-input multiline" Multiline="@true" MaxLength="@( FactionSystem.FactionDescriptionMaxLength )" placeholder="#faction.settings.desc_placeholder" Value:bind="@_descriptionText" />
					</div>
					<div class="form-actions">
						<span class="character-count">@_descriptionText.Length / @FactionSystem.FactionDescriptionMaxLength</span>
						<button class="faction-action primary" onclick="@(() => TryUpdateDescription( factionId ))">
							<i class="material-icons">save</i><span>#faction.settings.save</span>
						</button>
					</div>
				</div>
			</section>
		}

		@if ( canSetRanks )
		{
			<div class="faction-columns role-settings-layout">
				<div class="faction-column-main">
					<section class="faction-surface role-directory">
						<div class="surface-header">
							<i class="material-icons">badge</i>
							<h3>#faction.settings.roles</h3>
							<span class="surface-count">@roles.Count</span>
						</div>

						@if ( roles.Count > 0 )
						{
							<div class="role-list-header">
								<span class="role-col-order">#</span>
								<span class="role-col-name">#faction.settings.name</span>
								<span class="role-col-permissions">#faction.settings.permissions</span>
								<span class="role-col-members">#faction.overview.members</span>
								<span class="role-col-action"></span>
							</div>
							@foreach ( var role in roles )
							{
								var assigned = members.Count( member => member.RoleId == role.Id );
								<div class="role-directory-row @( _editingRoleId == role.Id ? "selected" : "" )">
									<span class="role-col-order">@role.Order</span>
									<div class="role-col-name">
										<b>@role.Name</b>
										<small>@( string.IsNullOrWhiteSpace( role.Description ) ? Language.GetPhrase( "faction.no_description" ) : role.Description )</small>
									</div>
									<span class="role-col-permissions">@FactionUi.FormatPermissions( role.Permission )</span>
									<span class="role-col-members">@assigned</span>
									<div class="role-col-action">
										<button class="faction-action icon-only @(_editingRoleId == role.Id ? "primary" : "")" onclick="@(() => BeginEditRole( role ))" tooltip="#faction.settings.edit_role">
											<i class="material-icons">edit</i>
										</button>
									</div>
								</div>
							}
						}
						else
						{
							<div class="empty-state"><i class="material-icons">badge</i><span>#faction.settings.no_roles</span></div>
						}
					</section>
				</div>

				<div class="faction-column-side role-editor-column">
					<section class="faction-surface role-editor">
						<div class="surface-header">
							<i class="material-icons">@(_editingRoleId.HasValue ? "edit" : "add")</i>
							<h3>@( _editingRoleId.HasValue ? Language.GetPhrase( "faction.settings.edit_role" ) : Language.GetPhrase( "faction.settings.create_role" ) )</h3>
							@if ( _editingRoleId.HasValue )
							{
								<button class="faction-icon-button editor-close" onclick="@ResetRoleEditor" tooltip="#generic.cancel"><i class="material-icons">close</i></button>
							}
						</div>
						<div class="surface-body">
							<div class="form-row">
								<div class="form-field">
									<label>#faction.settings.role_name</label>
									<TabMenuTextEntry class="faction-input" MaxLength="@( FactionSystem.RoleNameMaxLength )" Value:bind="@_roleName" />
								</div>
								<div class="form-field narrow">
									<label>#faction.settings.order</label>
									<TabMenuTextEntry class="faction-input" Numeric="@true" MaxLength="@( 4 )" Value:bind="@_roleOrder" />
								</div>
							</div>

							<div class="form-field">
								<label>#faction.settings.role_desc</label>
								<TabMenuTextEntry class="faction-input multiline role-description-input" Multiline="@true" MaxLength="@( FactionSystem.RoleDescriptionMaxLength )" Value:bind="@_roleDescription" />
							</div>

							<div class="form-field">
								<label>#faction.settings.permissions</label>
								<div class="permission-toggle-list">
									@foreach ( var permission in PermissionOptions )
									{
										var enabled = _rolePermissions.HasFlag( permission.Permission );
										<button class="permission-toggle @( enabled ? "active" : "" )" onclick="@(() => TogglePermission( permission.Permission ))">
											<i class="material-icons">@( enabled ? "check_box" : "check_box_outline_blank" )</i>
							<span>@Language.GetPhrase( permission.Label )</span>
										</button>
									}
								</div>
							</div>

							<div class="form-actions role-editor-actions">
								@if ( _editingRoleId.HasValue )
								{
									<button class="faction-action danger" onclick="@(() => TryDeleteRole( factionId, _editingRoleId.Value ))">
										<i class="material-icons">delete</i>
										<span>@( _deleteRolePrimed == _editingRoleId ? Language.GetPhrase( "faction.settings.confirm_delete_role" ) : Language.GetPhrase( "faction.settings.delete_role" ) )</span>
									</button>
								}
								<button class="faction-action positive" onclick="@(() => SaveRole( factionId ))">
									<i class="material-icons">@(_editingRoleId.HasValue ? "save" : "add")</i>
									<span>@( _editingRoleId.HasValue ? Language.GetPhrase( "faction.settings.save_role" ) : Language.GetPhrase( "faction.settings.create_role" ) )</span>
								</button>
							</div>
						</div>
					</section>
				</div>
			</div>
		}
		else if ( !canManage )
		{
			<section class="faction-surface settings-access-denied">
				<div class="empty-state">
					<i class="material-icons">lock</i>
					<span>#faction.settings.no_management_access</span>
				</div>
			</section>
		}

		<section class="faction-surface danger-zone">
			<div class="surface-header">
				<i class="material-icons">warning</i>
				<h3>#faction.settings.danger_zone</h3>
			</div>
			<div class="danger-actions">
				<div class="danger-copy">
					<b>#faction.settings.leave</b>
					<span>#faction.settings.leave_detail</span>
				</div>
				<button class="faction-action warning" onclick="@(() => ArmDangerAction( "leave" ))">
					<i class="material-icons">logout</i><span>#faction.settings.leave</span>
				</button>
			</div>

			@if ( canManage )
			{
				<div class="danger-actions">
					<div class="danger-copy">
						<b>#faction.settings.delete</b>
						<span>#faction.settings.delete_detail</span>
					</div>
					<button class="faction-action danger" onclick="@(() => ArmDangerAction( "delete" ))">
						<i class="material-icons">delete_forever</i><span>#faction.settings.delete</span>
					</button>
				</div>
			}

			@if ( _dangerAction != null )
			{
				<div class="danger-confirmation">
					<i class="material-icons">report</i>
					<span>@( _dangerAction == "delete" ? Language.GetPhrase( "faction.settings.delete_confirm" ) : Language.GetPhrase( "faction.settings.leave_confirm" ) )</span>
					<button class="faction-action compact" onclick="@CancelDangerAction">#generic.cancel</button>
					<button class="faction-action compact danger" onclick="@(() => ConfirmDangerAction( factionId ))">#dupe.confirm</button>
				</div>
			}
		</section>
	</div>
}
</root>

@code {
	private static readonly (FactionPermission Permission, string Label)[] PermissionOptions =
	[
		(FactionPermission.InviteMember, "faction.permissions.invite"),
		(FactionPermission.KickMember, "faction.permissions.kick"),
		(FactionPermission.ManageFaction, "faction.permissions.manage"),
		(FactionPermission.SetRanks, "faction.permissions.ranks"),
		(FactionPermission.WithdrawMoney, "faction.permissions.withdraw")
	];

	private bool _descriptionInitialized;
	private string _descriptionText = "";
	private Guid? _editingRoleId;
	private Guid? _deleteRolePrimed;
	private string _roleName = "";
	private string _roleDescription = "";
	private string _roleOrder = "0";
	private FactionPermission _rolePermissions;
	private string? _dangerAction;

	private void BeginEditRole( FactionRoleInfo role )
	{
		_editingRoleId = role.Id;
		_deleteRolePrimed = null;
		_roleName = role.Name;
		_roleDescription = role.Description ?? "";
		_roleOrder = role.Order.ToString();
		_rolePermissions = role.Permission;
	}

	private void ResetRoleEditor()
	{
		_editingRoleId = null;
		_deleteRolePrimed = null;
		_roleName = "";
		_roleDescription = "";
		_roleOrder = "0";
		_rolePermissions = FactionPermission.None;
	}

	private void TogglePermission( FactionPermission permission )
	{
		_rolePermissions ^= permission;
	}

	private void TryUpdateDescription( Guid factionId )
	{
		if ( _descriptionText.Length > FactionSystem.FactionDescriptionMaxLength )
		{
			Notify.Error( "#faction.description_invalid" );
			return;
		}

		if ( Cooldown.Current.CheckAndStartCooldown( "faction:update", Config.Current.Game.ActionCooldown, true ) ) return;
		FactionSystem.Instance.UpdateFactionHost( factionId, _descriptionText );
	}

	private void SaveRole( Guid factionId )
	{
		var name = _roleName.Trim();
		if ( name.Length is < 1 or > FactionSystem.RoleNameMaxLength ||
		     !int.TryParse( _roleOrder, out var order ) || order < 0 )
		{
			Notify.Error( "#faction.role_invalid" );
			return;
		}

		if ( _editingRoleId.HasValue )
		{
			if ( Cooldown.Current.CheckAndStartCooldown( "faction:role:update", Config.Current.Game.ActionCooldown, true ) ) return;
			FactionSystem.Instance.UpdateFactionRoleHost( factionId, _editingRoleId.Value, name, _roleDescription, order, _rolePermissions );
		}
		else
		{
			if ( Cooldown.Current.CheckAndStartCooldown( "faction:role:create", Config.Current.Game.ActionCooldown, true ) ) return;
			FactionSystem.Instance.CreateFactionRoleHost( factionId, name, _roleDescription, order, _rolePermissions );
			ResetRoleEditor();
		}
	}

	private void TryDeleteRole( Guid factionId, Guid roleId )
	{
		if ( _deleteRolePrimed != roleId )
		{
			_deleteRolePrimed = roleId;
			return;
		}

		if ( Cooldown.Current.CheckAndStartCooldown( "faction:role:delete", Config.Current.Game.ActionCooldown, true ) ) return;
		FactionSystem.Instance.DeleteFactionRoleHost( factionId, roleId );
		ResetRoleEditor();
	}

	private void ArmDangerAction( string action )
	{
		_dangerAction = action;
	}

	private void CancelDangerAction()
	{
		_dangerAction = null;
	}

	private void ConfirmDangerAction( Guid factionId )
	{
		if ( _dangerAction == "leave" )
		{
			if ( Cooldown.Current.CheckAndStartCooldown( "faction:leave", Config.Current.Game.ActionCooldown, true ) ) return;
			FactionSystem.Instance.LeaveFactionHost();
		}
		else if ( _dangerAction == "delete" )
		{
			if ( Cooldown.Current.CheckAndStartCooldown( "faction:delete", Config.Current.Game.ActionLongCooldown, true ) ) return;
			FactionSystem.Instance.DeleteFactionHost( factionId );
		}

		_dangerAction = null;
	}

	protected override int BuildHash()
	{
		if ( !FactionSystem.Instance.IsValid() ) return 0;
		var editorHash = HashCode.Combine( _editingRoleId, _roleName, _roleDescription, _roleOrder, _rolePermissions );
		return HashCode.Combine(
			Player.Local?.FactionId,
			Player.Local?.FactionRoleId,
			FactionSystem.Instance.Revision,
			_descriptionText,
			_deleteRolePrimed,
			_dangerAction,
			editorHash
		);
	}
}
