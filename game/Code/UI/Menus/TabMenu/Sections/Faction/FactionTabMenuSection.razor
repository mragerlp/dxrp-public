@namespace Dxura.RP.Game.UI
@inherits Sandbox.UI.Navigation.NavigationHost
@attribute [StyleSheet]

<root>
	@{
		var system = FactionSystem.Instance;
		var inFaction = Player.Local.IsValid() && Player.Local.IsInFaction;
		var faction = inFaction ? Player.Local.GetFaction() : null;
	}

	<div class="faction-shell">
		<header class="faction-header">
			<div class="faction-mark">
				<i class="material-icons">account_tree</i>
			</div>

			<div class="faction-identity">
				<div class="faction-eyebrow">#faction.header.network</div>
				<div class="faction-title-row">
					<h1>@( faction?.Name ?? Language.GetPhrase( "faction.title" ) )</h1>
					@if ( faction != null )
					{
						<span class="faction-tag">@faction.Value.Tag</span>
						<span class="faction-level">@string.Format( Language.GetPhrase( "faction.tab.level" ), faction.Value.Level )</span>
					}
				</div>
				<div class="faction-subtitle">
					@if ( faction != null )
					{
						<span>@( string.IsNullOrWhiteSpace( faction.Value.Description ) ? Language.GetPhrase( "faction.no_description" ) : faction.Value.Description )</span>
					}
					else
					{
						<span>@string.Format( Language.GetPhrase( "faction.header.summary" ), system.IsValid() ? system.Factions.Count : 0 )</span>
					}
				</div>
			</div>

			@if ( faction != null )
			{
				<div class="faction-header-stats">
					<div class="header-stat">
						<i class="material-icons">groups</i>
						<div>
							<span class="header-stat-label">#faction.overview.members</span>
							<span class="header-stat-value">@faction.Value.MemberCount / @faction.Value.MaxMembers</span>
						</div>
					</div>
					<div class="header-stat">
						<i class="material-icons cash-icon">account_balance</i>
						<div>
							<span class="header-stat-label">#faction.overview.balance</span>
							<span class="header-stat-value cash-value">$@faction.Value.Balance.ToString( "N0" )</span>
						</div>
					</div>
				</div>
			}
		</header>

		<nav class="faction-tabs">
			@if ( inFaction )
			{
				<button class="faction-tab" href="/tabmenu/faction/overview" onclick="@PlayTabSound">
					<i class="material-icons">dashboard</i><span>#faction.tab.overview</span>
				</button>
				<button class="faction-tab" href="/tabmenu/faction/members" onclick="@PlayTabSound">
					<i class="material-icons">group</i><span>#faction.tab.members</span>
				</button>
				<button class="faction-tab" href="/tabmenu/faction/settings" onclick="@PlayTabSound">
					<i class="material-icons">tune</i><span>#generic.settings</span>
				</button>
			}

			<button class="faction-tab" href="/tabmenu/faction/browse" onclick="@PlayTabSound">
				<i class="material-icons">public</i><span>@( inFaction ? Language.GetPhrase( "faction.tab.all" ) : Language.GetPhrase( "faction.tab.browse" ) )</span>
			</button>

			<button class="faction-icon-button refresh-button" onclick="@RefreshFactions" tooltip="#faction.refresh">
				<i class="material-icons">refresh</i>
			</button>
		</nav>

		<div class="navigator-body">
			<div class="navigator-canvas" slot="navigator-canvas"></div>

			@if ( !system.IsValid() || !system.IsLoaded )
			{
				<div class="faction-state-view faction-state-overlay">
					<div class="state-icon @( system.IsValid() && system.LoadFailed ? "error" : "" )">
						<i class="material-icons">@( system.IsValid() && system.LoadFailed ? "cloud_off" : "sync" )</i>
					</div>
					<h2>@( system.IsValid() && system.LoadFailed ? Language.GetPhrase( "faction.load_failed" ) : Language.GetPhrase( "faction.loading" ) )</h2>
					@if ( system.IsValid() && system.LoadFailed )
					{
						<button class="faction-action primary" onclick="@RefreshFactions">
							<i class="material-icons">refresh</i><span>#faction.retry</span>
						</button>
					}
				</div>
			}
		</div>
	</div>
</root>

@code {
	public FactionTabMenuSection()
	{
		DefaultUrl = "/tabmenu/faction/browse";
	}

	private void PlayTabSound()
	{
		Sound.Play( "pop" );
	}

	private void RefreshFactions()
	{
		if ( !FactionSystem.Instance.IsValid() ||
		     Cooldown.Current.CheckAndStartCooldown( "faction:refresh", Config.Current.Game.ActionLongCooldown, true ) )
		{
			return;
		}

		FactionSystem.Instance.RefreshFactionsHost();
	}

	protected override int BuildHash()
	{
		var system = FactionSystem.Instance;
		if ( !system.IsValid() ) return HashCode.Combine( false );

		return HashCode.Combine(
			Player.Local?.FactionId,
			Player.Local?.FactionRoleId,
			system.IsLoaded,
			system.LoadFailed,
			system.Revision
		);
	}
}
