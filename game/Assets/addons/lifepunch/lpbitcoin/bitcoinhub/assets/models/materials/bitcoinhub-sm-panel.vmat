// LifePunch bitcoinhub — Steam Machine control panel

Layer0
{
	shader "shaders/complex.shader"

	F_METALNESS_TEXTURE 1
	F_SPECULAR 1

	TextureColor "addons/lifepunch/lpbitcoin/bitcoinhub/assets/textures/sm_panel_mat_BaseColor.png"
	TextureNormal "addons/lifepunch/lpbitcoin/bitcoinhub/assets/textures/sm_panel_mat_Normal.png"
	TextureRoughness "addons/lifepunch/lpbitcoin/bitcoinhub/assets/textures/sm_panel_mat_Metallic-sm_panel_mat_Roughness@channels=G.png"
	TextureMetalness "addons/lifepunch/lpbitcoin/bitcoinhub/assets/textures/sm_panel_mat_Metallic-sm_panel_mat_Roughness@channels=B.png"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
}
