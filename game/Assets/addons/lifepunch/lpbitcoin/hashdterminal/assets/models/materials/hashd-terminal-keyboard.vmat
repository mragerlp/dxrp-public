// LIFEPUNCH lpbitcoin — HASHD terminal keyboard + mouse (4K TGA source — compile in ModelDoc).

Layer0
{
	shader "shaders/complex.shader"

	F_METALNESS_TEXTURE 1
	F_SPECULAR 1

	g_flAmbientOcclusionDirectDiffuse "0.000"
	g_flAmbientOcclusionDirectSpecular "0.000"
	TextureAmbientOcclusion "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/keyboard_mause_ao.tga"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 1.000000]"
	TextureColor "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/keyboard_mause_color.tga"

	g_flFadeExponent "1.000"
	g_bFogEnabled "1"

	TextureMetalness "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/keyboard_mause_metallic.tga"

	TextureNormal "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/keyboard_mause_normal.tga"

	g_flRoughnessScaleFactor "1.000"
	TextureRoughness "addons/lifepunch/lpbitcoin/hashdterminal/assets/textures/keyboard_mause_roughness.tga"
}
