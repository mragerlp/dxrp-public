// LIFEPUNCH lpbanker - gold bullion (slot Bullion_Gold_Silver; no silver set ships). DRAFT

Layer0
{
	shader "shaders/complex.shader"

	F_METALNESS_TEXTURE 1
	F_SPECULAR 1

	g_flAmbientOcclusionDirectDiffuse "0.000"
	g_flAmbientOcclusionDirectSpecular "0.000"
	TextureAmbientOcclusion "addons/lifepunch/lpbanker/bankvault/assets/textures/Bullion_AO.png"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "addons/lifepunch/lpbanker/bankvault/assets/textures/Bullion_BaseColor.png"

	g_flFadeExponent "1.000"
	g_bFogEnabled "1"

	TextureMetalness "addons/lifepunch/lpbanker/bankvault/assets/textures/Bullion_Metallic.png"

	TextureNormal "addons/lifepunch/lpbanker/bankvault/assets/textures/Bullion_GL_Normal.png"

	g_flRoughnessScaleFactor "1.000"
	TextureRoughness "addons/lifepunch/lpbanker/bankvault/assets/textures/Bullion_Roughness.png"
}
