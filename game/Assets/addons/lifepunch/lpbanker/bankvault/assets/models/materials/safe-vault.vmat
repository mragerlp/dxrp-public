// LIFEPUNCH lpbanker - floor safe body and door (slot Safe_Vault). DRAFT; 4K GL normal (2K is the smaller option)

Layer0
{
	shader "shaders/complex.shader"

	F_METALNESS_TEXTURE 1
	F_SPECULAR 1

	g_flAmbientOcclusionDirectDiffuse "0.000"
	g_flAmbientOcclusionDirectSpecular "0.000"
	TextureAmbientOcclusion "addons/lifepunch/lpbanker/bankvault/assets/textures/Safe_Vault_AO.png"

	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "addons/lifepunch/lpbanker/bankvault/assets/textures/Safe_Vault_BaseColor.png"

	g_flFadeExponent "1.000"
	g_bFogEnabled "1"

	TextureMetalness "addons/lifepunch/lpbanker/bankvault/assets/textures/Safe_Vault_Metallic.png"

	TextureNormal "addons/lifepunch/lpbanker/bankvault/assets/textures/Safe_Vault_GL_Normal.png"

	g_flRoughnessScaleFactor "1.000"
	TextureRoughness "addons/lifepunch/lpbanker/bankvault/assets/textures/Safe_Vault_Roughness.png"
}
