// Fully transparent material used to hide the USP animation-driver mesh.
// The USP skeleton continues to drive pistol animation and the first-person arms.

Layer0
{
	shader "shaders/complex.shader"

	//---- Translucent ----
	F_TRANSLUCENT 1
	g_flOpacityScale "0.000"

	//---- Color ----
	g_flModelTintAmount "1.000"
	g_vColorTint "[1.000000 1.000000 1.000000 0.000000]"
	TextureColor "materials/default/default_color.tga"

	//---- Fog ----
	g_bFogEnabled "0"
}
